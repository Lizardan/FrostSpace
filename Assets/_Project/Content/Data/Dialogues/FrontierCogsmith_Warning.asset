  m_Script: {fileID: 11500000, guid: d072e472c4b63c14584e6fff29616dd3, type: 3}
  m_Name: FrontierCogsmith_Warning
  m_EditorClassIdentifier: FrostSpace.Features::FrostSpace.Features.Dialogue.DialogueAsset
  _startId: node_1
  _nodes:
  - _id: node_1
    _line: "\u041A\u043E\u0442\u0451\u043B \u0436\u0438\u0432\u043E\u0439, \u0442\u044F\u0433\u0438 \u043D\u0435\u0442. \u0422\u0430\u0449\u0438\u043C \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0443\u0437\u043B\u0443, \u0441\u043C\u0435\u043D\u0430 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441."
    _choices: []
    _nextId: node_2
    _action: 0
    _questId: 
  - _id: node_2
    _line: "\u0415\u0441\u043B\u0438 \u0432\u044B\u0439\u0434\u0435\u0442 R7 \u2014 \u0441\u043A\u0430\u0436\u0438, \u0447\u0442\u043E \u0448\u043F\u0438\u043B\u044C \u043D\u0430\u0439\u0434\u0435\u043D. \u041E\u043D \u043D\u0435 \u0432\u0435\u0440\u0438\u043B."
    _choices:
    - _text: "\u0414\u043E\u043B\u0433\u043E?"
      _nextId: node_3
    - _text: "\u041F\u043E\u0435\u0437\u0434 \u043F\u043E\u0435\u0434\u0435\u0442?"
      _nextId: node_4
    _nextId: 
    _action: 0
    _questId: 
  - _id: node_3
    _line: "\u0414\u043E \u0443\u0442\u0440\u0430. \u0415\u0441\u043B\u0438 \u0432\u0435\u0442\u0435\u0440 \u043D\u0435 \u0441\u043E\u0440\u0432\u0451\u0442 \u043D\u0430\u0432\u0435\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u044B \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438."
    _choices: []
    _nextId: 
    _action: 0
    _questId: 
  - _id: node_4
    _line: "\u042D\u0442\u043E\u0442 \u2014 \u043D\u0435\u0442, \u043A\u0443\u0440\u044C\u0435\u0440. \u041E\u043D \u0437\u0434\u0435\u0441\u044C \u0441\u0442\u043E\u0438\u0442 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430. \u0415\u0445\u0430\u0442\u044C \u0442\u0435\u0431\u0435."
    _choices: []
    _nextId: 
    _action: 0
    _questId: 
