  m_Script: {fileID: 11500000, guid: d072e472c4b63c14584e6fff29616dd3, type: 3}
  m_Name: R4_Hauler
  m_EditorClassIdentifier: FrostSpace.Features::FrostSpace.Features.Dialogue.DialogueAsset
  _startId: node_1
  _nodes:
  - _id: node_1
    _line: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E! \u0423 \u043C\u0435\u043D\u044F \u043D\u0430 \u0441\u043F\u0438\u043D\u0435 \u044F\u0449\u0438\u043A \u0441 \u043E\u0445\u043B\u0430\u0436\u0434\u0430\u044E\u0449\u0438\u043C \u043A\u043E\u043D\u0442\u0443\u0440\u043E\u043C. \u0423\u0440\u043E\u043D\u044E \u2014 \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u043A\u043E\u043D\u0435\u0446."
    _choices:
    - _text: "\u041F\u043E\u043C\u043E\u0447\u044C?"
      _nextId: node_2
    - _text: "\u0422\u044F\u0436\u0435\u043B\u043E?"
      _nextId: node_3
    - _text: "\u042F \u043F\u0440\u043E\u0439\u0434\u0443 \u043C\u0438\u043C\u043E."
      _nextId: node_5
    _nextId: 
  - _id: node_2
    _line: "\u041F\u043E\u043C\u043E\u0433\u0438, \u0431\u0443\u0434\u044C \u0434\u0440\u0443\u0433\u043E\u043C: \u043F\u043E\u0434\u043E\u043F\u0440\u0438 \u044F\u0449\u0438\u043A \u0441\u043F\u0440\u0430\u0432\u0430. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0440\u0435\u0437\u043A\u043E, \u043E\u043D \u043B\u044E\u0431\u0438\u0442, \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0451 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E."
    _choices: []
    _nextId: node_4
  - _id: node_3
    _line: "\u0422\u044F\u0436\u0435\u043B\u043E \u2014 \u043D\u0435 \u0442\u043E \u0441\u043B\u043E\u0432\u043E. \u042F \u0438 \u0435\u0441\u0442\u044C \u0442\u044F\u0436\u0435\u0441\u0442\u044C. \u0412\u0441\u044F \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u0442\u043E\u043C, \u0447\u0442\u043E \u044F \u043D\u0435 \u043F\u0430\u0434\u0430\u044E."
    _choices: []
    _nextId: node_2
  - _id: node_4
    _line: "\u0412\u043E\u0442 \u0442\u0430\u043A. \u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u0417\u043D\u0430\u0435\u0448\u044C, \u0437\u0430 \u043C\u0435\u0441\u044F\u0446 \u0442\u044B \u043F\u0435\u0440\u0432\u044B\u0439, \u043A\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043F\u043E\u043C\u043E\u0449\u044C, \u0430 \u043D\u0435 \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E."
    _choices: []
    _nextId: 
  - _id: node_5
    _line: "\u041B\u0430\u0434\u043D\u043E. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0441\u043F\u0435\u0448\u0438 \u0442\u0430\u043A \u2014 \u043F\u043E\u0434 \u0441\u043D\u0435\u0433\u043E\u043C \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E, \u0430 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u0439\u043C\u0430\u0442\u044C."
    _choices: []
    _nextId: 
