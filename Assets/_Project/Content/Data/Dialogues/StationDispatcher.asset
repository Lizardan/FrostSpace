  m_Name: StationDispatcher
  m_EditorClassIdentifier: FrostSpace.Features::FrostSpace.Features.Dialogue.DialogueAsset
  _startId: n0
  _nodes:
  - _id: n0
    _line: "\u0421\u043B\u044B\u0448\u0443 \u0442\u0435\u0431\u044F, \u043D\u043E \u043D\u0435 \u0441\u0440\u0430\u0437\u0443: \u0434\u0438\u0441\u043F\u0435\u0442\u0447\u0435\u0440\u0441\u043A\u0430\u044F \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0432\u044F\u0437\u044C \u0441\u043E \u0441\u0442\u0430\u043D\u0446\u0438\u0435\u0439 \xAB\u041A\u043E\u0441\u043E\u0439\xBB \u0438 \u0441 \u0434\u0435\u043F\u043E, \u0438 \u043F\u043E\u043A\u0430 \u044F \u043E\u0442\u0432\u0435\u0447\u0430\u044E \u0442\u0435\u0431\u0435, \u044F \u0442\u0435\u0440\u044F\u044E \u043E\u0434\u0438\u043D \u0438\u0437 \u0434\u0432\u0443\u0445 \u043A\u0430\u043D\u0430\u043B\u043E\u0432."
    _choices: []
    _nextId: n1
    _action: 0
    _questId: 
  - _id: n1
    _line: "\u041F\u043E\u0435\u0437\u0434\u0430 \u0445\u043E\u0434\u044F\u0442 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044E, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442. \u042F \u0441\u0447\u0438\u0442\u0430\u044E, \u0443 \u043A\u043E\u0433\u043E \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0440\u044F\u0434\u0430, \u043A\u0442\u043E \u0432 \u043A\u0430\u043A\u043E\u043C \u043E\u0442\u0441\u0435\u043A\u0435 \u0438 \u043A\u0442\u043E \u0432\u044B\u0448\u0435\u043B \u0437\u0430 \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440. \u042D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C \u0441\u0442\u0430\u043D\u0446\u0438\u044F: \u043D\u0435 \u043F\u0443\u0442\u044C, \u0430 \u0441\u043F\u0438\u0441\u043E\u043A."
    _choices:
    - _text: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0441\u043F\u0438\u0441\u043E\u043A, \u0430 \u043D\u0435 \u043F\u0443\u0442\u044C?"
      _nextId: n3
    - _text: "\u0427\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043E\u0442 \u043C\u0435\u043D\u044F?"
      _nextId: n4
    - _text: "\u041F\u043E\u043D\u044F\u043B."
      _nextId: 
    _nextId: n2
    _action: 0
    _questId: 
  - _id: n2
    _line: "\u0421\u043A\u0430\u0436\u0438, \u0435\u0441\u043B\u0438 \u0443\u0432\u0438\u0434\u0438\u0448\u044C, \u0447\u0442\u043E \u0443 \u0430\u043D\u0433\u0430\u0440\u0430 \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441\u0442\u0432\u043E\u0440: \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u043B\u0430\u0442\u044C \u0442\u0443\u0434\u0430 \u043B\u044E\u0434\u0435\u0439 \u043A\u0430\u0436\u0434\u044B\u0439 \u0447\u0430\u0441, \u0430 \u0432\u0435\u0442\u0435\u0440 \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u043C\u0438\u043D\u0443\u0442\u044B."
    _choices: []
    _nextId: 
    _action: 0
    _questId: 
  - _id: n3
    _line: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043F\u0443\u0442\u044C \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u0442\u0430\u043C, \u0433\u0434\u0435 \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u043A\u0430\u0431\u0435\u043B\u044C. \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439 \u0438 \u0431\u0430\u0442\u0430\u0440\u0435\u0438, \u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u044D\u0442\u043E \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C."
    _choices: []
    _nextId: n2
    _action: 0
    _questId: 
  - _id: n4
    _line: "\u041E\u0434\u043D\u0430 \u0432\u0435\u0449\u044C: \u0442\u043E\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F, \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0443\u0439\u0434\u0451\u0448\u044C. \u0423\u0437\u0435\u043B \u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u0435\u043F\u043B\u043E \u0440\u043E\u0432\u043D\u043E \u043D\u0430 \u0441\u0442\u043E\u043B\u044C\u043A\u043E, \u043D\u0430 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0431\u0435\u0449\u0430\u0435\u0442, \u0430 \u043E\u0431\u0435\u0449\u0430\u0442\u044C \u043B\u0438\u0448\u043D\u0435\u0435 \u044F \u043D\u0435 \u0443\u043C\u0435\u044E."
    _choices: []
    _nextId: n2
    _action: 0
    _questId: 
