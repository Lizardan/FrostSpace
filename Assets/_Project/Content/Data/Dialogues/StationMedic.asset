  m_Script: {fileID: 11500000, guid: d072e472c4b63c14584e6fff29616dd3, type: 3}
  m_Name: StationMedic
  m_EditorClassIdentifier: FrostSpace.Features::FrostSpace.Features.Dialogue.DialogueAsset
  _startId: n0
  _nodes:
  - _id: n0
    _line: "\u041D\u0435 \u0441\u0430\u0434\u0438\u0441\u044C \u043D\u0430 \u043A\u0440\u0430\u0439 \u043A\u043E\u0439\u043A\u0438, \u0442\u0430\u043C \u0441\u043B\u043E\u043C\u0430\u043D \u043A\u0440\u0435\u043F\u0451\u0436. \u0421\u0430\u0434\u0438\u0441\u044C \u043D\u0430 \u043F\u043E\u043B, \u043E\u043D \u0442\u0451\u043F\u043B\u044B\u0439: \u043F\u043E\u0434 \u043E\u0442\u0441\u0435\u043A\u043E\u043C \u0442\u044F\u043D\u0435\u0442 \u043A\u0430\u0431\u0435\u043B\u044C, \u0438 \u044F \u044D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435, \u0447\u0442\u043E \u043C\u043E\u0433\u0443 \u043E\u0431\u043E\u0433\u0440\u0435\u0442\u044C."
    _choices: []
    _nextId: n1
    _action: 0
    _questId: 
  - _id: n1
    _line: "\u041A\u043E \u043C\u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043D\u0435 \u0437\u0430 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E\u043C. \u041C\u0435\u0445\u0430\u043D\u0438\u043A \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0443 \u043D\u0435\u0433\u043E \u0434\u0440\u043E\u0436\u0430\u0442 \u0440\u0443\u043A\u0438 \u0438 \u043E\u043D \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B. \u042D\u0442\u043E \u0443\u0436\u0435 \u0434\u0438\u0430\u0433\u043D\u043E\u0437."
    _choices:
    - _text: "\u0427\u0442\u043E \u043B\u0435\u0447\u0438\u0442\u0435 \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E?"
      _nextId: n3
    - _text: "\u0423 \u0432\u0430\u0441 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0437\u0430\u043F\u0430\u0441\u0430?"
      _nextId: n4
    - _text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u044F \u043F\u043E\u0441\u0442\u043E\u044E."
      _nextId: 
    _nextId: n2
    _action: 0
    _questId: 
  - _id: n2
    _line: "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0434\u0451\u0442 \u043A\u0443\u0440\u044C\u0435\u0440 \u0441 \u0434\u0435\u043F\u043E \u2014 \u0441\u043A\u0430\u0436\u0438 \u0435\u043C\u0443, \u0447\u0442\u043E \u0431\u0438\u043D\u0442\u044B \u0435\u0441\u0442\u044C, \u0430 \u043F\u043E\u043A\u043E\u044F \u043D\u0435\u0442. \u041E\u043D \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u0442."
    _choices: []
    _nextId: 
    _action: 0
    _questId: 
  - _id: n3
    _line: "\u041E\u0436\u043E\u0433\u0438 \u0445\u043E\u043B\u043E\u0434\u043E\u043C \u0438 \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u043E. \u0412\u0442\u043E\u0440\u043E\u0435 \u043B\u0435\u0447\u0438\u0442\u0441\u044F \u0434\u043E\u043B\u044C\u0448\u0435, \u0438 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430."
    _choices: []
    _nextId: n2
    _action: 0
    _questId: 
  - _id: n4
    _line: "\u041D\u0430 \u0434\u0432\u0430 \u043C\u0435\u0441\u044F\u0446\u0430, \u0435\u0441\u043B\u0438 \u043D\u0435 \u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F. \u041D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u044E \u0438\u0437 \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u043E\u0442\u0441\u0435\u043A\u043E\u0432 \u2014 \u044D\u0442\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0435 \u0447\u0438\u0441\u043B\u043E, \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442 \u043C\u0435\u043D\u044F \u0435\u0433\u043E \u043F\u0440\u0438\u0443\u043A\u0440\u0430\u0441\u0438\u0442\u044C."
    _choices: []
    _nextId: n2
    _action: 0
    _questId: 
