  m_Script: {fileID: 11500000, guid: d072e472c4b63c14584e6fff29616dd3, type: 3}
  m_Name: R3_Scout
  m_EditorClassIdentifier: FrostSpace.Features::FrostSpace.Features.Dialogue.DialogueAsset
  _startId: node_1
  _nodes:
  - _id: node_1
    _line: "\u041E! \u041A\u0443\u0440\u044C\u0435\u0440. \u0421\u0442\u043E\u0439, \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F \u2014 \u044F \u0442\u0435\u0431\u044F \u0441\u043A\u0430\u043D\u0438\u0440\u0443\u044E\u2026 \u0413\u043E\u0442\u043E\u0432\u043E. \u0422\u044B \u043D\u0435 \u0437\u0430\u0440\u0430\u0436\u0451\u043D. \u0423\u0436\u0435 \u043B\u0435\u0433\u0447\u0435."
    _choices:
    - _text: "\u0417\u0430\u0440\u0430\u0436\u0451\u043D \u0447\u0435\u043C?"
      _nextId: node_2
    - _text: "\u0422\u044B \u043C\u0435\u043D\u044F \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B?"
      _nextId: node_3
    - _text: "\u041F\u043E\u043A\u0430."
      _nextId: 
    _nextId: 
  - _id: node_2
    _line: "\u0422\u0438\u0448\u0438\u043D\u043E\u0439. \u041E\u043D\u0430 \u043F\u043E\u043B\u0437\u0451\u0442 \u043F\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0430\u043C \u0438 \u0434\u0435\u043B\u0430\u0435\u0442 \u0440\u043E\u0431\u043E\u0442\u043E\u0432\u2026 \u0442\u0438\u0445\u0438\u043C\u0438. \u0422\u044B \u043D\u0435 \u0442\u0438\u0445\u0438\u0439. \u041F\u043E\u043A\u0430."
    _choices:
    - _text: "\u0427\u0442\u043E \u043C\u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C?"
      _nextId: node_4
    - _text: "\u0417\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u043F\u0430\u0440\u0430\u043D\u043E\u0439\u044F."
      _nextId: node_5
    _nextId: 
  - _id: node_3
    _line: "\u041F\u0440\u043E\u0441\u0442\u0438. \u041F\u0440\u0438\u0432\u044B\u0447\u043A\u0430. \u042F \u0442\u0443\u0442 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u043E\u0432 \u0441\u043D\u0435\u0433\u0430."
    _choices: []
    _nextId: node_2
  - _id: node_4
    _line: "\u0414\u0435\u0440\u0436\u0438\u0441\u044C \u0441\u0432\u0435\u0442\u0430 \u0438 \u043D\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0439 \u0444\u043E\u043D\u0430\u0440\u044C. \u0410 \u0435\u0441\u043B\u0438 \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C, \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0440\u044F\u0434\u043E\u043C \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B \u0433\u0443\u0434\u0435\u0442\u044C \u2014 \u0431\u0435\u0433\u0438."
    _choices: []
    _nextId: 
  - _id: node_5
    _line: "\u041F\u0430\u0440\u0430\u043D\u043E\u0439\u044F \u2014 \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u043D\u0435\u0442 \u0434\u0430\u043D\u043D\u044B\u0445. \u0423 \u043C\u0435\u043D\u044F \u0434\u0430\u043D\u043D\u044B\u0435 \u0435\u0441\u0442\u044C. \u0422\u0440\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u0445 \u0441\u0438\u0433\u043D\u0430\u043B\u0430 \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E. \u0412\u043E\u0442 \u0438 \u0441\u0447\u0438\u0442\u0430\u0439."
    _choices: []
    _nextId: 
