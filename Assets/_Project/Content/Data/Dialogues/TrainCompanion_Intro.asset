  m_Script: {fileID: 11500000, guid: d072e472c4b63c14584e6fff29616dd3, type: 3}
  m_Name: TrainCompanion_Intro
  m_EditorClassIdentifier: FrostSpace.Features::FrostSpace.Features.Dialogue.DialogueAsset
  _startId: node_1
  _nodes:
  - _id: node_1
    _line: "\u041D\u043E\u0432\u044B\u0439 \u043A\u0443\u0440\u044C\u0435\u0440? \u041A\u043E\u0440\u043F\u0443\u0441 \u0446\u0435\u043B, \u043F\u0430\u043C\u044F\u0442\u044C \u0441\u0442\u0451\u0440\u0442\u0430 \u2014 \u043A\u0430\u043A \u0438 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C. \u042F R13, \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E \u0432\u0430\u0433\u043E\u043D\u0443."
    _choices: []
    _nextId: node_2
    _action: 0
    _questId: 
  - _id: node_2
    _line: "\u0414\u043E \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0442\u0440\u043E\u0435 \u0441\u0443\u0442\u043E\u043A. \u0413\u0440\u0443\u0437 \u2014 \u0447\u0435\u0442\u044B\u0440\u0435 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430. \u0411\u0435\u0437 \u043D\u0438\u0445 \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0437\u0430\u043C\u043E\u043B\u0447\u0438\u0442."
    _choices:
    - _text: "\u0427\u0442\u043E \u0441 \u043C\u043E\u0435\u0439 \u043F\u0430\u043C\u044F\u0442\u044C\u044E?"
      _nextId: node_3
    - _text: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0438\u043C\u0435\u043D\u043D\u043E \u044F?"
      _nextId: node_4
    - _text: "\u042F\u0441\u043D\u043E. \u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443."
      _nextId: node_5
    _nextId: 
    _action: 0
    _questId: 
  - _id: node_3
    _line: "\u041F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u043F\u043E\u0441\u043B\u0435 \u0430\u0432\u0430\u0440\u0438\u0438. \u0422\u044B \u0432\u044B\u0436\u0438\u043B \u2014 \u044D\u0442\u043E \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0431\u0435\u0440\u0451\u0448\u044C \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435."
    _choices: []
    _nextId: node_5
    _action: 0
    _questId: 
  - _id: node_4
    _line: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u044B \u0443\u043C\u0435\u0435\u0448\u044C \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0433\u0440\u0443\u0437, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u0438\u0448\u0438\u043D\u0430. \u0414\u0440\u0443\u0433\u0438\u0445 \u043A\u0443\u0440\u044C\u0435\u0440\u043E\u0432 \u043D\u0435\u0442."
    _choices: []
    _nextId: node_5
    _action: 0
    _questId: 
  - _id: node_5
    _line: "\u0410\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B \u0432\u0434\u043E\u043B\u044C \u043F\u0440\u0430\u0432\u043E\u0433\u043E \u0431\u043E\u0440\u0442\u0430. \u0422\u0435\u043B\u0435\u0436\u043A\u0430 \u0443 \u0434\u0432\u0435\u0440\u0438. \u0412\u043E\u0437\u044C\u043C\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0432 \u0433\u043D\u0435\u0437\u0434\u043E."
    _choices:
    - _text: "\u041F\u043E\u043D\u044F\u043B."
      _nextId: node_6
    - _text: "\u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442, \u0435\u0441\u043B\u0438 \u043D\u0435 \u0443\u0441\u043F\u0435\u0435\u043C?"
      _nextId: node_7
    _nextId: 
    _action: 0
    _questId: 
  - _id: node_6
    _line: "\u041D\u0435 \u0443\u0441\u043F\u0435\u0435\u043C \u2014 \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u043E\u0441\u0442\u044B\u043D\u0435\u0442. \u041D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0439 \u0442\u0435\u043B\u0435\u0436\u043A\u0443."
    _choices: []
    _nextId: 
    _action: 1
    _questId: train_batteries
  - _id: node_7
    _line: "\u0422\u043E\u0433\u0434\u0430 \u0434\u0435\u043F\u043E \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0431\u0435\u0437 \u0441\u0432\u044F\u0437\u0438. \u041D\u0435 \u0441\u043F\u0435\u0448\u0438 \u0438 \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u0439 \u0433\u0440\u0443\u0437 \u2014 \u0438 \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0439 \u0442\u0435\u043B\u0435\u0436\u043A\u0443."
    _choices: []
    _nextId: 
    _action: 1
    _questId: train_batteries
