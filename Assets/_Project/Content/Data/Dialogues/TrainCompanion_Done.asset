  _startId: node_1
  _nodes:
  - _id: node_1
    _line: "\u0412\u0441\u0435 \u0447\u0435\u0442\u044B\u0440\u0435 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430 \u2014 \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0433\u0440\u0443\u0437, \u0440\u043E\u0432\u043D\u044B\u0439 \u0448\u0430\u0433."
    _choices: []
    _nextId: node_2
    _action: 0
    _questId: 
  - _id: node_2
    _line: "\u0414\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u043D\u0430 \u0434\u0435\u043F\u043E. \u0422\u0435\u043B\u0435\u0436\u043A\u0443 \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0439: \u043E\u043D\u0430 \u0447\u0443\u0436\u0430\u044F."
    _choices:
    - _text: "\u041A\u0442\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442?"
      _nextId: node_3
    - _text: "\u041F\u043E\u043D\u044F\u043B."
      _nextId: node_4
    _nextId: 
    _action: 0
    _questId: 
  - _id: node_3
    _line: "R7 \u0443 \u043D\u0430\u0432\u0435\u0441\u0430. \u041E\u043D \u0437\u043D\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u0430\u043B\u044C\u0448\u0435."
    _choices: []
    _nextId: 
    _action: 2
    _questId: train_batteries
  - _id: node_4
    _line: "\u0418\u0434\u0438. \u042F \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0441 \u0433\u0440\u0443\u0437\u043E\u043C."
