  m_Script: {fileID: 11500000, guid: d072e472c4b63c14584e6fff29616dd3, type: 3}
  m_Name: FrontierBulwark_Warning
  m_EditorClassIdentifier: FrostSpace.Features::FrostSpace.Features.Dialogue.DialogueAsset
  _startId: node_1
  _nodes:
  - _id: node_1
    _line: "\u0414\u0430\u043B\u044C\u0448\u0435 \u2014 \u0432\u043E\u0440\u043E\u0442\u0430 \u0438 \u0434\u043E\u0440\u043E\u0433\u0430. \u0417\u0430\u043A\u0440\u044B\u0442\u043E \u0434\u043E \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u044F."
    _choices: []
    _nextId: node_2
    _action: 0
    _questId: 
  - _id: node_2
    _line: "\u0417\u0430 \u043C\u0435\u0442\u0435\u043B\u044C\u044E \u043D\u0435 \u0432\u0438\u0434\u043D\u043E, \u043A\u0442\u043E \u0438\u0434\u0451\u0442. \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u043A\u0430\u0436\u0434\u043E\u0433\u043E, \u043A\u0442\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F."
    _choices: []
    _nextId: node_3
    _action: 0
    _questId: 
  - _id: node_3
    _line: "\u041F\u0440\u043E\u043F\u0443\u0441\u043A \u2014 \u0443 R7. \u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u044F \u043D\u0435 \u043E\u0442\u043A\u0440\u043E\u044E \u0441\u0442\u0432\u043E\u0440."
    _choices:
    - _text: "\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u043F\u0443\u0441\u043A."
      _nextId: node_4
    - _text: "\u041A\u0442\u043E \u0432\u044B\u0434\u0430\u0451\u0442 \u043F\u0440\u043E\u043F\u0443\u0441\u043A?"
      _nextId: node_5
    _nextId: 
    _action: 0
    _questId: 
  - _id: node_4
    _line: "\u0422\u043E\u0433\u0434\u0430 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043A R7. \u041F\u043E\u043A\u0430 \u043E\u043D \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442 \u2014 \u0441\u0442\u043E\u0439 \u0437\u0434\u0435\u0441\u044C."
    _choices: []
    _nextId: 
    _action: 0
    _questId: 
  - _id: node_5
    _line: "R7 \u0443 \u043D\u0430\u0432\u0435\u0441\u0430. \u041E\u043D \u0432\u0435\u0434\u0451\u0442 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u0435 \u0438 \u0437\u043D\u0430\u0435\u0442, \u043A\u043E\u0433\u043E \u043F\u0443\u0441\u043A\u0430\u0442\u044C. \u0411\u043E\u043B\u044C\u0448\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432 \u043D\u0435\u0442."
    _choices: []
    _nextId: 
    _action: 0
    _questId: 
