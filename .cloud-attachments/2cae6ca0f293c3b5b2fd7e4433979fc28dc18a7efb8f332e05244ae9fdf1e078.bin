379	
380	        /// <summary>Рамка из четырёх тонких полос: у Image нет бордера без спрайта.</summary>
381	        private static Image[] NewBorder(Transform parent, float thickness)
382	        {
383	            var top = NewImage(parent, "BorderTop", Color.white);
384	            top.rectTransform.anchorMin = new Vector2(0f, 1f);
385	            top.rectTransform.anchorMax = new Vector2(1f, 1f);
386	            top.rectTransform.pivot = new Vector2(0.5f, 1f);
387	            top.rectTransform.sizeDelta = new Vector2(0f, thickness);
388	            top.rectTransform.anchoredPosition = Vector2.zero;
389	
390	            var bottom = NewImage(parent, "BorderBottom", Color.white);
391	            bottom.rectTransform.anchorMin = new Vector2(0f, 0f);
392	            bottom.rectTransform.anchorMax = new Vector2(1f, 0f);
393	            bottom.rectTransform.pivot = new Vector2(0.5f, 0f);
394	            bottom.rectTransform.sizeDelta = new Vector2(0f, thickness);
395	            bottom.rectTransform.anchoredPosition = Vector2.zero;
396	
397	            var left = NewImage(parent, "BorderLeft", Color.white);
398	            left.rectTransform.anchorMin = new Vector2(0f, 0f);
399	            left.rectTransform.anchorMax = new Vector2(0f, 1f);
400	            left.rectTransform.pivot = new Vector2(0f, 0.5f);
401	            left.rectTransform.sizeDelta = new Vector2(thickness, 0f);
402	            left.rectTransform.anchoredPosition = Vector2.zero;
403	
404	            var right = NewImage(parent, "BorderRight", Color.white);
405	            right.rectTransform.anchorMin = new Vector2(1f, 0f);
406	            right.rectTransform.anchorMax = new Vector2(1f, 1f);
407	            right.rectTransform.pivot = new Vector2(1f, 0.5f);
408	            right.rectTransform.sizeDelta = new Vector2(thickness, 0f);
409	            right.rectTransform.anchoredPosition = Vector2.zero;
410	
411	            return new[] { top, bottom, left, right };
412	        }
413	
414	        private static string StatsLine(RobotProfile profile)
415	        {
416	            // Две строки, а не одна: четыре пары «показатель + процент» в ширину
417	            // карточки не влезают и обрезались по правому краю.
418	            return
419	                "WALK " + Percent(profile.WalkMultiplier) +
420	                "  ·  SPRINT " + Percent(profile.SprintMultiplier) + "\n" +
421	                "CARRY " + Percent(profile.CarryMultiplier) +
422	                "  ·  JUMP " + Percent(profile.JumpMultiplier);
423	        }
424	
425	        private static string Percent(float multiplier)
426	        {
427	            return Mathf.RoundToInt(multiplier * 100f) + "%";
428	        }
429	
430	        private Button NewButton(Transform parent, string name, string label, UnityEngine.Events.UnityAction action)
431	        {
432	            var go = new GameObject(name, typeof(RectTransform));
433	            go.transform.SetParent(parent, false);
434	            var rect = (RectTransform)go.transform;
435	            rect.anchorMin = new Vector2(0f, 0f);
436	            rect.anchorMax = new Vector2(0f, 0f);
437	            rect.pivot = new Vector2(0f, 0f);
438	            rect.sizeDelta = new Vector2(320f, 64f);
439	
440	            var background = go.AddComponent<Image>();
441	            background.color = _cardIdle;
442	
443	            var button = go.AddComponent<Button>();
444	            button.targetGraphic = background;
445	            button.transition = Selectable.Transition.ColorTint;
446	            var colors = button.colors;
447	            colors.normalColor = _cardIdle;
448	            colors.highlightedColor = _cardHover;
449	            colors.pressedColor = _accent;
450	            colors.selectedColor = _cardHover;
451	            colors.disabledColor = new Color(_cardIdle.r, _cardIdle.g, _cardIdle.b, 0.35f);
452	            colors.fadeDuration = 0.12f;
453	            button.colors = colors;
454	            if (action != null)
455	                button.onClick.AddListener(action);
456	
457	            NewText(go.transform, "Label", label, 26f, _text, TextAlignmentOptions.Center,
458	                new Vector2(0.5f, 0.5f), Vector2.zero, new Vector2(300f, 40f), 12f);
459	
460	            return button;
461	        }
462	
463	        private static Image NewImage(Transform parent, string name, Color color)
464	        {
465	            var go = new GameObject(name, typeof(RectTransform));
466	            go.transform.SetParent(parent, false);
467	            var image = go.AddComponent<Image>();
468	            image.color = color;
469	            image.raycastTarget = false;
470	            return image;
471	        }
472	
473	        private static TextMeshProUGUI NewText(
474	            Transform parent, string name, string content, float size, Color color,
475	            TextAlignmentOptions alignment, Vector2 anchor, Vector2 position,
476	            Vector2 boxSize, float spacing)
477	        {
478	            var go = new GameObject(name, typeof(RectTransform));
479	            go.transform.SetParent(parent, false);
480	            var rect = (RectTransform)go.transform;
481	            rect.anchorMin = anchor;
482	            rect.anchorMax = anchor;
483	            rect.pivot = new Vector2(
484	                anchor.x <= 0f ? 0f : anchor.x >= 1f ? 1f : 0.5f,
485	                anchor.y <= 0f ? 0f : anchor.y >= 1f ? 1f : 0.5f);
486	            rect.sizeDelta = boxSize;
487	            rect.anchoredPosition = position;
488	
489	            var text = go.AddComponent<TextMeshProUGUI>();
490	            if (TMP_Settings.defaultFontAsset != null)
491	                text.font = TMP_Settings.defaultFontAsset;
492	            text.text = content;
493	            text.fontSize = size;
494	            text.color = color;
495	            text.alignment = alignment;
496	            text.characterSpacing = spacing;
497	            text.textWrappingMode = TextWrappingModes.NoWrap;
498	            text.raycastTarget = false;
499	            return text;
500	        }
501	    }
502	}
