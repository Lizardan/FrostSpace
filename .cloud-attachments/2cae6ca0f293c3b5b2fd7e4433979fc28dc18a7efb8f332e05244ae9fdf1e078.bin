411	            edgeRect.anchorMax = new Vector2(1f, 1f);
412	            edgeRect.pivot = new Vector2(0.5f, 1f);
413	            edgeRect.sizeDelta = new Vector2(0f, 3f);
414	            edgeRect.anchoredPosition = Vector2.zero;
415	
416	            return panel;
417	        }
