{
  "command": "python - <<'PY'\nimport json, sys\nsys.path.insert(0, 'Tools/Unity')\nfrom unity_bridge import Bridge\nwith Bridge(port=6401) as b:\n    print(json.dumps(b.call('manage_editor', {'action':'stop'}), ensure_ascii=False, indent=2)[:500])\nPY\nsleep 2\npython - <<'PY'\nimport json, sys\nsys.path.insert(0, 'Tools/Unity')\nfrom unity_bridge import Bridge\ncode = r'''\nvar scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();\nvoid Set(string name, Vector3 pos, Vector3 euler, float scale) {\n    var go = GameObject.Find(name);\n    if (go == null) return;\n    go.transform.position = pos;\n    go.transform.rotation = Quaternion.Euler(euler);\n    go.transform.localScale = Vector3.one * scale;\n}\nvoid Kill(string name) { var go = GameObject.Find(name); if (go != null) UnityEngine.Object.DestroyImmediate(go); }\nKill(\"DepotShed\");\nSet(\"DepotTrack\", new Vector3(-8f, 0f, 4f), new Vector3(0f, 90f, 0f), 0.25f);\nSet(\"DepotTrain\", new Vector3(-8f, 0f, 4f), new Vector3(0f, 90f, 0f), 1f);\nSet(\"DepotGate\", new Vector3(12f, 0f, 10f), new Vector3(0f, -90f, 0f), 0.75f);\nSet(\"DepotMast\", new Vector3(14f, 0f, -1f), Vector3.zero, 0.7f);\nSet(\"R16_Warden_A\", new Vector3(-4f, 0.7f, 2f), new Vector3(0f, 25f, 0f), 1f);\nSet(\"R16_Warden_B\", new Vector3(4f, 0.7f, -3f), new Vector3(0f, -30f, 0f), 1f);\nSet(\"R7_Drifter\", new Vector3(6f, 0.7f, 1f), new Vector3(0f, 200f, 0f), 1f);\n\nvar sun = GameObject.Find(\"Sun\");\nif (sun != null) {\n    var light = sun.GetComponent<UnityEngine.Light>();\n    if (light != null) { light.type = UnityEngine.LightType.Directional; light.intensity = 1.35f; light.color = new Color(0.88f, 0.94f, 1f); sun.transform.rotation = Quaternion.Euler(48f, -32f, 0f); }\n}\nvar lamp = new GameObject(\"DepotLamp\");\nlamp.transform.position = new Vector3(0f, 4.6f, 1.5f);\nvar point = lamp.AddComponent<UnityEngine.Light>();\npoint.type = UnityEngine.LightType.Point;\npoint.range = 22f;\npoint.intensity = 7f;\npoint.color = new Color(1f, 0.78f, 0.52f);\n\nUnityEngine.RenderSettings.ambientLight = new Color(0.34f, 0.44f, 0.52f, 1f);\nUnityEngine.RenderSettings.fogColor = new Color(0.62f, 0.74f, 0.82f, 1f);\nUnityEngine.RenderSettings.fogDensity = 0.005f;\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);\nUnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);\nreturn new { roots = scene.GetRootGameObjects().Length };\n'''\nwith Bridge(port=6401) as b:\n    print(json.dumps(b.call('execute_code', {'action': 'execute', 'code': code}), ensure_ascii=False, indent=2)[:3000])\nPY",
