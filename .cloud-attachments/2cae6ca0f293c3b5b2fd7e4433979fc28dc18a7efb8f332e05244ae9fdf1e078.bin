143	        /// <summary>Открывает паузу. Публичный, потому что паузу может включить не только Esc.</summary>
144	        public void Open()
145	        {
146	            if (IsPaused)
147	                return;
148	
149	            IsPaused = true;
150	            Time.timeScale = 0f;
151	
152	            if (_rig != null)
153	                _rig.SetPaused(true);
154	            if (_scanner != null)
155	                _scanner.enabled = false;
156	
157	            Cursor.lockState = CursorLockMode.None;
158	            Cursor.visible = true;
159	
160	            _settingsPanel.SetActive(false);
161	            _menuPanel.SetActive(true);
162	            SetVisible(true);
163	            RefreshSwitches();
164	        }
165	
166	        /// <summary>Возвращает игру: время, камера, сканер и курсор — в исходное состояние.</summary>
167	        public void Resume()
168	        {
169	            IsPaused = false;
170	            Time.timeScale = 1f;
171	
172	            if (_scanner != null)
173	                _scanner.enabled = true;
174	            if (_rig != null)
175	                _rig.SetPaused(false);
176	
177	            SetVisible(false);
178	        }
