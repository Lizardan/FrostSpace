364	        private void EnsureEventSystem()
365	        {
366	            if (EventSystem.current != null)
367	                return;
368	
369	            var go = new GameObject("EventSystem", typeof(EventSystem));
370	            var module = go.AddComponent<InputSystemUIInputModule>();
371	            module.AssignDefaultActions();
372	        }
