171	            public static readonly EntryOrder Instance = new();
172	
173	            public int Compare(Entry a, Entry b)
174	            {
175	                var aAim = (a.Channels & Channel.Aim) != 0;
176	                var bAim = (b.Channels & Channel.Aim) != 0;
177	                if (aAim != bAim)
