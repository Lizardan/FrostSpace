6	namespace FrostSpace.Features.Carry
7	{
8	    /// <summary>
9	    /// Подбор, перенос и установка груза по E.
10	    ///
11	    /// Один предмет в руках: аккумулятор тяжёлый, второй не унести. Пока руки
12	    /// заняты, <see cref="RobotLocomotion.SetCarrying"/> выключает спринт и прыжок
13	    /// и включает клип переноски. Установка ищет ближайший свободный слот в
14	    /// радиусе; если слотов рядом нет — предмет падает на исходное место.
15	    ///
16	    /// E — то же действие <c>Player/Interact</c>, что у диалога и сканера.
17	    /// Пока диалог открыт, переноска не реагирует: иначе одно нажатие и
18	    /// заговорило бы, и подняло груз.
19	    /// </summary>
20	    [DisallowMultipleComponent]
21	    public sealed class CarryController : MonoBehaviour
22	    {
23	        [Header("Ссылки")]
24	        [Tooltip("Точка в руках: сюда парентится предмет")]
25	        [SerializeField] private Transform _handAnchor;
26	
27	        [Tooltip("Локомоция игрока: переключает клип и скорость переноски")]
28	        [SerializeField] private RobotLocomotion _locomotion;
29	
30	        [Tooltip("Диалог игрока: пока он открыт, E не трогает груз")]
31	        [SerializeField] private DialogueController _dialogue;
32	
33	        [Header("Руки")]
34	        [Tooltip("Кость левой кисти: груз висит на середине между кистями")]
35	        [SerializeField] private Transform _handLeft;
36	
37	        [Tooltip("Кость правой кисти")]
38	        [SerializeField] private Transform _handRight;
39	
40	        [Tooltip("Ассет ввода; если пусто — InputSystem.actions")]
41	        [SerializeField] private InputActionAsset _actions;
42	
43	        [Header("Дистанции")]
44	        [Tooltip("Радиус, с которого предмет берётся в руки, м")]
45	        [SerializeField] private float _pickupRadius = 2.4f;
46	
47	        [Tooltip("Радиус, с которого предмет ставится в слот, м")]
48	        [SerializeField] private float _slotRadius = 2.6f;
49	
50	        [Tooltip("Слои предметов; слой Player исключить")]
51	        [SerializeField] private LayerMask _mask = ~0;
52	
53	        private InputAction _interact;
54	        private Carryable _held;
55	        private float _gripOffset = 0.475f;
56	        private bool _handsSearched;
57	
58	        /// <summary>В руках есть предмет.</summary>
59	        public bool IsCarrying => _held != null;
60	
61	        private void Awake()
62	        {
63	            if (_locomotion == null)
64	            {
65	                _locomotion = GetComponent<RobotLocomotion>();
66	            }
67	
68	            if (_dialogue == null)
69	            {
70	                _dialogue = GetComponent<DialogueController>();
71	            }
72	
73	            var source = _actions != null ? _actions : InputSystem.actions;
74	            if (source != null)
75	            {
76	                _interact = source.FindAction("Player/Interact");
77	            }
78	        }
79	
80	        private void OnEnable()
81	        {
82	            _interact?.Enable();
83	        }
84	
85	        private void OnDisable()
86	        {
87	            _interact?.Disable();
88	        }
89	
90	        private void LateUpdate()
91	        {
92	            if (_held == null || _handAnchor == null)
93	            {
94	                return;
95	            }
96	
97	            EnsureHands();
98	            if (_handLeft == null || _handRight == null)
99	            {
100	                return;
101	            }
102	
103	            var left = _handLeft.position;
104	            var right = _handRight.position;
105	            var axis = right - left;
106	            if (axis.sqrMagnitude < 0.0004f)
107	            {
108	                return;
109	            }
110	
111	            var up = transform.up;
112	            var forward = Vector3.Cross(axis.normalized, up);
113	            if (forward.sqrMagnitude < 0.0001f)
114	            {
115	                forward = transform.forward;
116	            }
117	
118	            var middle = (left + right) * 0.5f;
119	            _handAnchor.position = middle - up * _gripOffset;
120	            _handAnchor.rotation = Quaternion.LookRotation(forward.normalized, up);
121	        }
122	
123	        /// <summary>
124	        /// Кости кистей ищутся один раз: визуал игрока подменяется после Awake,
125	        /// поэтому поиск идёт лениво, при первом подборе.
126	        /// </summary>
127	        private void EnsureHands()
128	        {
129	            if (_handLeft != null && _handRight != null)
130	            {
131	                return;
132	            }
133	
134	            if (_handsSearched)
135	            {
136	                return;
137	            }
138	
139	            _handsSearched = true;
140	            var all = GetComponentsInChildren<Transform>(true);
141	            for (var i = 0; i < all.Length; i++)
142	            {
143	                var bone = all[i];
144	                if (bone.name == "hand_l")
145	                {
146	                    _handLeft = bone;
147	                }
148	                else if (bone.name == "hand_r")
149	                {
150	                    _handRight = bone;
151	                }
152	            }
153	        }
154	
155	        private void Update()
156	        {
157	            if (_interact == null || !_interact.WasPressedThisFrame())
158	            {
159	                return;
160	            }
161	
162	            if (_dialogue != null && _dialogue.IsOpen)
163	            {
164	                return;
165	            }
166	
167	            if (_held != null)
168	            {
169	                TryPlaceOrDrop();
170	                return;
171	            }
172	
173	            var item = FindNearestItem();
174	            if (item != null)
175	            {
176	                var renderer = item.GetComponentInChildren<Renderer>();
177	                _gripOffset = renderer != null ? renderer.bounds.size.y * 0.62f : 0.58f;
178	                EnsureHands();
179	                item.Take(_handAnchor);
180	                _held = item;
181	                _locomotion?.SetCarrying(true);
182	            }
183	        }
184	
185	        private void TryPlaceOrDrop()
186	        {
187	            var slot = FindNearestSlot();
188	            if (slot != null && slot.TryPlace(_held))
189	            {
190	                Release();
191	                return;
192	            }
193	
194	            _held.Drop();
195	            Release();
196	        }
197	
198	        private void Release()
199	        {
200	            _held = null;
201	            _locomotion?.SetCarrying(false);
202	        }
203	
204	        private Carryable FindNearestItem()
205	        {
206	            var hits = Physics.OverlapSphere(transform.position, _pickupRadius, _mask,
207	                                             QueryTriggerInteraction.Collide);
208	            Carryable best = null;
209	            var bestDistance = float.MaxValue;
210	            for (var i = 0; i < hits.Length; i++)
211	            {
212	                var item = hits[i].GetComponentInParent<Carryable>();
213	                if (item == null || item.IsCarried || item.IsPlaced)
214	                {
215	                    continue;
216	                }
217	
218	                var distance = (item.transform.position - transform.position).sqrMagnitude;
219	                if (distance < bestDistance)
220	                {
221	                    bestDistance = distance;
222	                    best = item;
223	                }
224	            }
225	
226	            return best;
227	        }
228	
229	        private CarrySlot FindNearestSlot()
230	        {
231	            var slots = FindObjectsByType<CarrySlot>(FindObjectsSortMode.None);
232	            CarrySlot best = null;
233	            var bestDistance = float.MaxValue;
234	            for (var i = 0; i < slots.Length; i++)
235	            {
236	                var slot = slots[i];
237	                if (slot == null || !slot.IsFree)
238	                {
239	                    continue;
240	                }
241	
242	                var distance = (slot.transform.position - transform.position).sqrMagnitude;
243	                if (distance > _slotRadius * _slotRadius)
244	                {
245	                    continue;
246	                }
247	
248	                if (distance < bestDistance)
249	                {
250	                    bestDistance = distance;
251	                    best = slot;
252	                }
253	            }
254	
255	            return best;
256	        }
257	    }
258	}
