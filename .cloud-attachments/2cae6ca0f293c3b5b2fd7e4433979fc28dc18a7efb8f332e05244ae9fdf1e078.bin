pen\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);\naction.Invoke(director, new object[] { FrostSpace.Features.Dialogue.DialogueAction.AcceptQuest, \"train_batteries\" });\nvar slots = cart.GetComponentsInChildren<FrostSpace.Features.Carry.CarrySlot>(true);\nvar names = new[] { \"Prop_Battery_1\", \"Prop_Battery_2\", \"Prop_Battery_3\", \"Prop_Battery_4\" };\nfor (var i = 0; i < names.Length; i++) {\n    var battery = GameObject.Find(names[i]).GetComponent<FrostSpace.Features.Carry.Carryable>();\n    battery.Take(player.transform);\n    slots[i].TryPlace(battery);\n}\nopen.Invoke(controller, new object[] { speaker });\nadvance.Invoke(controller, null); // завершает печать d1, но не закрывает: d1 не терминальный\nadvance.Invoke(controller, null); // переходит к d2\nscreen.CompleteTyping();\nchoose.Invoke(controller, new object[] { 1 }); // d4, CompleteQuest срабатывает\nvar beforeClose = new { open = controller.IsOpen, quest = director.Log.State.ToString(), xp = xp.Experience, level = xp.Level };\nadvance.Invoke(controller, null); // должен дорисовать d4 и сразу закрыть\nvar map = UnityEngine.InputSystem.InputSystem.actions.FindActionMap(\"Player\", false);\nvar loco = player.GetComponent<FrostSpace.Features.Locomotion.RobotLocomotion>();\nvar so = new SerializedObject(loco);\nvar cam = GameObject.Find(\"Main Camera\").GetComponent<FrostSpace.Features.View.PlayerCameraRig>();\nreturn new {\n    beforeClose = beforeClose,\n    afterClose = controller.IsOpen,\n    conversationLock = so.FindProperty(\"_conversationLock\").boolValue,\n    cameraPaused = cam.IsPaused,\n    playerMapEnabled = map.enabled,\n    xp = xp.Experience,\n    level = xp.Level,\n    required = xp.ExperienceToNextLevel,\n    progress = xp.Progress01\n};\n'''\nwith Bridge(port=6401) as b:\n    print(json.dumps(b.call('execute_code', {'action': 'execute', 'code': code}), ensure_ascii=False, indent=2)[:4000])\nPY",
