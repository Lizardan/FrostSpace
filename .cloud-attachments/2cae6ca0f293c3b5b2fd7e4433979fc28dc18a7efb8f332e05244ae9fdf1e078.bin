1	using UnityEngine;
2	
3	namespace FrostSpace.Features.Carry
4	{
5	    /// <summary>
6	    /// Предмет, который можно взять в руки и поставить в слот.
7	    ///
8	    /// Дом предмета запоминается в <see cref="Awake"/>: брошенный предмет
9	    /// возвращается туда, чтобы квест нельзя было сломать, утащив аккумулятор
10	    /// в угол. Коллайдеры выключаются, пока предмет в руках или в слоте —
11	    /// иначе игрок толкает груз собственным капсульным коллайдером.
12	    /// </summary>
13	    [DisallowMultipleComponent]
14	    public sealed class Carryable : MonoBehaviour
15	    {
16	        [Tooltip("Тип предмета: слот принимает только совпадающий тип")]
17	        [SerializeField] private string _itemType = "battery";
18	
19	        private Vector3 _homePosition;
20	        private Quaternion _homeRotation;
21	        private Collider[] _colliders;
22	
23	        /// <summary>Тип предмета для сверки со слотом.</summary>
24	        public string ItemType => _itemType;
25	
26	        /// <summary>Предмет сейчас в руках.</summary>
27	        public bool IsCarried { get; private set; }
28	
29	        /// <summary>Предмет стоит в слоте.</summary>
30	        public bool IsPlaced { get; private set; }
31	
32	        private void Awake()
33	        {
34	            _homePosition = transform.position;
35	            _homeRotation = transform.rotation;
36	            _colliders = GetComponentsInChildren<Collider>(true);
37	        }
38	
39	        /// <summary>Взять в руки: предмет становится ребёнком якоря.</summary>
40	        public void Take(Transform anchor)
41	        {
42	            if (anchor == null || IsCarried || IsPlaced)
43	            {
44	                return;
45	            }
46	
47	            IsCarried = true;
48	            SetColliders(false);
49	            transform.SetParent(anchor, true);
50	            transform.localPosition = Vector3.zero;
51	            transform.localRotation = Quaternion.identity;
52	        }
53	
54	        /// <summary>Поставить в слот: предмет фиксируется на якоре слота.</summary>
55	        public void Place(Transform anchor)
56	        {
57	            if (anchor == null)
58	            {
59	                return;
60	            }
61	
62	            IsCarried = false;
63	            IsPlaced = true;
64	            transform.SetParent(anchor, true);
65	            transform.localPosition = Vector3.zero;
66	            transform.localRotation = Quaternion.identity;
67	            SetColliders(false);
68	        }
69	
70	        /// <summary>Бросить: предмет возвращается на исходное место.</summary>
71	        public void Drop()
72	        {
73	            IsCarried = false;
74	            IsPlaced = false;
75	            transform.SetParent(null, true);
76	            transform.position = _homePosition;
77	            transform.rotation = _homeRotation;
78	            SetColliders(true);
79	        }
80	
81	        private void SetColliders(bool enabled)
82	        {
83	            if (_colliders == null)
84	            {
85	                return;
86	            }
87	
88	            for (var i = 0; i < _colliders.Length; i++)
89	            {
90	                if (_colliders[i] != null)
91	                {
92	                    _colliders[i].enabled = enabled;
93	                }
94	            }
95	        }
96	    }
97	}
