  "new_string": "HALF_W = 4.0          # половина ширины вагона, м\nHALF_L = 12.0         # половина длины, м\nWALL = 0.2            # толщина стены\nHEIGHT = 3.2          # высота интерьера\nDOOR_W = 3.2          # ширина дверного проёма в торце\nDOOR_H = 2.6          # высота проёма\nSIDE_DOOR_Y = -1.0    # центр бокового проёма по длине (Unity z = +1.0)\nSIDE_DOOR_W = 2.6     # ширина бокового проёма, м\nSIDE_DOOR_H = 2.6     # высота бокового проёма, м\n\n\n# ------------------------------------------------------------------ вагон\n\ndef _segments(gap):\n    \"\"\"Отрезки вдоль длины, исключающие проём (Blender Y).\"\"\"\n    if gap is None:\n        return [(-HALF_L, HALF_L)]\n    lo, hi = gap\n    return [(-HALF_L, lo), (hi, HALF_L)]\n\n\ndef _wall_boxes(b, x, z, height, thickness, material, gap, bevel=0.02):\n    \"\"\"Коробки борта по отрезкам: проём вырезает панель, а не закрывает её.\"\"\"\n    for y0, y1 in _segments(gap):\n        if y1 - y0 <= 0.01:\n            continue\n        b.box((x, (y0 + y1) * 0.5, z), (thickness, y1 - y0, height),\n              material, bevel=bevel)\n\n\ndef _in_gap(y, gap, margin=0.0):\n    if gap is None:\n        return False\n    return gap[0] - margin <= y <= gap[1] + margin\n\n\ndef _side_door_frame(b, sx, gap):\n    \"\"\"Оранжевая рамка бокового проёма: видна и изнутри, и снаружи.\"\"\"\n    x = sx * (HALF_W - 0.02)\n    for y in (gap[0] - 0.08, gap[1] + 0.08):\n        b.box((x, y, SIDE_DOOR_H * 0.5), (0.18, 0.16, SIDE_DOOR_H),\n              \"Level_Orange\", bevel=0.0)\n    b.box((x, (gap[0] + gap[1]) * 0.5, SIDE_DOOR_H + 0.08),\n          (0.18, gap[1] - gap[0] + 0.32, 0.16), \"Level_Orange\", bevel=0.0)\n    b.box((sx * (HALF_W - 0.28), (gap[0] + gap[1]) * 0.5, 0.06),\n          (0.36, gap[1] - gap[0] + 0.2, 0.12), \"Level_Rust\", bevel=0.01)\n\n\ndef _closed_side_doors(b, sx, gap):\n    \"\"\"Закрытые створки внутри вагона: боковой проём есть, но вагон запечатан.\"\"\"\n    x = sx * (HALF_W - WALL * 0.5)\n    width = (gap[1] - gap[0]) * 0.5\n    for i in range(2):\n        cy = gap[0] + width * (i + 0.5)\n        b.box((x, cy, SIDE_DOOR_H * 0.5), (0.14, width - 0.02, SIDE_DOOR_H - 0.05),\n              \"Level_Metal\", bevel=0.02)\n        # Тёплое окно и аварийная полоса — дверь читается как дверь.\n        b.box((sx * (HALF_W - WALL - 0.02), cy, 1.95),\n              (0.06, width * 0.62, 0.44), \"Level_SnowDeep\", bevel=0.01)\n        b.box((sx * (HALF_W - WALL - 0.03), cy, 0.38),\n              (0.06, width * 0.7, 0.18), \"Level_Orange\", bevel=0.0)\n        for dy in (-0.26, 0.26):\n            b.box((sx * (HALF_W - WALL - 0.04), cy + dy, 1.3),\n                  (0.05, 0.06, 2.2), \"Level_Rust\", bevel=0.0)\n\n\ndef _wall(b, sx, materials, side_door=False, closed_doors=False):\n    \"\"\"Борт: нижняя панель, окна между стойками, верхняя полоса и рёбра.\n\n    У правого борта (Unity +X — сторона платформы) может быть боковой\n    грузовой проём: панели, подоконник, стойка и рёбра вокруг него\n    разрезаются, а не остаются поверх.\n    \"\"\"\n    x = sx * (HALF_W - WALL * 0.5)\n    gap = None\n    if side_door:\n        gap = (SIDE_DOOR_Y - SIDE_DOOR_W * 0.5,\n               SIDE_DOOR_Y + SIDE_DOOR_W * 0.5)\n\n    # Нижняя панель — дерево: металл в интерьере отражает небо и седеет.\n    _wall_boxes(b, x, 0.6, 1.2, WALL, \"Level_Wood\", gap)\n    _wall_boxes(b, x, 2.85, 0.7, WALL, \"Level_Stone\", gap)\n\n    # Подоконник и перемычка: тёмная ржавчина отделяет остекление.\n    _wall_boxes(b, sx * (HALF_W - 0.16), 1.26, 0.12, 0.24,\n                \"Level_Rust\", gap, bevel=0.01)\n    _wall_boxes(b, sx * (HALF_W - 0.16), 2.44, 0.12, 0.24,\n                \"Level_Rust\", gap, bevel=0.01)\n\n    # Стойки между окнами: восемь пролётов по 3 м.\n    for i in range(9):\n        y = -HALF_L + 1.5 + i * 2.625\n        if _in_gap(y, gap):\n            continue\n        b.box((x, y, 1.85), (0.24, 0.3, 1.3), \"Level_Metal\", bevel=0.015)\n        # Оранжевая метка на стойке — ориентир в длинном вагоне.\n        b.box((sx * (HALF_W - 0.3), y, 1.9), (0.06, 0.12, 0.5),\n              \"Level_Orange\", bevel=0.0)\n\n    # Рёбра жёсткости по нижней панели.\n    for i in range(17):\n        y = -HALF_L + 1.0 + i * 1.375\n        if _in_gap(y, gap, 0.15):\n            continue\n        b.box((sx * (HALF_W - 0.16), y, 0.55), (0.12, 0.18, 1.0),\n              \"Level_Metal\", bevel=0.01)\n\n    # Иней у пола ближе к двери: вагон холодный, дверь открывают редко.\n    for i in range(3):\n        y = -HALF_L + 1.2 + i * 1.1\n        if _in_gap(y, gap, 0.4):\n            continue\n        b.box((sx * (HALF_W - 0.45), y, 0.07), (0.55, 0.8, 0.1),\n              \"Level_Snow\", bevel=0.02)\n\n    if gap is not None:\n        _side_door_frame(b, sx, gap)\n        if closed_doors:\n            _closed_side_doors(b, sx, gap)\n",
  "old_string": "HALF_W = 4.0          # половина ширины вагона, м\nHALF_L = 12.0         # половина длины, м\nWALL = 0.2            # толщина стены\nHEIGHT = 3.2          # высота интерьера\nDOOR_W = 3.2          # ширина дверного проёма\nDOOR_H = 2.6          # высота проёма\n\n\n# ------------------------------------------------------------------ вагон\n\ndef _wall(b, sx, materials):\n    \"\"\"Борт: нижняя панель, окна между стойками, верхняя полоса и рёбра.\"\"\"\n    x = sx * (HALF_W - WALL * 0.5)\n\n    # Нижняя панель — дерево: металл в интерьере отражает небо и седеет.\n    b.box((x, 0.0, 0.6), (WALL, HALF_L * 2.0, 1.2), \"Level_Wood\", bevel=0.02)\n    b.box((x, 0.0, 2.85), (WALL, HALF_L * 2.0, 0.7), \"Level_Stone\", bevel=0.02)\n\n    # Подоконник и перемычка: тёмная ржавчина отделяет остекление.\n    b.box((sx * (HALF_W - 0.16), 0.0, 1.26), (0.24, HALF_L * 2.0, 0.12),\n          \"Level_Rust\", bevel=0.01)\n    b.box((sx * (HALF_W - 0.16), 0.0, 2.44), (0.24, HALF_L * 2.0, 0.12),\n          \"Level_Rust\", bevel=0.01)\n\n    # Стойки между окнами: восемь пролётов по 3 м.\n    for i in range(9):\n        y = -HALF_L + 1.5 + i * 2.625\n        b.box((x, y, 1.85), (0.24, 0.3, 1.3), \"Level_Metal\", bevel=0.015)\n        # Оранжевая метка на стойке — ориентир в длинном вагоне.\n        b.box((sx * (HALF_W - 0.3), y, 1.9), (0.06, 0.12, 0.5),\n              \"Level_Orange\", bevel=0.0)\n\n    # Рёбра жёсткости по нижней панели.\n    for i in range(17):\n        y = -HALF_L + 1.0 + i * 1.375\n        b.box((sx * (HALF_W - 0.16), y, 0.55), (0.12, 0.18, 1.0),\n              \"Level_Metal\", bevel=0.01)\n\n    # Иней у пола ближе к двери: вагон холодный, дверь открывают редко.\n    for i in range(3):\n        y = -HALF_L + 1.2 + i * 1.1\n        b.box((sx * (HALF_W - 0.45), y, 0.07), (0.55, 0.8, 0.1),\n              \"Level_Snow\", bevel=0.02)\n"
}
