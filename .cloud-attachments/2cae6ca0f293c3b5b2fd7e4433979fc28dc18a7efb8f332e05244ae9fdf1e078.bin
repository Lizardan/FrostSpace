38	        [SerializeField] private Color _text = new(0.72f, 0.86f, 0.92f, 1f);
39	        [SerializeField] private Color _dim = new(0.30f, 0.42f, 0.50f, 1f);
40	        [SerializeField] private Color _cardIdle = new(0.045f, 0.075f, 0.095f, 0.92f);
41	        [SerializeField] private Color _cardHover = new(0.08f, 0.14f, 0.18f, 0.95f);
42	
43	        private const float CardWidth = 380f;
44	        private const float CardHeight = 560f;
45	        private const float CardGap = 40f;
46	        private const float CardTop = 320f;
47	        private const float PreviewHeight = 340f;
