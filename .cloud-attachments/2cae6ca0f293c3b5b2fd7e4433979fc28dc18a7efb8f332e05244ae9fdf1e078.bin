670	            var markerRect = marker.rectTransform;
671	            markerRect.anchorMin = new Vector2(0f, 0f);
672	            markerRect.anchorMax = new Vector2(0f, 1f);
673	            markerRect.pivot = new Vector2(0f, 0.5f);
