537	        private Switch BuildSwitch(
538	            Transform parent, string name, string label, float y, UnityEngine.Events.UnityAction action)
539	        {
540	            var row = new GameObject(name, typeof(RectTransform));
541	            row.transform.SetParent(parent, false);
542	            var rowRect = (RectTransform)row.transform;
543	            rowRect.anchorMin = new Vector2(0f, 1f);
544	            rowRect.anchorMax = new Vector2(1f, 1f);
545	            rowRect.pivot = new Vector2(0.5f, 1f);
546	            rowRect.offsetMin = new Vector2(28f, 0f);
547	            rowRect.offsetMax = new Vector2(-28f, 0f);
548	            rowRect.sizeDelta = new Vector2(rowRect.sizeDelta.x, 56f);
549	            rowRect.anchoredPosition = new Vector2(0f, y);
550	
551	            var hit = row.AddComponent<Image>();
552	            hit.color = new Color(_buttonIdle.r, _buttonIdle.g, _buttonIdle.b, 0.55f);
553	
554	            var button = row.AddComponent<Button>();
555	            button.targetGraphic = hit;
556	            button.transition = Selectable.Transition.ColorTint;
557	            var colors = button.colors;
558	            colors.normalColor = new Color(_buttonIdle.r, _buttonIdle.g, _buttonIdle.b, 0.55f);
559	            colors.highlightedColor = _buttonHover;
560	            colors.pressedColor = _accent;
561	            colors.selectedColor = _buttonHover;
562	            colors.fadeDuration = 0.12f;
563	            button.colors = colors;
564	            button.onClick.AddListener(action);
565	
566	            NewText(row.transform, "Label", label, 19f, _text, TextAlignmentOptions.Left,
567	                new Vector2(0f, 0.5f), new Vector2(20f, 0f), new Vector2(440f, 28f), 4f);
568	
569	            var track = NewImage(row.transform, "Track", new Color(_dim.r, _dim.g, _dim.b, 0.35f));
570	            var trackRect = track.rectTransform;
571	            trackRect.anchorMin = new Vector2(1f, 0.5f);
572	            trackRect.anchorMax = new Vector2(1f, 0.5f);
573	            trackRect.pivot = new Vector2(1f, 0.5f);
574	            trackRect.sizeDelta = new Vector2(72f, 26f);
575	            trackRect.anchoredPosition = new Vector2(-96f, 0f);
576	
577	            var knob = NewImage(track.transform, "Knob", _text);
578	            var knobRect = knob.rectTransform;
579	            knobRect.anchorMin = new Vector2(1f, 0.5f);
580	            knobRect.anchorMax = new Vector2(1f, 0.5f);
581	            knobRect.pivot = new Vector2(0.5f, 0.5f);
582	            knobRect.sizeDelta = new Vector2(20f, 20f);
583	            knobRect.anchoredPosition = new Vector2(-16f, 0f);
584	
585	            var state = NewText(row.transform, "State", "ВКЛ", 17f, _accent, TextAlignmentOptions.Right,
586	                new Vector2(1f, 0.5f), new Vector2(-20f, 0f), new Vector2(60f, 24f), 2f);
587	
588	            return new Switch { Track = track, Knob = knobRect, State = state, Value = true };
589	        }
