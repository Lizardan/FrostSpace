{
  "content": "using System.Collections;\nusing FrostSpace.Features.Carry;\nusing FrostSpace.Features.Locomotion;\nusing UnityEngine;\n\nnamespace FrostSpace.Features.Story\n{\n    /// <summary>\n    /// Прибытие в депо (DP-01): дверь вагона уже открыта, R13 выходит на\n    /// платформу, за ним выезжает тележка с четырьмя аккумуляторами. На время\n    /// выхода игрок стоит без управления, затем оно возвращается само.\n    ///\n    /// Груз тележки фиксируется в гнёздах в <see cref=\"Start\"/>: сцена не\n    /// хранит runtime-состояние слотов, а без этого аккумуляторы остались бы\n    /// «брошенными» и с включёнными коллайдерами.\n    /// </summary>\n    [DisallowMultipleComponent]\n    [DefaultExecutionOrder(-30)]\n    public sealed class DepotArrivalDirector : MonoBehaviour\n    {\n        private static readonly int MovingId = Animator.StringToHash(\"Moving\");\n\n        [Header(\"Ссылки\")]\n        [SerializeField] private RobotLocomotion _locomotion;\n        [Tooltip(\"R13 — сценовый актёр с Animator\")]\n        [SerializeField] private Transform _r13;\n        [SerializeField] private Animator _r13Animator;\n        [Tooltip(\"Тележка с четырьмя гнёздами\")]\n        [SerializeField] private Transform _cart;\n        [SerializeField] private CarrySlot[] _slots = new CarrySlot[0];\n        [SerializeField] private Carryable[] _cargo = new Carryable[0];\n\n        [Header(\"Выход\")]\n        [Tooltip(\"Пауза перед началом, с\")]\n        [SerializeField] private float _startDelay = 0.4f;\n        [Tooltip(\"Куда выходит R13\")]\n        [SerializeField] private Vector3 _r13Exit = new(-4.6f, 0.6f, -0.3f);\n        [SerializeField] private float _r13Seconds = 3.2f;\n        [Tooltip(\"Задержка тележки после старта R13, с\")]\n        [SerializeField] private float _cartDelay = 0.5f;\n        [Tooltip(\"Куда выезжает тележка\")]\n        [SerializeField] private Vector3 _cartExit = new(-2.8f, 0.6f, -1.7f);\n        [SerializeField] private float _cartSeconds = 4.4f;\n        [Tooltip(\"Пауза на месте перед возвратом управления, с\")]\n        [SerializeField] private float _settleSeconds = 0.4f;\n\n        private void Awake()\n        {\n            if (_locomotion == null)\n                _locomotion = FindAnyObjectByType<RobotLocomotion>();\n            if (_r13Animator == null && _r13 != null)\n                _r13Animator = _r13.GetComponentInChildren<Animator>(true);\n        }\n\n        private void Start()\n        {\n            StartCoroutine(Play());\n        }\n\n        private IEnumerator Play()\n        {\n            _locomotion?.SetConversationLock(true);\n            LoadCargo();\n\n            var r13Start = _r13 != null ? _r13.position : Vector3.zero;\n            var cartStart = _cart != null ? _cart.position : Vector3.zero;\n\n            yield return Wait(_startDelay);\n\n            if (_r13 != null)\n            {\n                _r13Animator?.SetBool(MovingId, true);\n                StartCoroutine(Move(_r13, r13Start, _r13Exit, _r13Seconds));\n            }\n\n            yield return Wait(_cartDelay);\n\n            if (_cart != null)\n                StartCoroutine(Move(_cart, cartStart, _cartExit, _cartSeconds));\n\n            // Управление возвращается, когда оба встали: R13 идёт быстрее\n            // тележки и к её финишу уже ждёт на месте.\n            yield return Wait(Mathf.Max(_r13Seconds, _cartDelay + _cartSeconds));\n\n            _r13Animator?.SetBool(MovingId, false);\n            yield return Wait(_settleSeconds);\n            _locomotion?.SetConversationLock(false);\n        }\n\n        private void LoadCargo()\n        {\n            var count = Mathf.Min(_slots.Length, _cargo.Length);\n            for (var i = 0; i < count; i++)\n            {\n                var slot = _slots[i];\n                var item = _cargo[i];\n                if (slot == null || item == null || !slot.IsFree)\n                    continue;\n\n                item.Take(slot.transform);\n                slot.TryPlace(item);\n            }\n        }\n\n        private static IEnumerator Move(Transform target, Vector3 from, Vector3 to, float seconds)\n        {\n            if (seconds <= 0f)\n            {\n                target.position = to;\n                yield break;\n            }\n\n            var elapsed = 0f;\n            while (elapsed < seconds)\n            {\n                elapsed += Time.deltaTime;\n                var t = Mathf.SmoothStep(0f, 1f, Mathf.Clamp01(elapsed / seconds));\n                target.position = Vector3.LerpUnclamped(from, to, t);\n                yield return null;\n            }\n\n            target.position = to;\n        }\n\n        private static IEnumerator Wait(float seconds)\n        {\n            if (seconds <= 0f)\n                yield break;\n\n            var elapsed = 0f;\n            while (elapsed < seconds)\n            {\n                elapsed += Time.deltaTime;\n                yield return null;\n            }\n        }\n    }\n}\n",
  "file_path": "F:\\Unity Projects\\FrostSpace\\Assets\\_Project\\Scripts\\Features\\Story\\DepotArrivalDirector.cs"
}
```

