29	        [Test]
30	        public void Folder_ContainsStarterAndTrainDialogues()
31	        {
32	            var names = LoadAll().Select(asset => asset.name).ToArray();
33	            foreach (var expected in new[]
34	                     {
35	                         "R2_Furnace", "R3_Scout", "R4_Hauler", "R5_Ranger",
36	                         "TrainCompanion_Intro", "TrainCompanion_Done"
37	                     })
38	            {
39	                CollectionAssert.Contains(names, expected);
40	            }
41	        }
42	
43	        [Test]
44	        public void AllDialogues_AreValid()
45	        {
46	            foreach (var asset in LoadAll())
47	            {
48	                var errors = new List<string>();
49	                asset.CollectProblems(errors, null);
50	                Assert.IsEmpty(errors, $"{asset.name}: {string.Join("; ", errors)}");
51	            }
52	        }
53	
54	        [Test]
55	        public void AllDialogues_StartAtExistingNode()
56	        {
57	            foreach (var asset in LoadAll())
58	                Assert.IsNotNull(asset.StartNode, $"{asset.name}: стартовый узел не найден.");
59	        }
60	
61	        [Test]
62	        public void AllDialogues_BranchAndReachAnEnd()
63	        {
64	            foreach (var asset in LoadAll())
65	            {
66	                var branch = asset.Nodes.Any(node => node != null && node.Choices.Count >= 2);
67	                Assert.IsTrue(branch, $"{asset.name}: нет узла с ветвлением.");
68	
69	                var endings = asset.Nodes.Count(Ends);
70	                Assert.GreaterOrEqual(endings, 2, $"{asset.name}: нужно минимум две концовки.");
71	            }
72	        }
73	
74	        [Test]
75	        public void AllDialogues_RespectChoiceLimit()
76	        {
77	            foreach (var asset in LoadAll())
78	            {
79	                foreach (var node in asset.Nodes)
80	                {
81	                    if (node == null)
82	                        continue;
83	
84	                    Assert.LessOrEqual(
85	                        node.Choices.Count, DialogueAsset.MaxChoices,
86	                        $"{asset.name}/{node.Id}: вариантов больше, чем помещается в панель.");
87	                }
88	            }
89	        }
90	
91	        [Test]
92	        public void AllLines_FitWarningLimit()
93	        {
94	            foreach (var asset in LoadAll())
95	            {
96	                foreach (var node in asset.Nodes)
97	                {
98	                    if (node == null)
99	                        continue;
100	
101	                    Assert.LessOrEqual(
102	                        node.Line.Length, DialogueAsset.LongLineWarning,
103	                        $"{asset.name}/{node.Id}: реплика не помещается в панель.");
104	                }
105	            }
106	        }
107	
108	        [Test]
109	        public void AllLines_AreRussian()
110	        {
111	            foreach (var asset in LoadAll())
112	            {
113	                foreach (var node in asset.Nodes)
114	                {
115	                    if (node == null)
116	                        continue;
117	
118	                    Assert.IsTrue(
119	                        HasCyrillic(node.Line),
