#### Tool: Write

**Input:**

```json
{
  "content": "var sb = new System.Text.StringBuilder();\nvar roots = UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects();\nforeach (var go in roots)\n{\n    if (go.name == \"Player\" || go.name == \"R13_Prospector\" || go.name == \"Prop_GravCart\" || go.name.StartsWith(\"Prop_Battery\"))\n    {\n        sb.AppendLine(\"=== \" + go.name + \" pos=\" + go.transform.position.ToString(\"F3\") + \" rot=\" + go.transform.eulerAngles.ToString(\"F1\") + \" scale=\" + go.transform.localScale.ToString(\"F3\"));\n        foreach (var c in go.GetComponents<UnityEngine.Component>())\n        {\n            sb.AppendLine(\"  \" + c.GetType().Name);\n            if (c is UnityEngine.MonoBehaviour mb)\n            {\n                var so = new UnityEditor.SerializedObject(mb);\n                var it = so.GetIterator();\n                while (it.NextVisible(true))\n                {\n                    if (it.name == \"m_Script\") continue;\n                    sb.AppendLine(\"     \" + it.name + \" = \" + it.propertyType + \" : \" + (it.propertyType == UnityEditor.SerializedPropertyType.ObjectReference ? (it.objectReferenceValue != null ? it.objectReferenceValue.name : \"null\") : it.ToString()));\n                }\n            }\n        }\n        foreach (var t in go.GetComponentsInChildren<UnityEngine.Transform>(true))\n        {\n            if (t == go.transform) continue;\n            sb.AppendLine(\"    child \" + t.name + \" pos=\" + t.position.ToString(\"F3\") + \" scale=\" + t.lossyScale.ToString(\"F3\"));\n        }\n    }\n}\nreturn sb.ToString();\n",
  "file_path": "F:\\Unity Projects\\FrostSpace\\Temp\\dump_train.cs"
}
```

**Response:**

