639	        private Button NewButton(
640	            Transform parent, string name, string label, Vector2 position,
641	            UnityEngine.Events.UnityAction action, float width = ButtonWidth, float fontSize = 24f)
642	        {
643	            var go = new GameObject(name, typeof(RectTransform));
644	            go.transform.SetParent(parent, false);
645	            var rect = (RectTransform)go.transform;
646	            rect.anchorMin = new Vector2(0f, 1f);
647	            rect.anchorMax = new Vector2(0f, 1f);
648	            rect.pivot = new Vector2(0f, 1f);
649	            rect.sizeDelta = new Vector2(width, ButtonHeight);
650	            rect.anchoredPosition = position;
651	
652	            var background = go.AddComponent<Image>();
653	            background.color = _buttonIdle;
