    ```
    const int w=512,h=128;
    var tex=new Texture2D(w,h,TextureFormat.RGBA32,false){name="ChassisHoloRing", wrapMode=Clamp, filterMode=Bilinear, hideFlags=HideAndDontSave};
    for y,x:
      var nx=(x-(w-1)*.5f)/(w*.46f);
      var ny=(y-(h-1)*.5f)/(h*.30f); // ellipse
      var r=Mathf.Sqrt(nx*nx+ny*ny);
      var ring=Mathf.Abs(r-1f)<0.018f;
      var dash=Mathf.Sin(Mathf.Atan2(ny,nx)*18f)>0.25f;
      var glow=Mathf.Exp(-Mathf.Pow((r-1f)/0.10f,2f))*0.25f;
      var alpha=ring&&dash?1f:glow;
      tex.SetPixel(x,y,new Color(1,1,1,alpha));
    tex.Apply();
    ```
    - `Sprite.Create` with pixelsPerUnit 100; `Image` color accent. Size 460×80. 
