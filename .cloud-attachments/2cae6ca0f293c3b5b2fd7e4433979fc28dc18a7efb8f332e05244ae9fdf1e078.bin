**Response:**

1	using System;
2	using UnityEngine;
3	
4	namespace FrostSpace.Features.Carry
5	{
6	    /// <summary>
7	    /// Гнездо под предмет: принимает только свой тип и только если свободно.
8	    ///
9	    /// Событие <see cref="Placed"/> — единственный сигнал квесту: директор
10	    /// подписывается на конкретные слоты сцены, глобальной шины нет (ADR 0027).
11	    /// </summary>
12	    [DisallowMultipleComponent]
13	    public sealed class CarrySlot : MonoBehaviour
14	    {
15	        [Tooltip("Тип предмета, который принимает слот")]
16	        [SerializeField] private string _acceptedType = "battery";
17	
18	        [Tooltip("Точка, куда встаёт предмет; пусто — сам объект слота")]
19	        [SerializeField] private Transform _anchor;
20	
21	        /// <summary>Слот занял предмет: аргументы — слот и предмет.</summary>
22	        public event Action<CarrySlot, Carryable> Placed;
23	
24	        /// <summary>Тип, который принимает слот.</summary>
25	        public string AcceptedType => _acceptedType;
26	
27	        /// <summary>Предмет в слоте; null — свободно.</summary>
28	        public Carryable Occupant { get; private set; }
29	
30	        /// <summary>Слот свободен.</summary>
31	        public bool IsFree => Occupant == null;
32	
33	        private void Awake()
34	        {
35	            if (_anchor == null)
36	            {
37	                _anchor = transform;
38	            }
39	        }
40	
41	        /// <summary>Поставить предмет, если он подходит и слот свободен.</summary>
42	        public bool TryPlace(Carryable item)
43	        {
44	            if (item == null || !IsFree || !item.IsCarried)
45	            {
46	                return false;
47	            }
48	
49	            if (!string.Equals(item.ItemType, _acceptedType, StringComparison.Ordinal))
50	            {
51	                return false;
52	            }
53	
54	            Occupant = item;
55	            item.Place(_anchor);
56	            Placed?.Invoke(this, item);
57	            return true;
58	        }
59	    }
60	}
