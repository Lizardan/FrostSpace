 .xpv-d .xpv-end {\n      position: absolute;\n      left: 25%;\n      top: 2px;\n      bottom: 2px;\n      width: 1px;\n      background: var(--cyan-bright);\n      box-shadow: 0 0 14px var(--cyan);\n    }\n\n    #xp-bar-sketches .xpv-scan {\n      position: absolute;\n      inset: 0;\n      z-index: 2;\n      pointer-events: none;\n      opacity: .32;\n      background: linear-gradient(180deg, transparent 0%, rgba(77, 230, 255, .30) 48%, transparent 52%, transparent 100%);\n      animation: xpv-scan 3.4s linear infinite;\n    }\n\n    @keyframes xpv-scan {\n      0% { transform: translateY(-100%); }\n      100% { transform: translateY(100%); }\n    }\n\n    #xp-bar-sketches .xpv-footer {\n      position: relative;\n      z-index: 1;\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      gap: 6px 18px;\n      padding-top: 12px;\n      border-top: 1px solid rgba(77, 230, 255, .10);\n      color: var(--dim);\n      font-size: 11px;\n      letter-spacing: .06em;\n    }\n\n    #xp-bar-sketches .xpv-footer strong {\n      color: var(--cyan);\n      font-weight: 500;\n    }\n\n    @media (max-width: 560px) {\n      #xp-bar-sketches .xpv-shell { padding: 16px 14px 14px; }\n      #xp-bar-sketches .xpv-row { grid-template-columns: 1fr; gap: 8px; padding: 14px 0; }\n      #xp-bar-sketches .xpv-meta { display: flex; align-items: baseline; gap: 8px; padding: 0; }\n      #xp-bar-sketches .xpv-name, #xp-bar-sketches .xpv-desc { margin: 0; }\n      #xp-bar-sketches .xpv-desc { display: none; }\n      #xp-bar-sketches .xpv-line { gap: 8px; }\n      #xp-bar-sketches .xpv-level { width: 44px; font-size: 11px; }\n      #xp-bar-sketches .xpv-text { font-size: 10px; letter-spacing: .02em; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      #xp-bar-sketches .xpv-scan { animation: none; display: none; }\n    }\n  </style>\n\n  <div class=\"xpv-shell\">\n    <div class=\"xpv-head\">\n      <h3 class=\"xpv-title\">Варианты XP-полосы</h3>\n 