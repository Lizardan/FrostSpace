99:| `TR-02` | Напарник | У стеллажа стоит `R13_Prospector`, над ним маркер разговора. | Подход в радиус 4 м показывает маркер; E открывает диалог; без маркера E не работает. |
100:| `TR-03` | Диалог знакомства | R13 объясняет: новый курьер, память перезагрузили, рейс до северной станции, груз — четыре аккумулятора. В конце — `AcceptQuest`. | После диалога квест активен, в трекере цель «поговорить» закрыта, следующая — «погрузить 0/4». |
101:| `TR-04` | Склад | Вдоль стены лежат четыре `Prop_Battery` — по одному, не штабелем. | В вагоне ровно 4 предмета, каждый лежит отдельно и не пересекается с геометрией. |
102:| `TR-05` | Подбор | Каждый аккумулятор берётся по E, если руки свободны; в руках — `CarryWalk`, скорость из профиля корпуса. | Подбор и перенос работают; скорость в руках ниже, чем без груза, и зависит от корпуса; спринт и прыжок в руках недоступны. |
103:| `TR-06` | Тележка | Грави-тележка `Prop_GravCart` стоит у выхода, у неё четыре слота. По E у слота предмет встаёт в свободный слот. | Каждый слот принимает только аккумулятор; повторная установка в занятый слот не срабатывает; счётчик растёт на 1. |
104:| `TR-07` | Повтор | Пункты `TR-04`–`TR-06` повторяются, пока не заняты все четыре слота. | Трекер показывает `BATTERIES 4/4`; после четвёртого предмета цель закрывается. |
105:| `TR-08` | Похвала | У R13 появляется маркер завершения; короткий диалог: хвалит, говорит про депо, просит не потерять тележку. Действие `CompleteQuest`. | После диалога квест закрыт, маркер исчез, дверь открывается по сценарию финала. |
106:| `TR-09` | Отъезд | Камера плавно отъезжает от вагона к окну; параллакс ускоряется и уходит в размытие; экран белеет. | Последовательность проигрывается один раз, управление на это время отключено, вернуться в вагон нельзя. |
107:| `TR-10` | Титул | На белом — `FROSTSPACE` и подпись-строка; экран живёт поверх загрузки `Frontier` и гаснет в депо. | Титул виден над занавесом (`sortingOrder` выше 1000), не переживает переход в `Frontier`, в депо экран уже нормальный. |
297:| `TrainMotionRig` | параллакс, снег, вибрация; останавливается после `TR-08` |
340:- `TR-01`…`TR-10` и `DP-01`…`DP-04` проходят в одном Play-прогоне без ошибок в Console.
364:| `TR-01`, `TR-02` | Этап 2 | сцена `Train`, R13 |
365:| `TR-03` | Этап 2 | `QuestAsset`, диалоги |
366:| `TR-04`…`TR-07` | Этап 2 | `Prop_Battery`, `Prop_GravCart`, `CarryController` |
367:| `TR-08` | Этап 2 | квест, диалог похвалы |
368:| `TR-09`, `TR-10` | Этап 2 | `TitleCardScreen`, `TrainSequenceDirector` |
369:| `DP-01`…`DP-04` | Этап 2 | сцена `Frontier`, `R16_Warden`, `R8_Bulwark`, `R7_Drifter` |
---NODE---
using System.Collections.Generic;
using UnityEngine;

namespace FrostSpace.Features.Dialogue
{
    /// <summary>
    /// Одна реплика робота с переходами. Узел либо предлагает варианты ответа
    /// (<c>Choices</c>), либо идёт дальше по <c>NextId</c>; пустой переход — конец.
    ///
    /// Id присваивается один раз при создании и не меняется при перестановке узлов:
    /// переходы хранятся строкой, а не индексом списка.
    /// </summary>
    [System.Serializable]
    public sealed class DialogueNode
    {
        [SerializeField] private string _id;
        [TextArea(2, 6)]
        [SerializeField] private string _line;
        [SerializeField] private List<DialogueChoice> _choices = new();
        [Tooltip("Переход, когда вариантов нет. Пусто — конец диалога.")]
        [SerializeField] private string _nextId;

        public DialogueNode()
        {
        }

        public DialogueNode(string id, string line)
        {
            _id = id;
            _line = line;
        }

        /// <summary>Стабильный id узла, read-only в инспекторе.</summary>
        public string Id => _id;

        /// <summary>Реплика робота.</summary>
        public string Line => _line;

        /// <summary>Варианты ответа игрока. Пусто — реплика идёт дальше сама.</summary>
        public IReadOnlyList<DialogueChoice> Choices => _choices;

        /// <summary>Переход без вариантов; для узла с вариантами не используется.</summary>
        public string NextId => _nextId;

        /// <summary>Узел завершает диалог: ни вариантов, ни перехода.</summary>
        public bool IsTerminal => _choices.Count == 0 && string.IsNullOrWhiteSpace(_nextId);

        public void SetLine(string line) => _line = line;

        public void SetNextId(string nextId) => _nextId = nextId;

        /// <summary>Добавляет вариант без ограничения: лимит проверяет валидация.</summary>
        public DialogueChoice AddChoice(string text = "", string nextId = "")
        {
            var choice = new DialogueChoice(text, nextId);
            _choices.Add(choice);
            return choice;
        }

        public void RemoveChoiceAt(int index)
        {
            if (index >= 0 && index < _choices.Count)
                _choices.RemoveAt(index);
        }

        /// <summary>Копия с новым id: строки и варианты переносятся как есть.</summary>
        internal DialogueNode Clone(string id)
        {
            var copy = new DialogueNode(id, _line);
            copy._nextId = _nextId;
            for (var i = 0; i < _choices.Count; i++)
                copy._choices.Add(new DialogueChoice(_choices[i].Text, _choices[i].NextId));
            return copy;
        }

        /// <summary>Заменяет переходы на удалённый узел концом диалога.</summary>
        internal void Forget(string removedId)
        {
            if (_nextId == removedId)
                _nextId = string.Empty;

            for (var i = 0; i < _choices.Count; i++)
            {
                if (_choices[i].NextId == removedId)
                    _choices[i].SetNextId(string.Empty);
            }
        }
    }
}
