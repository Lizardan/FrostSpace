{
  "content": "var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();\nvar report = new System.Text.StringBuilder();\n\nvoid SetRef(UnityEngine.Object target, string field, UnityEngine.Object value)\n{\n    var so = new UnityEditor.SerializedObject(target);\n    var prop = so.FindProperty(field);\n    if (prop == null) { report.AppendLine(\"MISSING FIELD \" + field); return; }\n    prop.objectReferenceValue = value;\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\nvoid SetVector(UnityEngine.Object target, string field, UnityEngine.Vector3 value)\n{\n    var so = new UnityEditor.SerializedObject(target);\n    var prop = so.FindProperty(field);\n    if (prop == null) { report.AppendLine(\"MISSING FIELD \" + field); return; }\n    prop.vector3Value = value;\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\nvoid SetFloat(UnityEngine.Object target, string field, float value)\n{\n    var so = new UnityEditor.SerializedObject(target);\n    var prop = so.FindProperty(field);\n    if (prop == null) { report.AppendLine(\"MISSING FIELD \" + field); return; }\n    prop.floatValue = value;\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\n// Старый узкий поезд и нарисованная дверь больше не нужны.\nvar oldTrain = UnityEngine.GameObject.Find(\"DepotTrain\");\nif (oldTrain != null) UnityEngine.Object.DestroyImmediate(oldTrain);\nvar oldDoorway = UnityEngine.GameObject.Find(\"DepotDoorway\");\nif (oldDoorway != null) UnityEngine.Object.DestroyImmediate(oldDoorway);\n\n// Поезд: тот же вагон 8 × 24, что и в Train, с боковым проёмом к платформе.\nvar prefab = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(\"Assets/_Project/Content/Models/Train/TrainExterior.fbx\");\nvar train = (UnityEngine.GameObject)UnityEditor.PrefabUtility.InstantiatePrefab(prefab, scene);\ntrain.name = \"DepotTrain\";\nUnityEditor.PrefabUtility.UnpackPrefabInstance(train, UnityEditor.PrefabUnpackMode.Completely, UnityEditor.InteractionMode.AutomatedAction);\ntrain.transform.position = new UnityEngine.Vector3(-8f, 1f, -2f);\ntrain.transform.rotation = UnityEngine.Quaternion.identity;\nvar trainBox = train.AddComponent<UnityEngine.BoxCollider>();\ntrainBox.center = new UnityEngine.Vector3(0f, 1.7f, 0f);\ntrainBox.size = new UnityEngine.Vector3(8f, 3.4f, 24f);\n\n// Платформа заканчивается у борта вагона: рельс и колёса остаются снаружи.\nvar platform = UnityEngine.GameObject.Find(\"DepotPlatform\").transform;\nplatform.position = new UnityEngine.Vector3(5.5f, 0.3f, 0f);\nplatform.localScale = new UnityEngine.Vector3(19f, 0.6f, 14f);\nvar edge = UnityEngine.GameObject.Find(\"PlatformEdge\").transform;\nedge.position = new UnityEngine.Vector3(5.5f, 0.62f, -7.1f);\nedge.localScale = new UnityEngine.Vector3(19f, 0.06f, 0.25f);\nvar roof = UnityEngine.GameObject.Find(\"AwningRoof\").transform;\nroof.position = new UnityEngine.Vector3(3.5f, 5.45f, 1.5f);\nroof.localScale = new UnityEngine.Vector3(15f, 0.22f, 9f);\nvar awningEdge = UnityEngine.GameObject.Find(\"AwningEdge\").transform;\nawningEdge.position = new UnityEngine.Vector3(3.5f, 5.3f, 6f);\nawningEdge.localScale = new UnityEngine.Vector3(15f, 0.1f, 0.2f);\nUnityEngine.GameObject.Find(\"AwningPost_L-1\").transform.position = new UnityEngine.Vector3(-3.5f, 2.8f, 5f);\nUnityEngine.GameObject.Find(\"AwningPost_L1\").transform.position = new UnityEngine.Vector3(-3.5f, 2.8f, -2f);\nUnityEngine.GameObject.Find(\"DepotLamp\").transform.position = new UnityEngine.Vector3(3.5f, 4.6f, 1.5f);\nvar track = UnityEngine.GameObject.Find(\"DepotTrack\").transform;\ntrack.position = new UnityEngine.Vector3(-8f, 0f, -2f);\n\nvar player = UnityEngine.GameObject.FindWithTag(\"Player\");\nplayer.transform.position = new UnityEngine.Vector3(3.2f, 0.7f, -1.6f);\nplayer.transform.eulerAngles = new UnityEngine.Vector3(0f, 270f, 0f);\n\nvar wardenA = UnityEngine.GameObject.Find(\"R16_Warden_A\");\nwardenA.transform.position = new UnityEngine.Vector3(-2.4f, 0.7f, -4.8f);\nwardenA.transform.eulerAngles = new UnityEngine.Vector3(0f, 20f, 0f);\nvar wardenB = UnityEngine.GameObject.Find(\"R16_Warden_B\");\nwardenB.transform.position = new UnityEngine.Vector3(0.6f, 0.7f, -5f);\nwardenB.transform.eulerAngles = new UnityEngine.Vector3(0f, 340f, 0f);\nvar drifter = UnityEngine.GameObject.Find(\"R7_Drifter\");\ndrifter.transform.position = new UnityEngine.Vector3(7f, 0.7f, 3.2f);\ndrifter.transform.eulerAngles = new UnityEngine.Vector3(0f, 210f, 0f);\n\n// R13 и тележка едут внутри вагона: на время прибытия они его дети.\nvar cart = UnityEngine.GameObject.Find(\"Prop_GravCart\");\nvar r13 = UnityEngine.GameObject.Find(\"R13_Prospector\");\ncart.transform.SetParent(train.transform, false);\ncart.transform.localPosition = new UnityEngine.Vector3(2.4f, 0f, 0.8f);\ncart.transform.localRotation = UnityEngine.Quaternion.identity;\nr13.transform.SetParent(train.transform, false);\nr13.transform.localPosition = new UnityEngine.Vector3(2.8f, 0f, 1.6f);\nr13.transform.localRotation = UnityEngine.Quaternion.Euler(0f, 90f, 0f);\n\nvar left = train.transform.Find(\"TrainSideDoorL\");\nvar right = train.transform.Find(\"TrainSideDoorR\");\nreport.AppendLine(\"train=\" + train.name + \" left=\" + (left != null ? left.localPosition.ToString(\"F2\") : \"null\") + \" right=\" + (right != null ? right.localPosition.ToString(\"F2\") : \"null\"));\n\nvar arrival = UnityEngine.GameObject.Find(\"DepotArrival\").GetComponent<FrostSpace.Features.Story.DepotArrivalDirector>();\nSetRef(arrival, \"_train\", train.transform);\nSetRef(arrival, \"_doorLeft\", left);\nSetRef(arrival, \"_doorRight\", right);\nSetRef(arrival, \"_r13\", r13.transform);\nSetRef(arrival, \"_cart\", cart.transform);\nSetVector(arrival, \"_r13Exit\", new UnityEngine.Vector3(-1.6f, 0.6f, 0f));\nSetVector(arrival, \"_cartExit\", new UnityEngine.Vector3(0.8f, 0.6f, -1.2f));\nSetVector(arrival, \"_shotPosition\", new UnityEngine.Vector3(5.5f, 3.6f, 6f));\nSetVector(arrival, \"_shotTarget\", new UnityEngine.Vector3(-2.5f, 1.8f, -1f));\n\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);\nUnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene, \"Assets/Scenes/Frontier.unity\");\nUnityEditor.AssetDatabase.SaveAssets();\nreport.AppendLine(\"saved Frontier\");\nreturn report.ToString();\n",
