291	                Close();
292	                return;
293	            }
294	
295	            if (keyboard.eKey.wasPressedThisFrame)
296	            {
297	                OnAdvancePressed();
298	                return;
299	            }
300	
301	            for (var i = 0; i < DialogueAsset.MaxChoices; i++)
302	            {
303	                if (keyboard[(Key)((int)Key.Digit1 + i)].wasPressedThisFrame)
