{
  "file_path": "F:\\Unity Projects\\FrostSpace\\Tools\\Blender\\build_train.py",
  "new_string": "    return [body, door]\n\n\n# ------------------------------------------------------------ экстерьер вагона\n\ndef _exterior_roof(b):\n    \"\"\"Крыша, рёбра и снег: снаружи вагон читается как рабочий, а не коробка.\"\"\"\n    b.box((0.0, 0.0, HEIGHT + 0.12), (HALF_W * 2.0, HALF_L * 2.0, 0.24),\n          \"Level_Stone\", bevel=0.02)\n    b.box((0.0, 0.0, HEIGHT + 0.30), (HALF_W * 2.0 - 0.35, HALF_L * 2.0 - 0.4, 0.12),\n          \"Level_Snow\", bevel=0.03)\n    for i in range(9):\n        y = -HALF_L + 1.5 + i * 2.625\n        b.box((0.0, y, HEIGHT + 0.04), (HALF_W * 2.0 + 0.06, 0.16, 0.12),\n              \"Level_Metal\", bevel=0.01)\n\n    # Сугробы на крыше: редкие пятна, чтобы снег не выглядел литым.\n    for x, y, sx, sy in ((-2.2, -7.0, 2.4, 3.2), (1.8, 2.5, 3.0, 2.6),\n                         (0.4, 8.6, 3.4, 2.0), (-1.2, -1.0, 2.0, 1.8)):\n        b.box((x, y, HEIGHT + 0.39), (sx, sy, 0.1), \"Level_SnowDeep\", bevel=0.04)\n\n\ndef _exterior_ends(b):\n    \"\"\"Торцы с окном, фарами, буфером и сцепкой.\"\"\"\n    for sy in (-1, 1):\n        y = sy * (HALF_L - 0.1)\n        face = sy * (HALF_L + 0.01)\n        b.box((0.0, y, HEIGHT * 0.5), (HALF_W * 2.0, 0.2, HEIGHT),\n              \"Level_Metal\", bevel=0.02)\n\n        # Окно торца в ржавой рамке.\n        b.box((0.0, face, 2.0), (1.4, 0.06, 0.7), \"Level_SnowDeep\",\n              bevel=0.01)\n        for dz in (-1, 1):\n            b.box((0.0, face + sy * 0.02, 2.0 + dz * 0.39),\n                  (1.5, 0.06, 0.08), \"Level_Rust\", bevel=0.0)\n        for dx in (-1, 1):\n            b.box((dx * 0.74, face + sy * 0.02, 2.0),\n                  (0.08, 0.06, 0.78), \"Level_Rust\", bevel=0.0)\n\n        # Фары и габариты.\n        for sx in (-1, 1):\n            b.box((sx * 2.6, face, 1.9), (0.5, 0.08, 0.3), \"Level_Window\",\n                  bevel=0.01)\n            b.box((sx * 2.6, face, 1.2), (0.3, 0.08, 0.18), \"Level_Orange\",\n                  bevel=0.0)\n\n        # Сцепка и буфер.\n        b.box((0.0, sy * (HALF_L + 0.32), 0.7), (0.7, 0.64, 0.3),\n              \"Level_Rust\", bevel=0.02)\n        b.box((0.0, sy * (HALF_L + 0.06), 0.45), (2.2, 0.12, 0.16),\n              \"Level_Orange\", bevel=0.0)\n\n\ndef _exterior_bogies(b):\n    \"\"\"Две тележки по четыре колеса: низ на z = -1.0, поезд стоит на рельсе.\"\"\"\n    b.box((0.0, 0.0, -0.22), (HALF_W * 2.0 - 0.6, HALF_L * 2.0 - 0.8, 0.44),\n          \"Level_Metal\", bevel=0.02)\n    for sx in (-1, 1):\n        b.box((sx * 3.85, 0.0, 0.08), (0.2, HALF_L * 2.0 - 0.2, 0.16),\n              \"Level_Rust\", bevel=0.01)\n\n    for by in (-8.0, 8.0):\n        b.box((0.0, by, -0.45), (4.8, 3.2, 0.3), \"Level_Metal\",\n              bevel=0.02)\n        for dy in (-1.0, 1.0):\n            y = by + dy\n            b.box((0.0, y, -0.65), (5.8, 0.16, 0.16), \"Level_Rust\",\n                  bevel=0.0)\n            for sx in (-1, 1):\n                x = sx * 2.95\n                b.tube([(x - 0.12, y, -0.65), (x + 0.12, y, -0.65)],\n                       [(0.35, 0.35), (0.35, 0.35)], \"Level_Metal\", n=10)\n\n\ndef _build_side_leaf(materials, name, y_center):\n    \"\"\"Створка боковой двери отдельным объектом: сцена раздвигает её по Z.\"\"\"\n    d = level_lib.LevelBuilder(materials)\n    d.box((0.0, 0.0, 0.0), (0.12, 1.28, SIDE_DOOR_H - 0.05),\n          \"Level_Metal\", bevel=0.02)\n    # Окно и аварийная полоса снаружи.\n    d.box((0.07, 0.0, 0.65), (0.05, 0.62, 0.44), \"Level_SnowDeep\",\n          bevel=0.01)\n    d.box((0.07, 0.0, -0.92), (0.05, 0.72, 0.18), \"Level_Orange\",\n          bevel=0.0)\n    for dy in (-0.26, 0.26):\n        d.box((0.07, dy, 0.0), (0.05, 0.06, 2.2), \"Level_Rust\", bevel=0.0)\n    # Ручка и петли.\n    d.box((0.1, 0.42, -0.25), (0.06, 0.1, 0.5), \"Level_Rust\", bevel=0.01)\n    leaf = d.build(name)\n    leaf.location = (4.06, y_center, SIDE_DOOR_H * 0.5)\n    return leaf\n\n\ndef build_exterior(materials):\n    \"\"\"Экстерьер вагона 8 × 24 м: та же палитра, окна и рёбра, что внутри.\"\"\"\n    b = level_lib.LevelBuilder(materials)\n    for sx in (-1, 1):\n        _wall(b, sx, materials, side_door=sx > 0, closed_doors=False)\n    _exterior_roof(b)\n    _exterior_ends(b)\n    _exterior_bogies(b)\n\n    # Порог и ступени под боковой дверью: выход на платформу.\n    b.box((4.3, SIDE_DOOR_Y, 0.35), (0.6, SIDE_DOOR_W, 0.12),\n          \"Level_Metal\", bevel=0.01)\n    b.box((4.55, SIDE_DOOR_Y, 0.12), (0.5, SIDE_DOOR_W - 0.3, 0.1),\n          \"Level_Rust\", bevel=0.01)\n    for sx in (-1, 1):\n        b.box((4.02, SIDE_DOOR_Y + sx * (SIDE_DOOR_W * 0.5 + 0.2), 1.9),\n              (0.06, 0.12, 0.3), \"Level_Orange\", bevel=0.0)\n\n    # Габаритные огни по борту.\n    for i in range(7):\n        y = -10.5 + i * 3.5\n        b.box((HALF_W + 0.02, y, 2.95), (0.06, 0.18, 0.12),\n              \"Level_Orange\", bevel=0.0)\n\n    body = b.build(\"TrainExteriorBody\")\n    left = _build_side_leaf(materials, \"TrainSideDoorL\",\n                            SIDE_DOOR_Y - SIDE_DOOR_W * 0.25 + 0.0)\n    right = _build_side_leaf(materials, \"TrainSideDoorR\",\n                             SIDE_DOOR_Y + SIDE_DOOR_W * 0.25 + 0.0)\n    return [body, left, right]\n",
