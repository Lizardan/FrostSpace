Design PlayerEquipment API:
```
[DisallowMultipleComponent]
public sealed class PlayerEquipment : MonoBehaviour
{
    [SerializeField] private DialogueController _dialogue;
    [SerializeField] private ObjectScanner _scanner;

    public bool HasScanner { get; private set; }
    public bool HasMap { get; private set; }
    public event Action Changed;

    private void Awake(){ if(_dialogue==null) _dialogue=GetComponent<DialogueController>(); if(_scanner==null) _scanner=FindAnyObjectByType<ObjectScanner>(); }
    private void OnEnable(){ if(_dialogue!=null) _dialogue.ActionInvoked += OnAction; }
    private void OnDisable(){ ... }
    private void OnAction(DialogueAction action, string questId){ Apply(action); }
    public void Apply(DialogueAction action) {
        switch(action){
          case GrantScanner: if(HasScanner) return; HasScanner=true; if(_scanner!=null) _scanner.SetAvailable(true); break;
          case GrantMap: if(HasMap) return; HasMap=true; break;
          default: return;
        }
        Changed?.Invoke();
    }
}
```
