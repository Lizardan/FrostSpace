689	            rect.pivot = new Vector2(0f, 0f);
690	            rect.sizeDelta = new Vector2(160f, 50f);
691	            rect.anchoredPosition = new Vector2(28f, 24f);
692	        }
693	
694	        private Sprite GearSprite
695	        {
696	            get
697	            {
698	                if (_gearSprite != null)
699	                    return _gearSprite;
700	
701	                _gearTexture = BuildGearTexture();
702	                _gearSprite = Sprite.Create(
703	                    _gearTexture,
704	                    new Rect(0f, 0f, _gearTexture.width, _gearTexture.height),
705	                    new Vector2(0.5f, 0.5f),
706	                    100f);
707	                return _gearSprite;
708	            }
709	        }
710	
711	        private static Texture2D BuildGearTexture()
712	        {
713	            const int size = 64;
714	            var texture = new Texture2D(size, size, TextureFormat.RGBA32, false)
715	            {
716	                name = "PauseGear",
717	                wrapMode = TextureWrapMode.Clamp,
718	                filterMode = FilterMode.Bilinear,
719	                hideFlags = HideFlags.HideAndDontSave,
720	            };
721	
722	            var center = (size - 1) * 0.5f;
723	            for (var y = 0; y < size; y++)
724	            {
725	                for (var x = 0; x < size; x++)
726	                {
727	                    var dx = x - center;
728	                    var dy = y - center;
729	                    var radius = Mathf.Sqrt(dx * dx + dy * dy);
730	                    var angle = Mathf.Atan2(dy, dx);
731	                    var sector = Mathf.PI * 2f / 8f;
732	                    var phase = Mathf.Repeat(angle + Mathf.PI, sector);
733	                    var tooth = phase < sector * 0.55f;
734	                    var body = radius >= 7f && radius <= 24f;
735	                    var rim = radius > 24f && radius <= 30f && tooth;
736	                    var alpha = body || rim ? 1f : 0f;
737	                    texture.SetPixel(x, y, new Color(1f, 1f, 1f, alpha));
738	                }
739	            }
740	
741	            texture.Apply();
742	            return texture;
743	        }
744	
745	        private static void Stretch(RectTransform rect)
746	        {
747	            rect.anchorMin = Vector2.zero;
748	            rect.anchorMax = Vector2.one;
749	            rect.offsetMin = Vector2.zero;
750	            rect.offsetMax = Vector2.zero;
751	        }
752	
753	        private static Image NewImage(Transform parent, string name, Color color)
754	        {
755	            var go = new GameObject(name, typeof(RectTransform));
756	            go.transform.SetParent(parent, false);
757	            var image = go.AddComponent<Image>();
758	            image.color = color;
759	            image.raycastTarget = false;
760	            return image;
761	        }
762	
763	        private TextMeshProUGUI NewText(
764	            Transform parent, string name, string content, float size, Color color,
765	            TextAlignmentOptions alignment, Vector2 anchor, Vector2 position, Vector2 boxSize, float spacing)
766	        {
767	            var go = new GameObject(name, typeof(RectTransform));
768	            go.transform.SetParent(parent, false);
769	            var rect = (RectTransform)go.transform;
770	            rect.anchorMin = anchor;
771	            rect.anchorMax = anchor;
772	            rect.pivot = new Vector2(
773	                anchor.x <= 0f ? 0f : anchor.x >= 1f ? 1f : 0.5f,
774	                anchor.y <= 0f ? 0f : anchor.y >= 1f ? 1f : 0.5f);
775	            rect.sizeDelta = boxSize;
776	            rect.anchoredPosition = position;
777	
778	            var text = go.AddComponent<TextMeshProUGUI>();
779	            text.font = _font != null ? _font : TMP_Settings.defaultFontAsset;
780	            text.text = content;
781	            text.fontSize = size;
782	            text.color = color;
783	            text.alignment = alignment;
784	            text.characterSpacing = spacing;
785	            text.textWrappingMode = TextWrappingModes.NoWrap;
786	            text.raycastTarget = false;
787	            return text;
788	        }
789	    }
790	}
