6	namespace FrostSpace.Features.Dialogue
7	{
8	    /// <summary>
9	    /// Маркер разговариваемого NPC на сценовом актёре (не на визуальном префабе —
10	    /// ADR 0004). Держит ассет диалога и останавливает патруль на время разговора.
11	    ///
12	    /// Имя и категория берутся у <see cref="ScanTarget"/>: подпись диалога и подпись
13	    /// сканера говорят об одном роботе одно и то же. Если маркера нет, имя чистится
14	    /// так же, как это делает сканер.
15	    /// </summary>
16	    [DisallowMultipleComponent]
17	    public sealed class DialogueSpeaker : MonoBehaviour
18	    {
19	        [Header("Ссылки")]
20	        [Tooltip("Патрульный NPC; пусто — ищется на этом объекте")]
21	        [SerializeField] private NpcController _npc;
22	        [Tooltip("Диалог робота")]
23	        [SerializeField] private DialogueAsset _dialogue;
24	
25	        private bool _usable;
26	
27	        /// <summary>Диалог робота.</summary>
28	        public DialogueAsset Dialogue => _dialogue;
29	
30	        /// <summary>Разговор уже идёт: второй раз не открываем.</summary>
31	        public bool IsTalking { get; private set; }
32	
33	        /// <summary>Имя в шапке панели.</summary>
34	        public string DisplayName { get; private set; } = "UNKNOWN";
35	
36	        /// <summary>Категория в шапке панели.</summary>
37	        public string Category { get; private set; } = "NPC";
38	
39	        /// <summary>
40	        /// С роботом можно поговорить: диалог назначен, граф без ошибок, разговор
41	        /// ещё не начат. Предупреждения (циклы, длинные реплики) не блокируют.
42	        /// </summary>
43	        public bool CanTalk => _usable && !IsTalking;
44	
45	        private void Awake()
46	        {
47	            if (_npc == null)
48	                _npc = GetComponent<NpcController>();
49	
50	            var target = ScanTarget.Find(transform);
51	            if (target == null)
52	                target = GetComponentInChildren<ScanTarget>(true);
53	
54	            if (target != null)
55	            {
56	                DisplayName = target.DisplayName;
57	                Category = target.Category;
58	            }
59	            else
60	            {
61	                DisplayName = ScanTarget.Sanitize(name);
62	                Category = "NPC";
63	            }
64	
65	            _usable = false;
66	            if (_dialogue == null)
67	                return;
68	
69	            var errors = new List<string>();
70	            _dialogue.CollectProblems(errors, null);
71	            _usable = errors.Count == 0;
72	            if (!_usable)
73	            {
74	                Debug.LogError(
75	                    $"DialogueSpeaker: диалог «{_dialogue.name}» содержит ошибки — {errors[0]}",
76	                    this);
77	            }
78	        }
79	
80	        /// <summary>Останавливает NPC и фиксирует собеседника.</summary>
81	        public void BeginConversation(Transform player)
82	        {
83	            if (!CanTalk || player == null)
84	                return;
85	
86	            IsTalking = true;
87	            _npc?.EnterConversation(player);
88	        }
89	
90	        /// <summary>Возвращает NPC на маршрут.</summary>
91	        public void EndConversation()
92	        {
93	            if (!IsTalking)
94	                return;
95	
96	            IsTalking = false;
97	            _npc?.EndConversation();
98	        }
99	    }
100	}
