1	using System.Collections.Generic;
2	using UnityEngine;
3	
4	namespace FrostSpace.Features.Scan
5	{
6	    /// <summary>
7	    /// Имя и категория объекта для подписи сканера. Компонент необязателен: без него
8	    /// сканер берёт имя GameObject и чистит его от суффиксов вроде <c>_Model</c>.
9	    ///
10	    /// Подписи — латиница: атлас <c>LiberationSans SDF</c> не содержит кириллицы,
11	    /// а имена ассетов в проекте английские.
12	    ///
13	    /// Компонент же служит маркером «этот объект сканируется»: <see cref="ObjectScanner"/>
14	    /// больше не читает произвольную геометрию под лучом, а берёт цели из реестра
15	    /// <see cref="All"/>. Поэтому рельеф, снег и стены подписей не получают — маркера
16	    /// у них нет.
17	    /// </summary>
18	    [DisallowMultipleComponent]
19	    public sealed class ScanTarget : MonoBehaviour
20	    {
21	        private static readonly List<ScanTarget> Registry = new(64);
22	
23	        [Tooltip("Имя в подписи; пусто — берётся имя GameObject")]
24	        [SerializeField] private string _displayName;
25	
26	        [Tooltip("Строка категории над именем, например STRUCTURE или NPC")]
27	        [SerializeField] private string _category = "OBJECT";
28	
29	        private Renderer[] _renderers;
30	        private bool _hasBounds;
31	        private Bounds _bounds;
32	
33	        /// <summary>Все активные цели в сцене.</summary>
34	        public static IReadOnlyList<ScanTarget> All => Registry;
35	
36	        /// <summary>Имя для подписи.</summary>
37	        public string DisplayName => string.IsNullOrWhiteSpace(_displayName)
38	            ? Sanitize(name)
39	            : _displayName;
40	
41	        /// <summary>Категория для подписи.</summary>
42	        public string Category => string.IsNullOrWhiteSpace(_category) ? "OBJECT" : _category;
43	
44	        /// <summary>
45	        /// Мировые границы цели по всем рендерерам — считаются каждый вызов.
46	        ///
47	        /// Кэша нет намеренно: у движущихся NPC и животных границы меняются кадр от кадра,
48	        /// и подпись с рамкой прыгали раз в четверть секунды вместо того, чтобы ехать за
49	        /// объектом. Список рендереров при этом кэшируется один раз, поэтому измерения —
50	        /// это чтение <c>Renderer.bounds</c> без обхода иерархии и без аллокаций.
51	        /// </summary>
52	        public Bounds WorldBounds => MeasureBounds();
53	
54	        /// <summary>Точка подписи: центр мировых границ.</summary>
55	        public Vector3 Anchor => MeasureBounds().center;
56	
57	        /// <summary>Границы цели в мировых координатах, без кэша по времени.</summary>
58	        public Bounds MeasureBounds()
59	        {
60	            if (_renderers == null)
61	                _renderers = GetComponentsInChildren<Renderer>(true);
62	
63	            var found = false;
64	            var bounds = new Bounds(transform.position, Vector3.one);
65	
66	            for (var i = 0; i < _renderers.Length; i++)
67	            {
68	                var renderer = _renderers[i];
69	                if (renderer == null || !renderer.enabled || !renderer.gameObject.activeInHierarchy)
70	                    continue;
71	
72	                // Собственные дубли подсветки в границы не входят: они помечены DontSave
73	                // и висят детьми тех же рендереров, поэтому без этой проверки границы
74	                // пересчитывались бы вместе с обводкой.
75	                if ((renderer.gameObject.hideFlags & HideFlags.DontSave) != 0)
76	                    continue;
77	
78	                if (!found)
79	                {
80	                    bounds = renderer.bounds;
81	                    found = true;
82	                }
83	                else
84	                {
85	                    bounds.Encapsulate(renderer.bounds);
86	                }
87	            }
88	
89	            if (found)
90	                _bounds = bounds;
91	
92	            _hasBounds = _hasBounds || found;
93	            return _hasBounds ? _bounds : bounds;
94	        }
95	
96	        /// <summary>
97	        /// Domain reload выключен: без сброса реестр пережил бы выход из Play Mode и
98	        /// наполнился бы ссылками на уничтоженные объекты.
99	        /// </summary>
100	        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.SubsystemRegistration)]
101	        private static void ResetStatics()
102	        {
103	            Registry.Clear();
104	        }
105	
106	        private void OnEnable()
107	        {
108	            if (!Registry.Contains(this))
109	                Registry.Add(this);
110	        }
111	
112	        private void OnDisable()
113	        {
114	            Registry.Remove(this);
115	        }
116	
117	        /// <summary>Ближайшая метка вверх по иерархии или <c>null</c>.</summary>
118	        public static ScanTarget Find(Transform from)
119	        {
120	            return from == null ? null : from.GetComponentInParent<ScanTarget>();
121	        }
122	
123	        /// <summary>
124	        /// Имя объекта в вид для сканера: без служебных суффиксов, подчёркивания
125	        /// заменены пробелами, всё в верхнем регистре — так подпись читается как
126	        /// показание прибора, а не как имя файла.
127	        /// </summary>
128	        public static string Sanitize(string raw)
129	        {
130	            if (string.IsNullOrWhiteSpace(raw))
131	                return "UNKNOWN";
132	
133	            var text = raw.Replace("_Model", string.Empty)
134	                .Replace("(Clone)", string.Empty)
135	                .Replace('_', ' ')
136	                .Trim();
137	
138	            return text.Length == 0 ? "UNKNOWN" : text.ToUpperInvariant();
139	        }
140	    }
141	}
