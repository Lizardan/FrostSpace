94	        private GameObject _root;
95	        private GameObject _overviewPanel;
96	        private GameObject _journalPanel;
97	        private GameObject _settingsPanel;
98	        private TextMeshProUGUI _overviewText;
99	        private TextMeshProUGUI _journalText;
100	        private Switch _music;
101	        private Switch _nearest;
102	        private Switch _aim;
103	        private Content _content;
104	        private Texture2D _gearTexture;
105	        private Sprite _gearSprite;
106	
107	        public bool IsPaused { get; private set; }
108	
109	        private void Awake()
110	        {
111	            if (_rig == null)
112	                _rig = FindAnyObjectByType<PlayerCameraRig>();
113	            if (_scanner == null)
114	                _scanner = FindAnyObjectByType<ObjectScanner>();
115	
116	            EnsureEventSystem();
117	            BuildInterface();
118	            SetVisible(false);
119	        }
120	
121	        private void OnDisable()
122	        {
123	            if (IsPaused)
124	                Resume();
125	        }
126	
127	        private void OnDestroy()
128	        {
129	            if (_gearSprite != null)
130	                Destroy(_gearSprite);
131	            if (_gearTexture != null)
132	                Destroy(_gearTexture);
133	        }
134	
135	        private void Update()
136	        {
137	            var keyboard = Keyboard.current;
138	            if (keyboard == null || !keyboard.escapeKey.wasPressedThisFrame)
139	                return;
140	
141	            if (IsPaused && _content != Content.Overview)
142	            {
143	                ShowContent(Content.Overview);
144	                return;
145	            }
146	
147	            if (IsPaused)
148	                Resume();
149	            else
150	                Open();
151	        }
152	
153	        /// <summary>Открывает паузу. Публичный: паузу может включить не только Esc.</summary>
154	        public void Open()
155	        {
156	            if (IsPaused)
157	                return;
158	
159	            IsPaused = true;
160	            Time.timeScale = 0f;
161	
162	            if (_rig != null)
163	                _rig.SetPaused(true);
164	            if (_scanner != null)
165	                _scanner.enabled = false;
166	
167	            Cursor.lockState = CursorLockMode.None;
168	            Cursor.visible = true;
169	
170	            ShowContent(Content.Overview);
171	            RefreshSwitches();
172	            RefreshOverview();
173	            RefreshJournal();
174	            SetVisible(true);
175	        }
176	
177	        /// <summary>Возвращает игру: время, камера, сканер и курсор — в исходное состояние.</summary>
178	        public void Resume()
179	        {
180	            IsPaused = false;
181	            Time.timeScale = 1f;
182	
183	            if (_scanner != null)
184	                _scanner.enabled = true;
185	            if (_rig != null)
186	                _rig.SetPaused(false);
187	
188	            SetVisible(false);
189	        }
190	
191	        private void OnSettingsPressed()
192	        {
193	            if (_content == Content.Settings)
194	            {
195	                ShowContent(Content.Overview);
196	                return;
197	            }
198	
199	            ShowContent(Content.Settings);
200	            RefreshSwitches();
201	        }
202	
203	        private void OnJournalPressed()
204	        {
205	            if (_content == Content.Journal)
206	            {
207	                ShowContent(Content.Overview);
208	                return;
209	            }
210	
211	            ShowContent(Content.Journal);
212	            RefreshJournal();
213	        }
214	
215	        private void OnBackPressed() => ShowContent(Content.Overview);
216	
217	        private void OnMainMenuPressed()
218	        {
219	            Resume();
220	
221	            var controller = SceneController.Instance;
222	            if (controller == null)
223	            {
224	                Debug.LogError("PauseMenuScreen: нет SceneController — переход в меню невозможен", this);
225	                return;
226	            }
227	
228	            controller.LoadScene(_mainMenuScene);
229	        }
230	
231	        private void ShowContent(Content content)
232	        {
233	            _content = content;
234	            _overviewPanel.SetActive(content == Content.Overview);
235	            _journalPanel.SetActive(content == Content.Journal);
236	            _settingsPanel.SetActive(content == Content.Settings);
237	
238	            if (content == Content.Overview)
239	                RefreshOverview();
240	            else if (content == Content.Journal)
241	                RefreshJournal();
242	            else
243	                RefreshSwitches();
244	        }
245	
246	        private void RefreshSwitches()
247	        {
248	            if (_music == null || _nearest == null || _aim == null)
249	                return;
250	
251	            _music.Value = GameSettings.MusicEnabled;
252	            _nearest.Value = GameSettings.NearestDetection;
253	            _aim.Value = GameSettings.AimDetection;
254	
255	            _music.Apply(_accent, _dim);
256	            _nearest.Apply(_accent, _dim);
257	            _aim.Apply(_accent, _dim);
258	        }
259	
260	        private void ToggleMusic()
261	        {
262	            GameSettings.MusicEnabled = !GameSettings.MusicEnabled;
263	            RefreshSwitches();
264	        }
265	
266	        private void ToggleNearest()
267	        {
268	            GameSettings.NearestDetection = !GameSettings.NearestDetection;
269	            RefreshSwitches();
270	        }
271	
272	        private void ToggleAim()
273	        {
274	            GameSettings.AimDetection = !GameSettings.AimDetection;
275	            RefreshSwitches();
276	        }
