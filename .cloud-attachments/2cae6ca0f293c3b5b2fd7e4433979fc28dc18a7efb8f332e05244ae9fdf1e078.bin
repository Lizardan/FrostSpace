131	            return node.Choices.Any(choice => string.IsNullOrWhiteSpace(choice.NextId));
132	        }
133	
134	        private static bool HasCyrillic(string text)
135	        {
136	            if (string.IsNullOrEmpty(text))
137	                return false;
138	
139	            foreach (var symbol in text)
140	            {
141	                if (symbol >= '\u0400' && symbol <= '\u04FF')
142	                    return true;
143	            }
144	
145	            return false;
146	        }
