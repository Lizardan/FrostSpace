1	using UnityEngine;
2	
3	namespace FrostSpace.Features.Npc
4	{
5	    /// <summary>
6	    /// Автоматический NPC: идёт к точке маршрута, стоит паузу 2–10 с, идёт к
7	    /// следующей; после последней снова к первой. Без точек маршрута стоит на
8	    /// месте. Ввод не читается — NPC игроком не управляется.
9	    ///
10	    /// Скорость анимации подгоняется под фактическую (как у RobotLocomotion),
11	    /// а если NPC упирается в препятствие и дольше _stuckSeconds не
12	    /// приближается к цели, точка пропускается: маршрут не встаёт колом.
13	    /// </summary>
14	    [RequireComponent(typeof(CharacterController))]
15	    public sealed class NpcController : MonoBehaviour
16	    {
17	        private static readonly int MovingId = Animator.StringToHash("Moving");
18	
19	        [Header("Маршрут")]
20	        [Tooltip("Точки по порядку. Пусто — NPC стоит на месте.")]
21	        [SerializeField] private Transform[] _waypoints;
22	
23	        [Header("Ссылки")]
24	        [Tooltip("Animator визуальной модели — дочерний объект")]
25	        [SerializeField] private Animator _animator;
26	
27	        [Header("Движение, м/с")]
28	        [SerializeField] private float _walkSpeed = 1.05f;
29	        [Tooltip("Разгон, м/с^2")]
30	        [SerializeField] private float _acceleration = 3.5f;
31	        [Tooltip("Скорость доворота корпуса, градусов/с")]
32	        [SerializeField] private float _turnSpeed = 240f;
33	        [Tooltip("С какого расстояния точка считается достигнутой, м")]
34	        [SerializeField] private float _arriveRadius = 0.5f;
35	
36	        [Header("Пауза на точке, с")]
37	        [SerializeField] private float _idleMin = 2f;
38	        [SerializeField] private float _idleMax = 10f;
39	
40	        [Header("Антизастревание")]
41	        [Tooltip("Сколько секунд без прогресса считать, что NPC упёрся")]
42	        [SerializeField] private float _stuckSeconds = 2f;
43	        [Tooltip("Прогресс к цели ниже этого (м/с) считается стоянием на месте")]
44	        [SerializeField] private float _stuckProgress = 0.05f;
45	
46	        // Базовая скорость клипа Walk, м/с: Animator.speed = фактическая /
47	        // базовая, чтобы стопа не проскальзывала. Замер в Unity; вручную не
48	        // правится (как у RobotLocomotion).
49	        [SerializeField, HideInInspector] private float _walkClipSpeed = 0.912f;
50	
51	        private CharacterController _controller;
52	        // Мировые позиции точек, снятые один раз при включении: вейпоинты —
53	        // дочерние объекты NPC, и при движении они едут вместе с ним. Маршрут
54	        // хранится в абсолютных координатах, поэтому агенту всё равно, куда
55	        // сместились сами маркеры.
56	        private Vector3[] _targets;
57	        private float _speed;
58	        private float _verticalVelocity;
59	        private float _animatorSpeed = 1f;
60	        private float _idleTimer;
61	        private float _stuckTimer;
62	        private float _previousDistance = float.MaxValue;
63	        private int _index;
64	        private bool _conversing;
65	        private Transform _conversationFocus;
66	
67	        /// <summary>NPC остановлен разговором и смотрит на собеседника.</summary>
68	        public bool IsConversing => _conversing;
69	
70	        /// <summary>
71	        /// Останавливает патруль и поворачивает корпус к собеседнику. Таймер паузы
72	        /// на точке замораживается, поэтому после разговора маршрут продолжается
73	        /// с того же места и с тем же остатком паузы.
74	        /// </summary>
75	        public void EnterConversation(Transform focus)
76	        {
77	            _conversationFocus = focus;
78	            if (_conversing)
79	                return;
80	
81	            _conversing = true;
82	            _speed = 0f;
83	            if (_animator != null)
84	                _animator.SetBool(MovingId, false);
85	        }
86	
87	        /// <summary>Возвращает NPC на маршрут; антизастревание начинается заново.</summary>
88	        public void EndConversation()
89	        {
90	            if (!_conversing)
91	                return;
92	
93	            _conversing = false;
94	            _conversationFocus = null;
95	            _speed = 0f;
96	            _stuckTimer = 0f;
97	            _previousDistance = float.MaxValue;
98	        }
99	
100	        private void Awake()
101	        {
102	            _controller = GetComponent<CharacterController>();
103	            if (_animator == null)
104	                _animator = GetComponentInChildren<Animator>();
105	            if (_animator == null)
106	            {
107	                Debug.LogError("NpcController: не назначен Animator визуальной модели", this);
108	                enabled = false;
109	            }
110	            else
111	            {
112	                // Без этого анимация замирает, когда актёр уходит за край кадра.
113	                AnimationCulling.Apply(_animator);
114	            }
115	
116	            if (_waypoints != null && _waypoints.Length > 0)
117	            {
118	                _targets = new Vector3[_waypoints.Length];
119	                for (var i = 0; i < _waypoints.Length; i++)
120	                {
121	                    _targets[i] = _waypoints[i] != null
122	                        ? _waypoints[i].position
123	                        : transform.position;
124	                }
125	            }
126	        }
127	
128	        private void Update()
129	        {
130	            var deltaTime = Time.deltaTime;
131	            var planar = Vector3.zero;
132	
133	            // Разговор важнее маршрута: скорость гасится сразу, чтобы NPC не
134	            // проехал лишний метр, пока панель уже открыта. Гравитация остаётся.
135	            if (_conversing)
136	            {
137	                _speed = 0f;
138	                FaceConversationFocus(deltaTime);
139	            }
140	            // Маршрута нет — стоит на месте; иначе идёт к текущей точке.
141	            else if (_targets != null && _targets.Length > 0)
142	            {
143	                if (_idleTimer > 0f)
144	                {
145	                    _idleTimer -= deltaTime;
146	                    if (_idleTimer <= 0f)
147	                        GoToNextPoint();
148	                    _speed = Mathf.MoveTowards(
149	                        _speed, 0f, _acceleration * 2f * deltaTime);
150	                }
151	                else
152	                {
153	                    var offset = _targets[_index] - transform.position;
154	                    offset.y = 0f;
155	                    var distance = offset.magnitude;
156	
157	                    if (distance <= _arriveRadius)
158	                    {
159	                        // Точка достигнута: пауза и затем переход к следующей.
160	                        _idleTimer = Random.Range(_idleMin, _idleMax);
161	                        _previousDistance = float.MaxValue;
162	                        _speed = Mathf.MoveTowards(
163	                            _speed, 0f, _acceleration * 2f * deltaTime);
164	                    }
165	                    else
166	                    {
167	                        var direction = offset / Mathf.Max(distance, 0.001f);
168	                        _speed = Mathf.MoveTowards(
169	                            _speed, _walkSpeed, _acceleration * deltaTime);
170	
171	                        var rotation = Quaternion.LookRotation(direction, Vector3.up);
172	                        transform.rotation = Quaternion.RotateTowards(
173	                            transform.rotation, rotation, _turnSpeed * deltaTime);
174	
175	                        // Антизастревание: сколько времени нет прогресса к цели.
176	                        if (_previousDistance - distance < _stuckProgress * deltaTime)
177	                            _stuckTimer += deltaTime;
178	                        else
179	                            _stuckTimer = 0f;
180	
181	                        if (_stuckTimer >= _stuckSeconds)
182	                        {
183	                            _stuckTimer = 0f;
184	                            GoToNextPoint();
185	                        }
186	
187	                        _previousDistance = distance;
188	                        planar = direction * (_speed * deltaTime);
189	                    }
190	                }
191	            }
192	            else
193	            {
194	                _speed = Mathf.MoveTowards(_speed, 0f, _acceleration * deltaTime);
195	            }
196	
197	            // Гравитация применяется один раз за кадр, поверх шага по земле.
198	            planar.y = Vertical(deltaTime);
199	            _controller.Move(planar);
200	            UpdateAnimator(deltaTime);
201	        }
202	
203	        private void GoToNextPoint()
204	        {
205	            _index = (_index + 1) % _targets.Length;
206	            _previousDistance = float.MaxValue;
207	            _stuckTimer = 0f;
208	        }
209	
210	        /// <summary>Доворот к собеседнику по горизонтали: наклон камеры не задирает корпус.</summary>
211	        private void FaceConversationFocus(float deltaTime)
212	        {
213	            if (_conversationFocus == null)
214	                return;
215	
216	            var offset = _conversationFocus.position - transform.position;
217	            offset.y = 0f;
218	            if (offset.sqrMagnitude < 0.0004f)
219	                return;
220	
221	            var rotation = Quaternion.LookRotation(offset.normalized, Vector3.up);
222	            transform.rotation = Quaternion.RotateTowards(
223	                transform.rotation, rotation, _turnSpeed * deltaTime);
224	        }
225	
226	        private float Vertical(float deltaTime)
227	        {
228	            if (_controller.isGrounded && _verticalVelocity < 0f)
229	                _verticalVelocity = -2f;
230	            _verticalVelocity += Physics.gravity.y * deltaTime;
231	            return _verticalVelocity * deltaTime;
232	        }
233	
234	        private void UpdateAnimator(float deltaTime)
235	        {
236	            var moving = _speed > 0.08f;
237	            _animator.SetBool(MovingId, moving);
238	
239	            var target = moving
240	                ? Mathf.Clamp(_speed / Mathf.Max(_walkClipSpeed, 0.01f), 0.2f, 2f)
241	                : 1f;
242	            _animatorSpeed = Mathf.MoveTowards(_animatorSpeed, target, 4f * deltaTime);
243	            _animator.speed = _animatorSpeed;
244	        }
245	    }
246	}
