  "content": "<div id=\"xp-bar-sketches\" class=\"xpv\">\n  <style>\n    #xp-bar-sketches {\n      --cyan: #4de6ff;\n      --cyan-bright: #b9f8ff;\n      --cyan-soft: rgba(77, 230, 255, .42);\n      --ink: #d8f4fb;\n      --dim: #5f8292;\n      --line: rgba(77, 230, 255, .22);\n      --bg0: #050b11;\n      --bg1: #0a1720;\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 1060px;\n      margin: 0 auto;\n      color: var(--ink);\n      font-family: var(--font-sans, \"Segoe UI\", system-ui, sans-serif);\n    }\n\n    #xp-bar-sketches *,\n    #xp-bar-sketches *::before,\n    #xp-bar-sketches *::after {\n      box-sizing: border-box;\n    }\n\n    #xp-bar-sketches .xpv-shell {\n      position: relative;\n      overflow: hidden;\n      padding: 22px 24px 18px;\n      border: 1px solid rgba(77, 230, 255, .14);\n      border-radius: 18px;\n      background:\n        radial-gradient(ellipse at 50% 118%, rgba(77, 230, 255, .14), transparent 62%),\n        linear-gradient(180deg, var(--bg1), var(--bg0));\n    }\n\n    #xp-bar-sketches .xpv-shell::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      opacity: .28;\n      background:\n        repeating-linear-gradient(90deg, transparent 0 79px, rgba(77, 230, 255, .08) 79px 80px),\n        repeating-linear-gradient(0deg, transparent 0 39px, rgba(77, 230, 255, .055) 39px 40px);\n      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .7), transparent 85%);\n    }\n\n    #xp-bar-sketches .xpv-head {\n      position: relative;\n      z-index: 1;\n      display: flex;\n      flex-wrap: wrap;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 8px 18px;\n      padding-bottom: 14px;\n    }\n\n    #xp-bar-sketches .xpv-title {\n      margin: 0;\n      color: var(--cyan-bright);\n      font-size: 13px;\n      font-weight: 500;\n      letter-spacing: .18em;\n      text-transform: uppercase;\n      text-shadow: 0 0 18px rgba(77, 230, 255, .38);\n    }\n\n    #xp-bar-sketches .xpv-sub {\n      color: var(--dim);\n      font-size: 12px;\n      letter-spacing: .08em;\n    }\n\n    #xp-bar-sketches .xpv-row {\n      position: relative;\n      z-index: 1;\n      display: grid;\n      grid-template-columns: 54px minmax(0, 1fr);\n      gap: 12px 18px;\n      padding: 17px 0 18px;\n      border-top: 1px solid rgba(77, 230, 255, .10);\n    }\n\n    #xp-bar-sketches .xpv-meta {\n      padding-top: 2px;\n    }\n\n    #xp-bar-sketches .xpv-tag {\n      color: var(--cyan);\n      font-size: 11px;\n      font-weight: 500;\n      letter-spacing: .16em;\n    }\n\n    #xp-bar-sketches .xpv-name {\n      margin-top: 4px;\n      color: var(--ink);\n      font-size: 12px;\n      line-height: 1.25;\n    }\n\n    #xp-bar-sketches .xpv-desc {\n      margin-top: 4px;\n      color: var(--dim);\n      font-size: 11px;\n      line-height: 1.35;\n    }\n\n    #xp-bar-sketches .xpv-stage {\n      min-width: 0;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n\n    #xp-bar-sketches .xpv-line {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n      min-width: 0;\n    }\n\n    #xp-bar-sketches .xpv-level {\n      flex: 0 0 auto;\n      width: 58px;\n      color: var(--cyan-bright);\n      font-family: var(--font-code, \"Cascadia Mono\", monospace);\n      font-size: 12px;\n      letter-spacing: .08em;\n      text-align: center;\n      text-shadow: 0 0 14px rgba(77, 230, 255, .34);\n    }\n\n    #xp-bar-sketches .xpv-level.next {\n      color: var(--dim);\n      text-shadow: none;\n    }\n\n    #xp-bar-sketches .xpv-bar {\n      position: relative;\n      flex: 1 1 auto;\n      min-width: 0;\n    }\n\n    #xp-bar-sketches .xpv-text {\n      position: absolute;\n      inset: 0;\n      z-index: 3;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: var(--cyan-bright);\n      font-family: var(--font-code, \"Cascadia Mono\", monospace);\n      font-size: 12px;\n      font-weight: 500;\n      letter-spacing: .07em;\n      white-space: nowrap;\n      text-shadow: 0 0 10px rgba(0, 0, 0, .92), 0 0 20px rgba(77, 230, 255, .35);\n    }\n\n    #xp-bar-sketches .xpv-note {\n      color: var(--dim);\n      font-size: 11px;\n      letter-spacing: .03em;\n    }\n\n    /* A — continuous beam */\n    #xp-bar-sketches .xpv-a .xpv-bar {\n      height: 36px;\n      background: linear-gradient(90deg, rgba(77, 230, 255, .055), rgba(77, 230, 255, .012));\n      border-top: 1px solid rgba(77, 230, 255, .34);\n      border-bottom: 1px solid rgba(77, 230, 255, .20);\n    }\n\n    #xp-bar-sketches .xpv-a .xpv-bar::before {\n      content: \"\";\n      position: absolute;\n      left: 0;\n      top: 0;\n      bottom: 0;\n      width: 25%;\n      background: linear-gradient(90deg, rgba(77, 230, 255, .12), rgba(77, 230, 255, .58));\n      box-shadow: 0 0 18px rgba(77, 230, 255, .42), 0 0 42px rgba(77, 230, 255, .18);\n    }\n\n    #xp-bar-sketches .xpv-a .xpv-bar::after {\n      content: \"\";\n      position: absolute;\n      left: 25%;\n      top: -4px;\n      bottom: -4px;\n      width: 1px;\n      background: var(--cyan-bright);\n      box-shadow: 0 0 12px var(--cyan);\n    }\n\n    /* B — segmented ticks */\n    #xp-bar-sketches .xpv-b .xpv-bar {\n      height: 34px;\n      display: grid;\n      grid-template-columns: repeat(24, minmax(2px, 1fr));\n      gap: 3px;\n      padding: 7px 0;\n    }\n\n    #xp-bar-sketches .xpv-b .xpv-seg {\n      background: rgba(77, 230, 255, .10);\n      border-top: 1px solid rgba(77, 230, 255, .18);\n      border-bottom: 1px solid rgba(77, 230, 255, .10);\n    }\n\n    #xp-bar-sketches .xpv-b .xpv-seg.on {\n      background: linear-gradient(180deg, rgba(185, 248, 255, .92), rgba(77, 230, 255, .48));\n      border-color: var(--cyan);\n      box-shadow: 0 0 10px rgba(77, 230, 255, .48);\n    }\n\n    /* C — double hairline + scan head */\n    #xp-bar-sketches .xpv-c .xpv-bar {\n      height: