15	    public sealed class DialogueContentTests
16	    {
17	        private const string Folder = "Assets/_Project/Content/Data/Dialogues";
18	
19	        private static DialogueAsset[] LoadAll()
20	        {
21	            return AssetDatabase.FindAssets("t:DialogueAsset", new[] { Folder })
22	                .Select(AssetDatabase.GUIDToAssetPath)
23	                .OrderBy(path => path)
24	                .Select(AssetDatabase.LoadAssetAtPath<DialogueAsset>)
25	                .Where(asset => asset != null)
26	                .ToArray();
27	        }
28	
29	        [Test]
30	        public void Folder_ContainsFourStarterDialogues()
31	        {
32	            Assert.AreEqual(4, LoadAll().Length, "Ожидаются диалоги для четырёх роботов сцены Game.");
33	        }
34	
35	        [Test]
36	        public void AllDialogues_AreValid()
37	        {
38	            foreach (var asset in LoadAll())
39	            {
40	                var errors = new List<string>();
41	                asset.CollectProblems(errors, null);
42	                Assert.IsEmpty(errors, $"{asset.name}: {string.Join("; ", errors)}");
43	            }
44	        }
45	
46	        [Test]
47	        public void AllDialogues_StartAtExistingNode()
48	        {
49	            foreach (var asset in LoadAll())
50	                Assert.IsNotNull(asset.StartNode, $"{asset.name}: стартовый узел не найден.");
51	        }
52	
53	        [Test]
54	        public void AllDialogues_BranchAndReachAnEnd()
55	        {
56	            foreach (var asset in LoadAll())
57	            {
58	                var branch = asset.Nodes.Any(node => node != null && node.Choices.Count >= 2);
59	                Assert.IsTrue(branch, $"{asset.name}: нет узла с ветвлением.");
60	
61	                var endings = asset.Nodes.Count(Ends);
62	                Assert.GreaterOrEqual(endings, 2, $"{asset.name}: нужно минимум две концовки.");
63	            }
64	        }
65	
66	        [Test]
67	        public void AllDialogues_RespectChoiceLimit()
68	        {
69	            foreach (var asset in LoadAll())
70	            {
71	                foreach (var node in asset.Nodes)
72	                {
73	                    if (node == null)
74	                        continue;
75	
76	                    Assert.LessOrEqual(
77	                        node.Choices.Count, DialogueAsset.MaxChoices,
78	                        $"{asset.name}/{node.Id}: вариантов больше, чем помещается в панель.");
79	                }
80	            }
81	        }
82	
83	        [Test]
84	        public void AllLines_FitWarningLimit()
85	        {
86	            foreach (var asset in LoadAll())
87	            {
88	                foreach (var node in asset.Nodes)
89	                {
90	                    if (node == null)
91	                        continue;
92	
93	                    Assert.LessOrEqual(
94	                        node.Line.Length, DialogueAsset.LongLineWarning,
95	                        $"{asset.name}/{node.Id}: реплика не помещается в панель.");
96	                }
97	            }
98	        }
99	
100	        [Test]
101	        public void AllLines_AreRussian()
102	        {
103	            foreach (var asset in LoadAll())
104	            {
105	                foreach (var node in asset.Nodes)
106	                {
107	                    if (node == null)
108	                        continue;
109	
110	                    Assert.IsTrue(
111	                        HasCyrillic(node.Line),
112	                        $"{asset.name}/{node.Id}: реплика не на русском.");
113	                }
114	            }
115	        }
116	
117	        private static bool Ends(DialogueNode node)
118	        {
119	            if (node == null)
120	                return false;
121	            if (node.IsTerminal)
122	                return true;
123	            return node.Choices.Any(choice => string.IsNullOrWhiteSpace(choice.NextId));
124	        }
125	
126	        private static bool HasCyrillic(string text)
127	        {
128	            if (string.IsNullOrEmpty(text))
129	                return false;
130	
131	            foreach (var symbol in text)
132	            {
133	                if (symbol >= '\u0400' && symbol <= '\u04FF')
134	                    return true;
135	            }
136	
137	            return false;
138	        }
