     {\n                _root.SetActive(false);\n                return;\n            }\n\n            _root.SetActive(true);\n\n            var level = _experience.Level;\n            var next = level + 1;\n            var required = _experience.ExperienceToNextLevel;\n            var experience = _experience.Experience;\n            var percent = Mathf.RoundToInt(_experience.Progress01 * 100f);\n\n            if (level != _shownLevel)\n            {\n                _level.text = $\"УР. {level}\";\n                _shownLevel = level;\n            }\n\n            if (next != _shownNextLevel)\n            {\n                _nextLevel.text = $\"УР. {next}\";\n                _shownNextLevel = next;\n            }\n\n            if (experience != _shownExperience || required != _shownRequired)\n            {\n                _progress.text = $\"{experience} / {required}  ({percent}%)\";\n                _shownExperience = experience;\n                _shownRequired = required;\n            }\n\n            _fill.rectTransform.anchorMax = new Vector2(_experience.Progress01, 1f);\n        }\n\n        private void OnDestroy()\n        {\n            if (_root != null)\n                Destroy(_root);\n        }\n\n        private void Build()\n        {\n            _root = new GameObject(\"Experience Canvas\", typeof(RectTransform));\n            _root.transform.SetParent(transform, false);\n\n            var canvas = _root.AddComponent<Canvas>();\n            canvas.renderMode = RenderMode.ScreenSpaceOverlay;\n            canvas.sortingOrder = 15;\n\n            var scaler = _root.AddComponent<CanvasScaler>();\n            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;\n            scaler.referenceResolution = new Vector2(1920f, 1080f);\n            scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;\n            scaler.matchWidthOrHeight = 0.5f;\n\n            var parent = (RectTransform)_root.transform;\n\n            var plate = NewImage(parent, \"Plate\", _plate);\n            var plateRect = plate.rectTransform;\n            plateRect.anchorMin = new Vector2(0.5f, 0f);\n            plateRect.anchorMax = new Vector2(0.5f, 0f);\n            plateRect.pivot = new Vector2(0.5f, 0f);\n            plateRect.anchoredPosition = new Vector2(0f, 16f);\n            plateRect.sizeDelta = new Vector2(920f, 64f);\n\n            var edge = NewImage(plateRect, \"TopEdge\", _accent);\n            var edgeRect = edge.rectTransform;\n            edgeRect.anchorMin = new Vector2(0f, 1f);\n            edgeRect.anchorMax = new Vector2(1f, 1f);\n            edgeRect.pivot = new Vector2(0.5f, 1f);\n            edgeRect.sizeDelta = new Vector2(0f, 2f);\n            edgeRect.anchoredPosition = Vector2.zero;\n\n            _level = NewText(plateRect, \"Level\", \"УР. 1\", 21f, _accent,\n                new Vector2(0f, 0.5f), new Vector2(22f, 0f), new Vector2(130f, 32f),\n                TextAlignmentOptions.MidlineLeft, 4f);\n\n            _nextLevel = NewText(plateRect, \"NextLevel\", \"УР. 2\", 21f, _dim,\n                new Vector2(1f, 0.5f), new Vector2(-22f, 0f), new Vector2(130f, 32f),\n                TextAlignmentOptions.MidlineRight, 4f);\n\n            var track = NewImage(plateRect, \"Track\", _track);\n            var trackRect = track.rectTransform;\n            trackRect.anchorMin = new Vector2(0f, 0.5f);\n            trackRect.anchorMax = new Vector2(1f, 0.5f);\n            trackRect.pivot = new Vector2(0.5f, 0.5f);\n            trackRect.offsetMin = new Vector2(170f, -14f);\n            trackRect.offsetMax = new Vector2(-170f, 14f);\n\n            _fill = NewImage(trackRect, \"Fill\", _accent);\n            var fillRect = _fill.rectTransform;\n            fillRect.anchorMin = new Vector2(0f, 0f);\n            fillRect.anchorMax = new Vector2(1f, 1f);\n            fillRect.pivot = new Vector2(0f, 0.5f);\n            fillRect.sizeDelta = Vector2.zero;\n            fillRect.anchoredPosition = Vector2.zero;\n\n            var captionPlate = NewImage(trackRect, \"CaptionPlate\", _captionPlate);\n            var captionRect = captionPlate.rectTransform;\n            captionRect.anchorMin = new Vector2(0.5f, 0.5f);\n            captionRect.anchorMax = new Vector2(0.5f, 0.5f);\n            captionRect.pivot = new Vector2(0.5f, 0.5f);\n            captionRect.sizeDelta = new Vector2(300f, 24f);\n            captionRect.anchoredPosition = Vector2.zero;\n\n            _progress = NewText(captionRect, \"Progress\", string.Empty, 17f, _text,\n                new Vector2(0.5f, 0.5f), Vector2.zero, new Vector2(280f, 22f),\n                TextAlignmentOptions.Center, 2f);\n\n            _root.SetActive(false);\n        }\n\n        private TextMeshProUGUI NewText(\n            RectTransform parent, string name, string content, float size, Color color,\n            Vector2 anchor, Vector2 position, Vector2 boxSize,\n            TextAlignmentOptions alignment, float spacing)\n        {\n            var go = new GameObject(name, typeof(RectTransform));\n            go.transform.SetParent(parent, false);\n\n            var rect = (RectTransform)go.transform;\n            rect.anchorMin = anchor;\n            rect.anchorMax = anchor;\n            rect.pivot = new Vector2(\n                anchor.x <= 0f ? 0f : anchor.x >= 1f ? 1f : 0.5f,\n                anchor.y <= 0f ? 0f : anchor.y >= 1f ? 1f : 0.5f);\n            rect.anchoredPosition = position;\n            rect.sizeDelta = boxSize;\n\n            var text = go.AddComponent<TextMeshProUGUI>();\n            text.font = _font != null ? _font : TMP_Settings.defaultFontAsset;\n            text.text = content;\n            text.fontSize = size;\n            text.color = color;\n            text.alignment = alignment;\n            text.characterSpacing = spacing;\n            text.textWrappingMode = TextWrappingModes.NoWrap;\n            text.raycastTarget = false;\n            return text;\n        }\n\n        private static Image NewImage(Transform parent, string name, Color color)\n        {\n            var go = new GameObject(name, typeof(RectTransform));\n            go.transform.SetParent(parent, false);\n            var image = go.AddComponent<Image>();\n            image.color = color;\n            image.raycastTarget = false;\n            return image;\n        }\n    }\n}\n"
