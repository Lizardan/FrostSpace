        public int ObjectiveIndex => _objectiveIndex;
        public int Progress => _progress;
        public int ObjectiveCount => _quest != null ? _quest.Objectives.Count : 0;
        public QuestObjective CurrentObjective
        {
            get
            {
                if (State != QuestState.Active || _quest == null) return null;
                var objectives = _quest.Objectives;
                return _objectiveIndex >= 0 && _objectiveIndex < objectives.Count
                    ? objectives[_objectiveIndex]
                    : null;
            }
        }
        public bool IsActive => State == QuestState.Active;
        public bool IsCompleted => State == QuestState.Completed;

        public bool Activate()
        {
            if (State != QuestState.Inactive || ObjectiveCount == 0) return false;
            State = QuestState.Active;
            _objectiveIndex = 0;
            _progress = 0;
            return true;
        }

        public bool Apply(QuestEvent questEvent)
        {
            if (State != QuestState.Active || questEvent.Amount <= 0) return false;
            var objective = CurrentObjective;
            if (objective == null) return false;
            if (objective.Kind != questEvent.Kind) return false;
            if (!string.Equals(objective.TargetId, questEvent.TargetId, StringComparison.Ordinal)) return false;

            var required = Mathf.Max(1, objective.Required);
            _progress = Mathf.Min(required, _progress + questEvent.Amount);
            if (_progress < required) return true;

            _objectiveIndex++;
            _progress = 0;
            if (_objectiveIndex >= ObjectiveCount)
            {
                _objectiveIndex = ObjectiveCount;
                State = QuestState.Completed;
            }
            return true;
        }

        public QuestSnapshot Snapshot() => new(State, _objectiveIndex, _progress);
    }
}
```
Need `using System;` for StringComparison. `using System.Collections.Generic` not needed. Use `Mathf.Min`/`Max` from UnityEngine. Could use `System.Math` but Unity style uses Mathf.
- When quest completes, `_objectiveIndex = ObjectiveCount` (e.g., 3), so CurrentObjective null due to State Completed. Fine.
- `Apply` with amount that overshoots: progress set required; completes. Good.
- If required invalid <=0, clamped to 1.
- Out-of-order events ignored.
- After completion, State Completed, Apply returns false.
- If targetId null vs empty: `string.Equals(null, "")` false; exact. Validation ensures nonempty. Good.
- `Activate` on quest with null objectives count 0 → false. If quest has objectives but first is null, Activate returns true; Apply CurrentObjective null; quest stuck. Validation catches. Could guard `CurrentObjective != null` in Activate; if first null, false. Add:
  ```
  var first = ObjectiveCount > 0 ? _quest.Objectives[0] : null;
  if (first == null) return false;
  ```
  Good.

QuestAsset:
```
using System;
using System.Collections.Generic;
using UnityEngine;

namespace...
[CreateAssetMenu(fileName="Quest", menuName="FrostSpace/Quest", order=0)]
public sealed class QuestAsset : ScriptableObject
{
    [SerializeField] private string _questId;
    [SerializeField] private string _title;
    [SerializeField] private List<QuestObjective> _objectives = new();

    public string QuestId => _questId;
    public string Title => _title;
    public IReadOnlyList<QuestObjective> Objectives => _objectives;

    public QuestLog CreateLog() => new(this);

    public void SetIdentity(string questId, string title) { _questId = questId; _title = title; }
    public void AddObjective(QuestObjective objective)
    {
        if (objective != null) _objectives.Add(objective);
    }

    public void CollectProblems(List<string> errors, List<string> warnings)
    {
        errors ??= new List<string>();
        warnings ??= new List<string>();
        if (string.IsNullOrWhiteSpace(_questId)) errors.Add("Пустой questId.");
        if (_objectives.Count == 0) { errors.Add("В квесте нет ни одной цели."); return; }
        var ids = new HashSet<string>(StringComparer.Ordinal);
        for (var i = 0; i < _objectives.Count; i++)
        {
            var objective = _objectives[i];
            if (objective == null) { errors.Add($"Цель #{i+1}: пустая запись списка."); continue; }
            if (string.IsNullOrWhiteSpace(objective.Id)) errors.Add($"Цель #{i+1}: пустой id.");
            else if (!ids.Add(objective.Id)) errors.Add($"Цель {objective.Id}: id повторяется.");
            if (string.IsNullOrWhiteSpace(objective.Text)) errors.Add($"Цель {Label(objective, i)}: пустой текст.");
            if (string.IsNullOrWhiteSpace(objective.TargetId)) errors.Add($"Цель {Label(...)}: пустой targetId.");
            if (objective.Required <= 0) errors.Add($"Цель {Label(...)}: required должен быть > 0.");
        }
    }
    private static string Label(...)...
    private void OnValidate()
    {
        if ((hideFlags & HideFlags.DontSave) != 0) return;
        if (string.IsNullOrWhiteSpace(_questId) && _objectives.Count == 0) return;
        var errors = new List<string>();
        CollectProblems(errors, null);
        for (...) Debug.LogError($"Квест «{name}»: {errors[i]}", this);
    }
}
```
- `warnings` unused; passing null works. Maybe no need warnings param? Follow DialogueAsset signature. Could simply `CollectProblems(List<string> errors)` but ADR says validation; tests can use errors. To match style, include both. Fine.
- `StringComparer.Ordinal` needs `System`.
- `hideFlags` is UnityEngine.Object property.
- OnValidate in runtime assembly is fine.
- Note: `_objectives` list may be null after deserialization? Unity initializes to empty; but safe `_objectives ??= new List<...>()` in OnValidate? Not necessary. Could use `if (_objectives == null) _objectives = new();` but Unity serializes. Skip.

QuestDirector:
```
using System;
using FrostSpace.Features.Carry;
using FrostSpace.Features.Dialogue;
using UnityEngine;

namespace FrostSpace.Features.Quest
{
    [DisallowMultipleComponent]
    [DefaultExecutionOrder(-5)]
    public sealed class QuestDirector : MonoBehaviour
    {
        [SerializeField] private QuestAsset _quest;
        [SerializeField] private DialogueController _dialogue;
        [SerializeField] private CarrySlot[] _slots = Array.Empty<CarrySlot>();

        private QuestLog _log;

        public QuestLog Log => _log;
        public QuestAsset Quest => _quest;

        private void Awake()
        {
            _log = _quest != null ? _quest.CreateLog() : null;
            if (_quest == null) Debug.LogError("QuestDirector: не назначен QuestAsset", this);
        }

        private void OnEnable()
        {
            if (_dialogue != null) _dialogue.ActionInvoked += OnDialogueAction;
            if (_slots == null) return;
            for (...) if (_slots[i] != null) _slots[i].Placed += OnPlaced;
        }

        private void OnDisable()
        {
            if (_dialogue != null) _dialogue.ActionInvoked -= OnDialogueAction;
            if (_slots == null) return;
            for (...) if (_slots[i] != null) _slots[i].Placed -= OnPlaced;
        }

        private void OnDialogueAction(DialogueAction action, string questId)
        {
            if (_log == null || action == DialogueAction.None) return;
            if (!string.IsNullOrWhiteSpace(questId) &&
                !string.Equals(questId, _quest.QuestId, StringComparison.Ordinal)) return;

            switch (action)
            {
                case DialogueAction.AcceptQuest:
                    if (!_log.Activate()) return;
                    CompleteTalkObjective();
                    break;
                case DialogueAction.CompleteQuest:
                    CompleteTalkObjective();
                    break;
            }
        }

        private void CompleteTalkObjective()
        {
            var objective = _log?.CurrentObjective;
            if (objective == null || objective.Kind != QuestObjectiveKind.Talk) return;
            _log.Apply(new QuestEvent(QuestObjectiveKind.Talk, objective.TargetId, 1));
        }

        private void OnPlaced(CarrySlot slot, Carryable item)
        {
            if (_log == null || item == null) return;
            _log.Apply(new QuestEvent(QuestObjectiveKind.Deliver, item.ItemType, 1));
        }
    }
}
```
