1	using UnityEngine;
2	
3	namespace FrostSpace.Features.Carry
4	{
5	    /// <summary>
6	    /// Предмет, который можно взять в руки и поставить в слот.
7	    ///
8	    /// Дом предмета запоминается в <see cref="Awake"/>: брошенный предмет
9	    /// возвращается туда, чтобы квест нельзя было сломать, утащив аккумулятор
10	    /// в угол. Коллайдеры выключаются, пока предмет в руках или в слоте —
11	    /// иначе игрок толкает груз собственным капсульным коллайдером.
12	    /// </summary>
13	    [DisallowMultipleComponent]
14	    public sealed class Carryable : MonoBehaviour
15	    {
16	        [Tooltip("Тип предмета: слот принимает только совпадающий тип")]
17	        [SerializeField] private string _itemType = "battery";
18	
19	        [Tooltip("Квест, без которого предмет нельзя взять; пусто — можно всегда")]
20	        [SerializeField] private string _requiredQuestId = string.Empty;
21	
22	        private Vector3 _homePosition;
23	        private Quaternion _homeRotation;
24	        private Collider[] _colliders;
25	
26	        /// <summary>Тип предмета для сверки со слотом.</summary>
27	        public string ItemType => _itemType;
28	
29	        /// <summary>Квест, который должен быть взят; пусто — предмет доступен сразу.</summary>
30	        public string RequiredQuestId => _requiredQuestId;
31	
32	        /// <summary>Предмет сейчас в руках.</summary>
33	        public bool IsCarried { get; private set; }
34	
35	        /// <summary>Предмет стоит в слоте.</summary>
36	        public bool IsPlaced { get; private set; }
37	
38	        private void Awake()
39	        {
40	            _homePosition = transform.position;
41	            _homeRotation = transform.rotation;
42	            _colliders = GetComponentsInChildren<Collider>(true);
43	        }
44	
45	        /// <summary>Взять в руки: предмет становится ребёнком якоря.</summary>
46	        public void Take(Transform anchor)
47	        {
48	            if (anchor == null || IsCarried || IsPlaced)
49	            {
50	                return;
51	            }
52	
53	            IsCarried = true;
54	            SetColliders(false);
55	            transform.SetParent(anchor, true);
56	            transform.localPosition = Vector3.zero;
57	            transform.localRotation = Quaternion.identity;
58	        }
59	
60	        /// <summary>Поставить в слот: предмет фиксируется на якоре слота.</summary>
61	        public void Place(Transform anchor)
62	        {
63	            if (anchor == null)
64	            {
65	                return;
66	            }
67	
68	            IsCarried = false;
69	            IsPlaced = true;
70	            transform.SetParent(anchor, true);
71	            transform.localPosition = Vector3.zero;
72	            transform.localRotation = Quaternion.identity;
73	            SetColliders(false);
74	        }
75	
76	        /// <summary>Бросить: предмет возвращается на исходное место.</summary>
77	        public void Drop()
78	        {
79	            IsCarried = false;
80	            IsPlaced = false;
81	            transform.SetParent(null, true);
82	            transform.position = _homePosition;
83	            transform.rotation = _homeRotation;
84	            SetColliders(true);
85	        }
86	
87	        private void SetColliders(bool enabled)
88	        {
89	            if (_colliders == null)
90	            {
91	                return;
92	            }
93	
94	            for (var i = 0; i < _colliders.Length; i++)
95	            {
96	                if (_colliders[i] != null)
97	                {
98	                    _colliders[i].enabled = enabled;
99	                }
100	            }
101	        }
102	    }
103	}
