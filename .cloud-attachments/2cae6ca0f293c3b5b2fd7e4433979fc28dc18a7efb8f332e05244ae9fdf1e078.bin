336	        /// </summary>
337	        private Switch BuildSwitch(
338	            Transform parent, string name, string label, float y, UnityEngine.Events.UnityAction action)
339	        {
340	            var row = new GameObject(name, typeof(RectTransform));
341	            row.transform.SetParent(parent, false);
342	            var rowRect = (RectTransform)row.transform;
343	            rowRect.anchorMin = new Vector2(0f, 1f);
344	            rowRect.anchorMax = new Vector2(1f, 1f);
345	            rowRect.pivot = new Vector2(0.5f, 1f);
346	            rowRect.offsetMin = new Vector2(48f, 0f);
347	            rowRect.offsetMax = new Vector2(-48f, 0f);
348	            rowRect.sizeDelta = new Vector2(rowRect.sizeDelta.x, 56f);
349	            rowRect.anchoredPosition = new Vector2(0f, y);
350	
351	            var hit = row.AddComponent<Image>();
352	            hit.color = new Color(_buttonIdle.r, _buttonIdle.g, _buttonIdle.b, 0.55f);
353	
354	            var button = row.AddComponent<Button>();
355	            button.targetGraphic = hit;
356	            button.transition = Selectable.Transition.ColorTint;
357	            var colors = button.colors;
358	            colors.normalColor = new Color(_buttonIdle.r, _buttonIdle.g, _buttonIdle.b, 0.55f);
359	            colors.highlightedColor = _buttonHover;
360	            colors.pressedColor = _accent;
361	            colors.selectedColor = _buttonHover;
362	            colors.fadeDuration = 0.12f;
363	            button.colors = colors;
364	            button.onClick.AddListener(action);
365	
366	            NewText(row.transform, "Label", label, 20f, _text, TextAlignmentOptions.Left,
367	                new Vector2(0f, 0.5f), new Vector2(20f, 0f), new Vector2(420f, 28f), 12f);
368	
369	            // Тумблер: дорожка, ползунок и подпись состояния справа.
370	            var track = NewImage(row.transform, "Track", new Color(_dim.r, _dim.g, _dim.b, 0.35f));
371	            var trackRect = track.rectTransform;
372	            trackRect.anchorMin = new Vector2(1f, 0.5f);
373	            trackRect.anchorMax = new Vector2(1f, 0.5f);
374	            trackRect.pivot = new Vector2(1f, 0.5f);
375	            trackRect.sizeDelta = new Vector2(72f, 26f);
376	            trackRect.anchoredPosition = new Vector2(-96f, 0f);
377	
378	            var knob = NewImage(track.transform, "Knob", _text);
379	            var knobRect = knob.rectTransform;
380	            knobRect.anchorMin = new Vector2(1f, 0.5f);
381	            knobRect.anchorMax = new Vector2(1f, 0.5f);
382	            knobRect.pivot = new Vector2(0.5f, 0.5f);
383	            knobRect.sizeDelta = new Vector2(20f, 20f);
384	            knobRect.anchoredPosition = new Vector2(-16f, 0f);
385	
386	            var state = NewText(row.transform, "State", "ON", 18f, _accent, TextAlignmentOptions.Right,
387	                new Vector2(1f, 0.5f), new Vector2(-20f, 0f), new Vector2(60f, 24f), 10f);
388	
389	            return new Switch { Track = track, Knob = knobRect, State = state, Value = true };
390	        }
