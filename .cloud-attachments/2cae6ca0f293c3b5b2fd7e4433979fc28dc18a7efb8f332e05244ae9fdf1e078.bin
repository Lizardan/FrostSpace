178	        {
179	            if (EventSystem.current != null)
180	                return;
181	
182	            var go = new GameObject("EventSystem", typeof(EventSystem));
183	            var module = go.AddComponent<InputSystemUIInputModule>();
184	            module.AssignDefaultActions();
185	        }
186	
