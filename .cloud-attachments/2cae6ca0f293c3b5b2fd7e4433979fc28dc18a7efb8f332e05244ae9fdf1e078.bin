245	        private void Awake()
246	        {
247	            if (_view == null)
248	                _view = Camera.main;
249	            if (_rig == null)
250	                _rig = FindAnyObjectByType<PlayerCameraRig>();
251	            if (_player == null)
252	                _player = _rig != null && _rig.Target != null ? _rig.Target : transform;
253	            if (_shader == null)
254	                _shader = Shader.Find("FrostSpace/VFX/ScanHighlight");
255	
256	            if (_shader == null)
257	            {
258	                Debug.LogError("[ObjectScanner] не найден шейдер FrostSpace/VFX/ScanHighlight", this);
259	                enabled = false;
260	            }
261	        }
