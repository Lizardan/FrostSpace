59	        private const float MarkerWidth = 4f;
60	        private const float PanelWidth = 1180f;
61	        private const float PanelHeight = 720f;
62	
63	        private sealed class Switch
64	        {
65	            public Image Track;
66	            public RectTransform Knob;
67	            public TextMeshProUGUI State;
68	            public bool Value;
69	
70	            public void Apply(Color accent, Color dim)
71	            {
72	                var on = Value;
73	
74	                if (Track != null)
75	                    Track.color = on
76	                        ? new Color(accent.r, accent.g, accent.b, 0.55f)
77	                        : new Color(dim.r, dim.g, dim.b, 0.35f);
78	
79	                if (Knob != null)
80	                {
81	                    Knob.anchorMin = new Vector2(on ? 1f : 0f, 0.5f);
82	                    Knob.anchorMax = new Vector2(on ? 1f : 0f, 0.5f);
83	                    Knob.anchoredPosition = new Vector2(on ? -16f : 16f, 0f);
84	                }
85	
86	                if (State != null)
87	                {
88	                    State.text = on ? "ВКЛ" : "ВЫКЛ";
89	                    State.color = on ? accent : dim;
90	                }
91	            }
92	        }
