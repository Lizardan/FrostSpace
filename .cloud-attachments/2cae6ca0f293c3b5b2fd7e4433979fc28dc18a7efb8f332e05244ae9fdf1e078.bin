108	        /// Сценовый кадр на время выхода: риг не переписывает позу, поэтому
109	        /// случайное движение мыши не сбивает обзор и выход виден целиком.
110	        /// </summary>
111	        private void BeginShot()
112	        {
113	            if (_rig == null)
114	                return;
115	
116	            _rig.SetCinematic(true);
117	            var camera = _rig.ViewCamera;
118	            if (camera == null)
119	                return;
120	
121	            var direction = _shotTarget - _shotPosition;
122	            camera.transform.position = _shotPosition;
123	            if (direction.sqrMagnitude > 0.0001f)
124	                camera.transform.rotation = Quaternion.LookRotation(direction.normalized, Vector3.up);
125	        }
126	
127	        /// <summary>Возвращает обзор за спину игрока и снимает кинематографическую блокировку.</summary>
128	        private void EndShot()
129	        {
130	            if (_rig == null)
131	                return;
132	
133	            if (_player != null)
134	                _rig.SetViewYaw(_player.eulerAngles.y);
135	            _rig.SetCinematic(false);
136	        }
137	
138	        private void LoadCargo()
139	        {
140	            var count = Mathf.Min(_slots.Length, _cargo.Length);
141	            for (var i = 0; i < count; i++)
142	            {
143	                var slot = _slots[i];
144	                var item = _cargo[i];
145	                if (slot == null || item == null || !slot.IsFree)
146	                    continue;
147	
148	                item.Take(slot.transform);
149	                slot.TryPlace(item);
150	            }
151	        }
152	
153	        private static IEnumerator Move(Transform target, Vector3 from, Vector3 to, float seconds)
154	        {
155	            if (seconds <= 0f)
156	            {
157	                target.position = to;
158	                yield break;
159	            }
160	
161	            var elapsed = 0f;
162	            while (elapsed < seconds)
163	            {
164	                elapsed += Time.deltaTime;
165	                var t = Mathf.SmoothStep(0f, 1f, Mathf.Clamp01(elapsed / seconds));
166	                target.position = Vector3.LerpUnclamped(from, to, t);
167	                yield return null;
168	            }
169	
170	            target.position = to;
171	        }
172	
173	        private static IEnumerator Wait(float seconds)
174	        {
175	            if (seconds <= 0f)
176	                yield break;
177	
178	            var elapsed = 0f;
179	            while (elapsed < seconds)
180	            {
181	                elapsed += Time.deltaTime;
182	                yield return null;
183	            }
184	        }
185	    }
