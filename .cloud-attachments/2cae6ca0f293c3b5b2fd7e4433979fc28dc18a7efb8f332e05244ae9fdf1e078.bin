290	        private string BuildQuestText(bool detailed)
291	        {
292	            var log = _questDirector != null ? _questDirector.Log : null;
293	            if (log == null || log.Quest == null || log.State == QuestState.Inactive)
294	            {
295	                return detailed
296	                    ? "Журнал пуст.\n\nНовых заданий нет."
297	                    : "Активных заданий нет.\n\nПодойдите к R13 и нажмите E.";
298	            }
299	
300	            var quest = log.Quest;
301	            var builder = new StringBuilder();
302	
303	            if (detailed)
304	            {
305	                builder.Append("<size=30><b>").Append(quest.Title).AppendLine("</b></size>");
306	                if (!string.IsNullOrWhiteSpace(quest.Description))
307	                    builder.AppendLine(quest.Description);
308	                builder.AppendLine();
309	            }
310	            else
311	            {
312	                builder.Append("<size=26><b>").Append(quest.Title).AppendLine("</b></size>");
313	            }
314	
315	            if (log.IsCompleted)
316	            {
317	                for (var i = 0; i < quest.Objectives.Count; i++)
318	                {
319	                    var objective = quest.Objectives[i];
320	                    if (objective != null)
321	                        builder.Append("[x] ").AppendLine(objective.Text);
322	                }
323	
324	                builder.AppendLine();
325	                builder.Append("Задание выполнено.");
326	                return builder.ToString();
327	            }
328	
329	            var current = log.CurrentObjective;
330	            if (!detailed && current != null)
331	            {
332	                builder.AppendLine(current.Text);
333	                if (current.Required > 1)
334	                    builder.Append($"Прогресс: {log.Progress} / {current.Required}");
335	                return builder.ToString();
336	            }
337	
338	            for (var i = 0; i < quest.Objectives.Count; i++)
339	            {
340	                var objective = quest.Objectives[i];
341	                if (objective == null)
342	                    continue;
343	
344	                var marker = i < log.ObjectiveIndex
345	                    ? "[x]"
346	                    : i == log.ObjectiveIndex ? "[>]" : "[ ]";
347	                builder.Append(marker).Append(' ').Append(objective.Text);
348	
349	                if (i == log.ObjectiveIndex && objective.Required > 1)
350	                    builder.Append($"  {log.Progress}/{objective.Required}");
351	
352	                builder.AppendLine();
353	            }
354	
355	            return builder.ToString();
356	        }
