{
  "command": "python - <<'PY'\nimport json, sys\nsys.path.insert(0, 'Tools/Unity')\nfrom unity_bridge import Bridge\ncode = r'''\nvar questDir = \"Assets/_Project/Content/Data/Quests\";\nif (!AssetDatabase.IsValidFolder(questDir)) {\n    AssetDatabase.CreateFolder(\"Assets/_Project/Content/Data\", \"Quests\");\n}\n\nvar questPath = questDir + \"/TrainBatteries.asset\";\nvar quest = AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Quest.QuestAsset>(questPath);\nif (quest == null) {\n    quest = ScriptableObject.CreateInstance<FrostSpace.Features.Quest.QuestAsset>();\n    quest.SetIdentity(\"train_batteries\", \"BATTERIES\");\n    quest.AddObjective(new FrostSpace.Features.Quest.QuestObjective(\"q_talk_intro\", \"TALK TO R13\", FrostSpace.Features.Quest.QuestObjectiveKind.Talk, \"R13_Prospector\", 1));\n    quest.AddObjective(new FrostSpace.Features.Quest.QuestObjective(\"q_load\", \"LOAD BATTERIES\", FrostSpace.Features.Quest.QuestObjectiveKind.Deliver, \"battery\", 4));\n    quest.AddObjective(new FrostSpace.Features.Quest.QuestObjective(\"q_talk_done\", \"REPORT TO R13\", FrostSpace.Features.Quest.QuestObjectiveKind.Talk, \"R13_Prospector\", 1));\n    AssetDatabase.CreateAsset(quest, questPath);\n}\n\nvar introPath = \"Assets/_Project/Content/Data/Dialogues/TrainCompanion_Intro.asset\";\nvar intro = AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(introPath);\nif (intro == null) {\n    intro = ScriptableObject.CreateInstance<FrostSpace.Features.Dialogue.DialogueAsset>();\n    var n1 = intro.AddNode(\"Новый курьер? Корпус цел, память стёрта — как и должно быть. Я R13, старший по вагону.\");\n    var n2 = intro.AddNode(\"До северной станции трое суток. Груз — четыре аккумулятора. Без них станция замолчит.\");\n    var n3 = intro.AddNode(\"Перезагрузка после аварии. Ты выжил — это уже достаточно. Остальное соберёшь по дороге.\");\n    var n4 = intro.AddNode(\"Потому что ты умеешь держать груз, когда вокруг тишина. Других курьеров нет.\");\n    var n5 = intro.AddNode(\"Аккумуляторы вдоль правого борта. Тележка у двери. Возьми каждый и поставь в гнездо.\");\n    var n6 = intro.AddNode(\"Не успеем — станция остынет. Не потеряй тележку.\");\n    var n7 = intro.AddNode(\"Тогда депо останется без связи. Поэтому не спеши и не бросай груз.\");\n    n1.SetNextId(n2.Id);\n    n2.AddChoice(\"Что с моей памятью?\", n3.Id);\n    n2.AddChoice(\"Почему именно я?\", n4.Id);\n    n2.AddChoice(\"Ясно. За работу.\", n5.Id);\n    n3.SetNextId(n5.Id);\n    n4.SetNextId(n5.Id);\n    n5.AddChoice(\"Понял.\", n6.Id);\n    n5.AddChoice(\"Что будет, если не успеем?\", n7.Id);\n    n7.SetNextId(n6.Id);\n    n6.SetAction(FrostSpace.Features.Dialogue.DialogueAction.AcceptQuest, \"train_batteries\");\n    AssetDatabase.CreateAsset(intro, introPath);\n}\n\nvar donePath = \"Assets/_Project/Content/Data/Dialogues/TrainCompanion_Done.asset\";\nvar done = AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(donePath);\nif (done == null) {\n    done = ScriptableObject.CreateInstance<FrostSpace.Features.Dialogue.DialogueAsset>();\n    var d1 = done.AddNode(\"Все четыре на месте. Хорошая работа — тяжёлый груз, ровный шаг.\");\n    var d2 = done.AddNode(\"Дверь откроется на депо. Тележку не потеряй: она чужая.\");\n    var d3 = done.AddNode(\"R7 у навеса. Он знает дорогу дальше.\");\n    var d4 = done.AddNode(\"Иди. Я останусь с грузом.\");\n    d1.SetNextId(d2.Id);\n    d2.AddChoice(\"Кто встретит?\", d3.Id);\n    d2.AddChoice(\"Понял.\", d4.Id);\n    d3.SetNextId(d4.Id);\n    d4.SetAction(FrostSpace.Features.Dialogue.DialogueAction.CompleteQuest, \"train_batteries\");\n    AssetDatabase.CreateAsset(done, donePath);\n}\n\nAssetDatabase.SaveAssets();\nAssetDatabase.Refresh();\n\nvar questErrors = new System.Collections.Generic.List<string>();\nquest.CollectProblems(questErrors, null);\nvar introErrors = new System.Collections.Generic.List<string>();\nintro.CollectProblems(introErrors, null);\nvar doneErrors = new System.Collections.Generic.List<string>();\ndone.CollectProblems(doneErrors, null);\nreturn new {\n    quest = questPath,\n    questErrors = questErrors,\n    intro = introPath,\n    introNodes = intro.Nodes.Count,\n    introErrors = introErrors,\n    done = donePath,\n    doneNodes = done.Nodes.Count,\n    doneErrors = doneErrors\n};\n'''\nwith Bridge(port=6401) as b:\n    r = b.call('execute_code', {'action': 'execute', 'code': code})\n    print(json.dumps(r, ensure_ascii=False, indent=2)[:8000])\nPY",
  "description": "Create quest and R13 dialogue assets"
}
