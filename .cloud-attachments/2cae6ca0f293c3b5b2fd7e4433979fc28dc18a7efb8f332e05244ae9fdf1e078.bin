397	        private GameObject BuildMenuPanel(Transform parent)
398	        {
399	            var panel = NewPanel(parent, "PausePanel", new Vector2(PanelWidth, PanelHeight));
400	
401	            NewText(panel.transform, "Title", "ПАУЗА", 54f, _text, TextAlignmentOptions.Left,
402	                new Vector2(0f, 1f), new Vector2(52f, -42f), new Vector2(420f, 64f), 12f);
403	
404	            NewText(panel.transform, "Subtitle", "КОЛОНИЯ 07  /  СИСТЕМА НА ПАУЗЕ", 14f, _dim,
405	                TextAlignmentOptions.Left, new Vector2(0f, 1f), new Vector2(52f, -108f),
406	                new Vector2(400f, 26f), 4f);
407	
408	            NewButton(panel.transform, "Resume", "ПРОДОЛЖИТЬ", new Vector2(52f, -184f), Resume);
409	            NewButton(panel.transform, "Journal", "ЖУРНАЛ", new Vector2(52f, -184f - ButtonStep),
410	                OnJournalPressed);
411	            NewButton(panel.transform, "MainMenu", "В ГЛАВНОЕ МЕНЮ",
412	                new Vector2(52f, -184f - ButtonStep * 2f), OnMainMenuPressed);
413	
414	            var divider = NewImage(panel.transform, "Divider", new Color(_dim.r, _dim.g, _dim.b, 0.24f));
415	            var dividerRect = divider.rectTransform;
416	            dividerRect.anchorMin = new Vector2(0f, 0f);
417	            dividerRect.anchorMax = new Vector2(0f, 1f);
418	            dividerRect.pivot = new Vector2(0.5f, 0.5f);
419	            dividerRect.sizeDelta = new Vector2(1f, -180f);
420	            dividerRect.anchoredPosition = new Vector2(392f, -40f);
421	
422	            var content = new GameObject("Content", typeof(RectTransform));
423	            content.transform.SetParent(panel.transform, false);
424	            var contentRect = (RectTransform)content.transform;
425	            contentRect.anchorMin = Vector2.zero;
426	            contentRect.anchorMax = Vector2.one;
427	            contentRect.offsetMin = new Vector2(420f, 48f);
428	            contentRect.offsetMax = new Vector2(-48f, -140f);
429	
430	            _overviewPanel = BuildOverviewPanel(content.transform);
431	            _journalPanel = BuildJournalPanel(content.transform);
432	            _settingsPanel = BuildSettingsPanel(content.transform);
433	            _journalPanel.SetActive(false);
434	            _settingsPanel.SetActive(false);
435	
436	            BuildGearButton(panel.transform);
437	            return panel;
438	        }
