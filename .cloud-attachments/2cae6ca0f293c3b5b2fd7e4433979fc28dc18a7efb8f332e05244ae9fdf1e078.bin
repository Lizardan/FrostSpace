{
  "command": "python - <<'PY'\nimport json, sys\nsys.path.insert(0, 'Tools/Unity')\nfrom unity_bridge import Bridge\ncode = r'''\nvar scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();\nT GetOrAdd<T>(GameObject go) where T : Component {\n    var c = go.GetComponent<T>();\n    return c != null ? c : go.AddComponent<T>();\n}\nvoid Configure(Component c, System.Action<SerializedObject> action) {\n    var so = new SerializedObject(c);\n    action(so);\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\nvar player = GameObject.Find(\"Player\");\nvar cameraGo = GameObject.Find(\"Main Camera\");\nvar r13 = GameObject.Find(\"R13_Prospector\");\nvar cart = GameObject.Find(\"Prop_GravCart\");\nif (player == null || cameraGo == null || r13 == null || cart == null)\n    return new { error = \"scene objects not found\" };\n\nvar quest = AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Quest.QuestAsset>(\"Assets/_Project/Content/Data/Quests/TrainBatteries.asset\");\nvar intro = AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(\"Assets/_Project/Content/Data/Dialogues/TrainCompanion_Intro.asset\");\nvar done = AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(\"Assets/_Project/Content/Data/Dialogues/TrainCompanion_Done.asset\");\nvar font = AssetDatabase.LoadAssetAtPath<TMPro.TMP_FontAsset>(\"Assets/_Project/Content/Fonts/LiberationSans Cyrillic SDF.asset\");\nvar input = AssetDatabase.LoadAssetAtPath<UnityEngine.InputSystem.InputActionAsset>(\"Assets/InputSystem_Actions.inputactions\");\n\nvar screen = GetOrAdd<FrostSpace.Features.Dialogue.DialogueScreen>(player);\nvar dialogue = GetOrAdd<FrostSpace.Features.Dialogue.DialogueController>(player);\nvar director = GetOrAdd<FrostSpace.Features.Quest.QuestDirector>(player);\nvar tracker = GetOrAdd<FrostSpace.Features.Hud.QuestTracker>(player);\nvar carry = GetOrAdd<FrostSpace.Features.Carry.CarryController>(player);\nvar loco = player.GetComponent<FrostSpace.Features.Locomotion.RobotLocomotion>();\nvar rig = cameraGo.GetComponent<FrostSpace.Features.View.PlayerCameraRig>();\nvar scanner = cameraGo.GetComponent<FrostSpace.Features.Scan.ObjectScanner>();\n\nvar speaker = GetOrAdd<FrostSpace.Features.Dialogue.DialogueSpeaker>(r13);\nvar marker = GetOrAdd<FrostSpace.Features.Dialogue.DialogueMarker>(r13);\nvar capsule = GetOrAdd<CapsuleCollider>(r13);\ncapsule.center = new Vector3(0f, 1.0f, 0f);\ncapsule.height = 2.0f;\ncapsule.radius = 0.4f;\n\nConfigure(screen, so => so.FindProperty(\"_font\").objectReferenceValue = font);\nConfigure(dialogue, so => {\n    so.FindProperty(\"_rig\").objectReferenceValue = rig;\n    so.FindProperty(\"_scanner\").objectReferenceValue = scanner;\n    so.FindProperty(\"_screen\").objectReferenceValue = screen;\n    so.FindProperty(\"_locomotion\").objectReferenceValue = loco;\n    so.FindProperty(\"_actions\").objectReferenceValue = input;\n    so.FindProperty(\"_blockers\").intValue = ~(1 << 6);\n});\nConfigure(carry, so => {\n    so.FindProperty(\"_dialogue\").objectReferenceValue = dialogue;\n    so.FindProperty(\"_gripForward\").floatValue = 0.44f;\n    so.FindProperty(\"_gripLift\").floatValue = 0.03f;\n});\nConfigure(speaker, so => so.FindProperty(\"_dialogue\").objectReferenceValue = intro);\nConfigure(marker, so => so.FindProperty(\"_speaker\").objectReferenceValue = speaker);\nConfigure(director, so => {\n    so.FindProperty(\"_quest\").objectReferenceValue = quest;\n    so.FindProperty(\"_dialogue\").objectReferenceValue = dialogue;\n    so.FindProperty(\"_speaker\").objectReferenceValue = speaker;\n    so.FindProperty(\"_completedDialogue\").objectReferenceValue = done;\n    var slots = cart.GetComponentsInChildren<FrostSpace.Features.Carry.CarrySlot>(true);\n    var slotsProp = so.FindProperty(\"_slots\");\n    slotsProp.arraySize = slots.Length;\n    for (var i = 0; i < slots.Length; i++) slotsProp.GetArrayElementAtIndex(i).objectReferenceValue = slots[i];\n});\nConfigure(tracker, so => {\n    so.FindProperty(\"_director\").objectReferenceValue = director;\n    so.FindProperty(\"_font\").objectReferenceValue = font;\n});\n\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);\nUnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);\nreturn new {\n    playerComponents = player.GetComponents<Component>().Length,\n    r13Components = r13.GetComponents<Component>().Length,\n    slots = cart.GetComponentsInChildren<FrostSpace.Features.Carry.CarrySlot>(true).Length,\n    quest = quest != null,\n    intro = intro != null,\n    done = done != null,\n    font = font != null,\n    input = input != null\n};\n'''\nwith Bridge(port=6401) as b:\n    r = b.call('execute_code', {'action': 'execute', 'code': code})\n    print(json.dumps(r, ensure_ascii=False, indent=2)[:6000])\nPY",
  "description": "Wire quest, dialogue, tracker and marker into Train scene"
}
