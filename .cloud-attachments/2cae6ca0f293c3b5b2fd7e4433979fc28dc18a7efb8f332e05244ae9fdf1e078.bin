463	        private static void Stretch(RectTransform rect)
464	        {
465	            rect.anchorMin = Vector2.zero;
466	            rect.anchorMax = Vector2.one;
467	            rect.offsetMin = Vector2.zero;
468	            rect.offsetMax = Vector2.zero;
469	        }
