using FrostSpace.Features.Dialogue;
using TMPro;
using UnityEngine;
namespace FrostSpace.Features.Dialogue
{
 [DisallowMultipleComponent]
 public sealed class DialogueMarker : MonoBehaviour
 {
   [SerializeField] private DialogueSpeaker _speaker;
   [SerializeField] private float _height = 2.35f;
   [SerializeField] private Color _color = new(0.302f,0.902f,1f,1f);
   private TextMeshPro _label;
   private Camera _camera;
   private void Awake()
   {
      if (_speaker == null) _speaker = GetComponent<DialogueSpeaker>();
      var go = new GameObject("TalkMarker", typeof(TextMeshPro));
      go.transform.SetParent(transform, false);
      _label = go.GetComponent<TextMeshPro>();
      if (TMP_Settings.defaultFontAsset != null) _label.font = TMP_Settings.defaultFontAsset;
      _label.text = "E";
      _label.fontSize = 0.5f;
      _label.alignment = TextAlignmentOptions.Center;
      _label.color = _color;
      _label.rectTransform.sizeDelta = new Vector2(1f, 0.6f);
      var mr = go.GetComponent<MeshRenderer>();
      if (mr != null) mr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
      _camera = Camera.main;
   }
   private void LateUpdate()
   {
      if (_label == null) return;
      var visible = _speaker != null && _speaker.CanTalk;
      _label.gameObject.SetActive(visible);
      if (!visible) return;
      _label.transform.position = transform.position + Vector3.up * _height;
      if (_camera == null) _camera = Camera.main;
      if (_camera != null) _label.transform.rotation = _camera.transform.rotation;
   }
 }
}
```
