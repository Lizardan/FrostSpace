1	using System.Collections.Generic;
2	using UnityEngine;
3	
4	namespace FrostSpace.Features.Dialogue
5	{
6	    /// <summary>
7	    /// Диалог как граф реплик. Ассет — только данные: переходы хранятся по стабильным
8	    /// строковым id, поэтому перестановка узлов ничего не ломает. Ошибки и
9	    /// предупреждения собирает <see cref="CollectProblems"/>; её вызывают инспектор,
10	    /// меню проверки и EditMode-тесты.
11	    ///
12	    /// Методы добавления/удаления узлов — часть авторинга: инспектор пишет через них,
13	    /// чтобы удаление переводило ссылки на узел в «Конец», а дубликат получал новый id.
14	    /// </summary>
15	    [CreateAssetMenu(
16	        fileName = "Dialogue",
17	        menuName = "FrostSpace/Dialogue",
18	        order = 0)]
19	    public sealed class DialogueAsset : ScriptableObject
20	    {
21	        /// <summary>Столько вариантов ответа помещается в панель.</summary>
22	        public const int MaxChoices = 4;
23	
24	        /// <summary>Длина реплики, после которой инспектор предупреждает о переполнении.</summary>
25	        public const int LongLineWarning = 300;
26	
27	        [Tooltip("С какого узла начинается разговор")]
28	        [SerializeField] private string _startId;
29	        [SerializeField] private List<DialogueNode> _nodes = new();
30	
31	        /// <summary>Id стартового узла.</summary>
32	        public string StartId => _startId;
33	
34	        /// <summary>Узлы в порядке, заданном автором.</summary>
35	        public IReadOnlyList<DialogueNode> Nodes => _nodes;
36	
37	        /// <summary>Стартовый узел или <c>null</c>, если id пуст/не найден.</summary>
38	        public DialogueNode StartNode => Find(_startId);
39	
40	        /// <summary>Узел по id; <c>null</c> для пустой строки и неизвестного id.</summary>
41	        public DialogueNode Find(string id)
42	        {
43	            if (string.IsNullOrWhiteSpace(id))
44	                return null;
45	
46	            for (var i = 0; i < _nodes.Count; i++)
47	            {
48	                if (_nodes[i] != null && _nodes[i].Id == id)
49	                    return _nodes[i];
50	            }
51	
52	            return null;
53	        }
54	
55	        /// <summary>Новая runtime-сессия этого диалога.</summary>
56	        public DialogueSession CreateSession() => new(this);
57	
58	        /// <summary>
59	        /// Новый узел в конце. Первый узел автоматически становится стартовым.
60	        /// </summary>
61	        public DialogueNode AddNode(string line = "")
62	        {
63	            var node = new DialogueNode(NewId(), line);
64	            _nodes.Add(node);
65	            if (string.IsNullOrWhiteSpace(_startId))
66	                _startId = node.Id;
67	            return node;
68	        }
69	
70	        /// <summary>Копия узла сразу после оригинала; id всегда новый.</summary>
71	        public DialogueNode DuplicateNode(int index)
72	        {
73	            if (index < 0 || index >= _nodes.Count || _nodes[index] == null)
74	                return null;
75	
76	            var copy = _nodes[index].Clone(NewId());
77	            _nodes.Insert(index + 1, copy);
78	            return copy;
79	        }
80	
81	        /// <summary>
82	        /// Удаляет узел и переводит все ссылки на него в «Конец». Стартовым становится
83	        /// первый оставшийся узел; если узлов не осталось — старт пуст.
84	        /// </summary>
85	        public void RemoveNode(int index)
86	        {
87	            if (index < 0 || index >= _nodes.Count)
88	                return;
89	
90	            var removed = _nodes[index];
91	            _nodes.RemoveAt(index);
92	
93	            if (removed != null)
94	            {
95	                for (var i = 0; i < _nodes.Count; i++)
96	                    _nodes[i]?.Forget(removed.Id);
97	
98	                if (_startId == removed.Id)
99	                    _startId = _nodes.Count > 0 ? _nodes[0].Id : string.Empty;
100	            }
101	        }
102	
103	        /// <summary>Назначает стартовый узел; <c>null</c> очищает старт.</summary>
104	        public void SetStart(DialogueNode node)
105	        {
106	            _startId = node != null ? node.Id : string.Empty;
107	        }
108	
109	        /// <summary>
110	        /// Полная проверка графа. Ошибки не дают диалогу открыться, предупреждения
111	        /// допустимы: циклы и длинные реплики — авторское решение.
112	        /// </summary>
113	        public void CollectProblems(List<string> errors, List<string> warnings)
114	        {
115	            errors ??= new List<string>();
116	            warnings ??= new List<string>();
117	
118	            if (_nodes.Count == 0)
119	            {
120	                errors.Add("В диалоге нет ни одного узла.");
121	                return;
122	            }
123	
124	            var byId = new Dictionary<string, DialogueNode>();
125	            for (var i = 0; i < _nodes.Count; i++)
126	            {
127	                var node = _nodes[i];
128	                if (node == null)
129	                {
130	                    errors.Add($"Узел #{i + 1}: пустая запись списка.");
131	                    continue;
132	                }
133	
134	                if (string.IsNullOrWhiteSpace(node.Id))
135	                {
136	                    errors.Add($"Узел #{i + 1}: пустой id.");
137	                    continue;
138	                }
139	
140	                if (byId.ContainsKey(node.Id))
141	                    errors.Add($"Узел {node.Id}: id повторяется.");
142	                else
143	                    byId.Add(node.Id, node);
144	            }
145	
146	            if (string.IsNullOrWhiteSpace(_startId))
147	                errors.Add("Не выбран стартовый узел.");
148	            else if (!byId.ContainsKey(_startId))
149	                errors.Add($"Стартовый узел {_startId} не найден.");
150	
151	            for (var i = 0; i < _nodes.Count; i++)
152	            {
153	                var node = _nodes[i];
154	                if (node == null)
155	                    continue;
156	
157	                var label = string.IsNullOrWhiteSpace(node.Id) ? $"#{i + 1}" : node.Id;
158	
159	                if (string.IsNullOrWhiteSpace(node.Line))
160	                    errors.Add($"Узел {label}: пустая реплика.");
161	                else if (node.Line.Length > LongLineWarning)
162	                    warnings.Add($"Узел {label}: реплика длиннее {LongLineWarning} символов.");
163	
164	                if (node.Choices.Count > MaxChoices)
165	                {
166	                    errors.Add(
167	                        $"Узел {label}: {node.Choices.Count} вариантов, максимум {MaxChoices}.");
168	                }
169	
170	                for (var c = 0; c < node.Choices.Count; c++)
171	                {
172	                    var choice = node.Choices[c];
173	                    if (choice == null)
174	                    {
175	                        errors.Add($"Узел {label}, вариант #{c + 1}: пустая запись.");
176	                        continue;
177	                    }
178	
179	                    if (string.IsNullOrWhiteSpace(choice.Text))
180	                        errors.Add($"Узел {label}, вариант #{c + 1}: пустой текст.");
181	
182	                    if (!string.IsNullOrWhiteSpace(choice.NextId) &&
183	                        !byId.ContainsKey(choice.NextId))
184	                    {
185	                        errors.Add(
186	                            $"Узел {label}, вариант #{c + 1}: переход {choice.NextId} не найден.");
187	                    }
188	                }
189	
190	                if (node.Choices.Count == 0 &&
191	                    !string.IsNullOrWhiteSpace(node.NextId) &&
192	                    !byId.ContainsKey(node.NextId))
193	                {
194	                    errors.Add($"Узел {label}: переход {node.NextId} не найден.");
195	                }
196	            }
197	
198	            if (errors.Count > 0)
199	                return;
200	
201	            CheckReachability(byId, warnings);
202	        }
203	
204	        /// <summary>
205	        /// Обход от старта: узлы вне обхода — предупреждение; отсутствие хотя бы
206	        /// одного достижимого конца — тоже (любой путь зациклен).
207	        /// </summary>
208	        private void CheckReachability(
209	            Dictionary<string, DialogueNode> byId, List<string> warnings)
210	        {
211	            var reachable = new HashSet<string>();
212	            var stack = new Stack<DialogueNode>();
213	            var start = Find(_startId);
214	            if (start != null)
215	                stack.Push(start);
216	
217	            var hasEnd = false;
218	            while (stack.Count > 0)
219	            {
220	                var node = stack.Pop();
221	                if (node == null || !reachable.Add(node.Id))
222	                    continue;
223	
224	                if (node.IsTerminal)
225	                {
226	                    hasEnd = true;
227	                    continue;
228	                }
229	
230	                if (node.Choices.Count == 0)
231	                {
232	                    if (byId.TryGetValue(node.NextId, out var next))
233	                        stack.Push(next);
234	                    continue;
235	                }
236	
237	                for (var i = 0; i < node.Choices.Count; i++)
238	                {
239	                    if (string.IsNullOrWhiteSpace(node.Choices[i].NextId))
240	                        hasEnd = true;
241	                    else if (byId.TryGetValue(node.Choices[i].NextId, out var next))
242	                        stack.Push(next);
243	                }
244	            }
245	
246	            for (var i = 0; i < _nodes.Count; i++)
247	            {
248	                var node = _nodes[i];
249	                if (node != null && !reachable.Contains(node.Id))
250	                    warnings.Add($"Узел {node.Id} недостижим из старта.");
251	            }
252	
253	            if (!hasEnd)
254	                warnings.Add("В диалоге нет достижимого конца: любой путь зациклен.");
255	        }
256	
257	        /// <summary>Свободный id вида node_N: старые id не переиспользуются молча.</summary>
258	        private string NewId()
259	        {
260	            for (var n = 1; ; n++)
261	            {
262	                var id = $"node_{n}";
263	                if (Find(id) == null)
264	                    return id;
265	            }
266	        }
267	    }
268	}
