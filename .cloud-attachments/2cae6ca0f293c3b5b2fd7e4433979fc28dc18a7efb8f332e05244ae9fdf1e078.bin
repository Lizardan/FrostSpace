13	    TrainInterior.fbx  — один большой вагон: корпус `TrainBody` и створка
14	                         `TrainDoor` отдельным объектом (её двигает сцена);
15	                         интерьер 8 × 24 м, высота 3.2 м, дверь в Blender −Y
16	                         (после `export_static` это Unity +Z, нос вагона);
17	    Prop_Battery.fbx   — тяжёлый аккумулятор: корпус, ручки, полосы, индикатор;
18	    Prop_GravCart.fbx  — грави-тележка на четыре слота с ручкой и пульта.
19	
20	Оси и единицы — как у остальной статики (ADR 0002, 0007): метры, Z вверх,
21	дверь в −Y, `export_static` зеркалит X и компенсирует `bake_space_transform`.
22	Пивот пропов — низ по центру (z = 0): в сцене они ставятся на пол как есть.
23	
24	Палитра — `Level_*`; материалы подставит `LevelAssetPostprocessor` (папки
25	`Models/Level` и `Models/Train` используют один контракт палитры).
26	"""
27	
28	from __future__ import annotations
29	
30	import os
31	import sys
32	import traceback
33	
34	HERE = os.path.dirname(os.path.abspath(__file__))
35	if HERE not in sys.path:
36	    sys.path.insert(0, HERE)
37	
38	import bpy  # noqa: E402
39	
40	import level_lib  # noqa: E402
41	
42	OUT = os.path.abspath(os.path.join(HERE, "..", "..", "Assets", "_Project",
43	                                   "Content", "Models", "Train"))
44	
45	HALF_W = 4.0          # половина ширины вагона, м
46	HALF_L = 12.0         # половина длины, м
47	WALL = 0.2            # толщина стены
48	HEIGHT = 3.2          # высота интерьера
49	DOOR_W = 3.2          # ширина дверного проёма
50	DOOR_H = 2.6          # высота проёма
51	
52	
53	# ------------------------------------------------------------------ вагон
54	
55	def _wall(b, sx, materials):
56	    """Борт: нижняя панель, окна между стойками, верхняя полоса и рёбра."""
57	    x = sx * (HALF_W - WALL * 0.5)
58	
59	    # Нижняя панель — дерево: металл в интерьере отражает небо и седеет.
60	    b.box((x, 0.0, 0.6), (WALL, HALF_L * 2.0, 1.2), "Level_Wood", bevel=0.02)
61	    b.box((x, 0.0, 2.85), (WALL, HALF_L * 2.0, 0.7), "Level_Stone", bevel=0.02)
62	
63	    # Подоконник и перемычка: тёмная ржавчина отделяет остекление.
64	    b.box((sx * (HALF_W - 0.16), 0.0, 1.26), (0.24, HALF_L * 2.0, 0.12),
65	          "Level_Rust", bevel=0.01)
66	    b.box((sx * (HALF_W - 0.16), 0.0, 2.44), (0.24, HALF_L * 2.0, 0.12),
67	          "Level_Rust", bevel=0.01)
68	
69	    # Стойки между окнами: восемь пролётов по 3 м.
70	    for i in range(9):
71	        y = -HALF_L + 1.5 + i * 2.625
72	        b.box((x, y, 1.85), (0.24, 0.3, 1.3), "Level_Metal", bevel=0.015)
73	        # Оранжевая метка на стойке — ориентир в длинном вагоне.
74	        b.box((sx * (HALF_W - 0.3), y, 1.9), (0.06, 0.12, 0.5),
75	              "Level_Orange", bevel=0.0)
76	
77	    # Рёбра жёсткости по нижней панели.
78	    for i in range(17):
79	        y = -HALF_L + 1.0 + i * 1.375
80	        b.box((sx * (HALF_W - 0.16), y, 0.55), (0.12, 0.18, 1.0),
81	              "Level_Metal", bevel=0.01)
82	
83	    # Иней у пола ближе к двери: вагон холодный, дверь открывают редко.
84	    for i in range(3):
85	        y = -HALF_L + 1.2 + i * 1.1
86	        b.box((sx * (HALF_W - 0.45), y, 0.07), (0.55, 0.8, 0.1),
87	              "Level_Snow", bevel=0.02)
88	
89	
90	def _ceiling(b):
91	    """Потолок с рёбрами, два плафона и трубы по бортам."""
92	    b.box((0.0, 0.0, HEIGHT + 0.1), (HALF_W * 2.0, HALF_L * 2.0, 0.2),
93	          "Level_Stone", bevel=0.02)
94	
95	    for i in range(13):
96	        y = -HALF_L + i * 2.0
97	        b.box((0.0, y, HEIGHT - 0.02), (HALF_W * 2.0, 0.16, 0.14),
98	              "Level_Metal", bevel=0.01)
99	
100	    # Плафоны: широкий кожух и утопленная тёплая полоса. Свет в вагоне — единственный.
101	    for y in (-6.0, 6.0):
102	        b.box((0.0, y, HEIGHT - 0.1), (1.3, 3.2, 0.16), "Level_Metal",
103	              bevel=0.02)
104	        b.box((0.0, y, HEIGHT - 0.19), (0.55, 2.5, 0.06), "Level_Window",
105	              bevel=0.0)
106	
107	    # Трубы и хомуты.
108	    for sx in (-1, 1):
109	        b.tube([(sx * 3.5, -HALF_L + 0.4, HEIGHT - 0.18),
110	                (sx * 3.5, HALF_L - 0.4, HEIGHT - 0.18)],
111	               [(0.08, 0.08)] * 2, "Level_Rust", n=6, caps=(False, False))
112	        for i in range(6):
113	            y = -HALF_L + 2.0 + i * 4.0
114	            b.box((sx * 3.5, y, HEIGHT - 0.1), (0.16, 0.12, 0.2),
115	                  "Level_Metal", bevel=0.01)
116	    b.tube([(0.0, -HALF_L + 0.4, HEIGHT - 0.06),
117	            (0.0, HALF_L - 0.4, HEIGHT - 0.06)],
118	           [(0.05, 0.05)] * 2, "Level_Rust", n=6, caps=(False, False))
119	
120	
121	def _far_end(b):
122	    """Глухая стена: панели, люк, щиток с индикаторами, вертикальные трубы."""
123	    y = HALF_L - WALL * 0.5
124	    b.box((0.0, y, HEIGHT * 0.5), (HALF_W * 2.0, WALL, HEIGHT),
125	          "Level_Metal", bevel=0.02)
126	
127	    for x in (-2.6, 0.0, 2.6):
128	        b.box((x, y - 0.08, 1.6), (0.3, 0.16, 2.9), "Level_Metal",
129	              bevel=0.015)
130	
131	    # Люк в стене: тёмная панель в оранжевой рамке.
132	    b.box((0.0, y - 0.16, 1.1), (1.6, 0.12, 1.8), "Level_WoodDark",
133	          bevel=0.02)
134	    b.box((0.0, y - 0.22, 2.02), (1.8, 0.08, 0.12), "Level_Orange", bevel=0.0)
135	    for sx in (-1, 1):
136	        b.box((sx * 0.84, y - 0.22, 1.1), (0.08, 0.08, 1.9),
137	              "Level_Orange", bevel=0.0)
138	
139	    # Щиток: три индикатора, читаются как «система жива».
140	    b.box((1.9, y - 0.14, 2.15), (1.2, 0.1, 0.7), "Level_Metal", bevel=0.02)
141	    for i in range(3):
142	        b.box((1.55 + i * 0.3, y - 0.2, 2.15), (0.12, 0.04, 0.12),
143	              "Level_Window", bevel=0.0)
144	
145	    for sx in (-3.1, -3.45):
146	        b.tube([(sx, y - 0.12, 0.1), (sx, y - 0.12, HEIGHT - 0.1)],
147	               [(0.07, 0.07)] * 2, "Level_Rust", n=6)
148	
149	
150	def _door_end(b):
151	    """Торец с проёмом: сегменты стены, перемычка, рамка и рельс створки."""
152	    y = -HALF_L + WALL * 0.5
153	    side = (HALF_W * 2.0 - DOOR_W) * 0.5
154	
155	    for sx in (-1, 1):
156	        b.box((sx * (DOOR_W * 0.5 + side * 0.5), y, HEIGHT * 0.5),
157	              (side, WALL, HEIGHT), "Level_Metal", bevel=0.02)
158	        # Вертикальные рёбра на глухих частях.
159	        b.box((sx * (DOOR_W * 0.5 + side * 0.5), y - 0.08, 1.6),
160	              (side * 0.5, 0.16, 2.9), "Level_Metal", bevel=0.015)
161	
162	    # Перемычка над проёмом.
163	    b.box((0.0, y, DOOR_H + (HEIGHT - DOOR_H) * 0.5),
164	          (DOOR_W, WALL, HEIGHT - DOOR_H), "Level_Metal", bevel=0.02)
165	
166	    # Оранжевая рамка проёма: сквозь стену, видна и изнутри, и снаружи.
167	    for sx in (-1, 1):
168	        b.box((sx * (DOOR_W * 0.5 + 0.06), y, DOOR_H * 0.5),
169	              (0.12, WALL + 0.08, DOOR_H), "Level_Orange", bevel=0.0)
170	    b.box((0.0, y, DOOR_H + 0.06), (DOOR_W + 0.24, WALL + 0.08, 0.12),
171	          "Level_Orange", bevel=0.0)
172	
173	    # Рельс, по которому уезжает створка, и порог — внутри вагона.
174	    b.box((0.0, y + 0.22, DOOR_H + 0.22), (DOOR_W + 0.6, 0.28, 0.14),
175	          "Level_Rust", bevel=0.02)
176	    b.box((0.0, y + 0.2, 0.05), (DOOR_W, 0.5, 0.1), "Level_Rust", bevel=0.01)
177	
178	    # Занос у двери: внутрь наметает.
179	    b.box((0.0, y + 1.1, 0.06), (DOOR_W - 0.4, 1.1, 0.12), "Level_Snow",
180	          bevel=0.03)
181	
182	
183	def _furniture(b):
184	    """Лавки, верстак, ящики и полка — чтобы вагон читался как рабочий."""
185	    for sx in (-1, 1):
186	        # Лавка: сиденье, спинка, ножки.
187	        b.box((sx * 3.25, 6.4, 0.5), (0.6, 2.4, 0.1), "Level_Wood",
188	              bevel=0.02)
189	        b.box((sx * 3.5, 6.4, 0.85), (0.12, 2.4, 0.6), "Level_WoodDark",
190	              bevel=0.02)
191	        for dy in (-1.0, 1.0):
192	            b.box((sx * 3.25, 6.4 + dy, 0.25), (0.5, 0.12, 0.5),
193	                  "Level_Metal", bevel=0.01)
194	
195	    # Верстак в дальнем конце: столешница, ножки, тиски, лампа.
196	    b.box((0.0, 10.5, 0.95), (2.4, 0.9, 0.12), "Level_Wood", bevel=0.02)
197	    for sx in (-1, 1):
198	        for dy in (-0.35, 0.35):
199	            b.box((sx * 1.0, 10.5 + dy, 0.45), (0.14, 0.14, 0.9),
200	                  "Level_Metal", bevel=0.01)
201	    b.box((0.7, 10.5, 1.12), (0.5, 0.4, 0.22), "Level_Rust", bevel=0.02)
202	    b.box((0.7, 10.5, 1.26), (0.24, 0.2, 0.12), "Level_Metal", bevel=0.01)
203	    b.box((-0.9, 10.5, 1.15), (0.12, 0.12, 0.3), "Level_Metal", bevel=0.01)
204	    b.box((-0.9, 10.5, 1.32), (0.5, 0.3, 0.1), "Level_Metal", bevel=0.02)
205	    b.box((-0.9, 10.5, 1.26), (0.4, 0.2, 0.04), "Level_Window", bevel=0.0)
206	
207	    # Ящики по углам.
208	    for x, y, size in ((3.1, -9.4, 0.9), (-3.0, 9.7, 0.8)):
209	        b.box((x, y, size * 0.5), (size, size, size), "Level_Wood",
210	              bevel=0.03)
211	        b.box((x, y, size * 0.55), (size + 0.04, 0.1, 0.12), "Level_Rust",
212	              bevel=0.0)
213	        b.box((x, y, size + 0.02), (size * 0.9, size * 0.9, 0.06),
214	              "Level_Snow", bevel=0.0)
215	
216	    # Полка на дальнем борту.
217	    b.box((3.6, 9.6, 1.9), (0.35, 3.0, 0.1), "Level_WoodDark", bevel=0.01)
218	    for dy in (-1.2, 1.2):
219	        b.box((3.45, 9.6 + dy, 1.8), (0.2, 0.12, 0.3), "Level_Metal",
220	              bevel=0.01)
221	
222	
223	def _floor(b):
224	    """Пол: сталь, деревянный настил по центру, оранжевые кромки."""
225	    b.box((0.0, 0.0, -0.15), (HALF_W * 2.0, HALF_L * 2.0, 0.3),
226	          "Level_Stone", bevel=0.02)
227	    b.box((0.0, 0.0, 0.025), (2.6, HALF_L * 2.0 - 0.8, 0.05),
228	          "Level_WoodDark", bevel=0.01)
229	    for sx in (-1, 1):
230	        b.box((sx * 1.36, 0.0, 0.04), (0.08, HALF_L * 2.0 - 0.8, 0.03),
231	              "Level_Orange", bevel=0.0)
232	
233	    # Поперечные швы настила: крупные, чтобы не читались «сыпью».
234	    for i in range(11):
235	        y = -HALF_L + 1.4 + i * 2.0
236	        b.box((0.0, y, 0.055), (2.6, 0.08, 0.02), "Level_Rust", bevel=0.0)
237	
238	
239	def build_interior(materials):
240	    b = level_lib.LevelBuilder(materials)
241	    _floor(b)
242	    for sx in (-1, 1):
243	        _wall(b, sx, materials)
244	    _ceiling(b)
245	    _far_end(b)
246	    _door_end(b)
247	    _furniture(b)
248	    body = b.build("TrainBody")
249	
250	    # Створка отдельным объектом: сцена двигает её в финале. Меш — вокруг
251	    # нуля, объект ставится в проём: иначе пивот уезжает на 12 м и коллайдер
252	    # не совпадает с полотном (та же грабля, что у колеса мотоцикла).
253	    d = level_lib.LevelBuilder(materials)
254	    y = 0.0
255	    d.box((0.0, y, DOOR_H * 0.5), (DOOR_W - 0.1, 0.12, DOOR_H - 0.05),
256	          "Level_Metal", bevel=0.02)
257	    # Рёбра с обеих сторон: створка читается и изнутри, и снаружи.
258	    for x in (-1.0, 0.0, 1.0):
259	        for sy in (-1, 1):
260	            d.box((x, y + sy * 0.08, DOOR_H * 0.5),
261	                  (0.2, 0.06, DOOR_H - 0.3), "Level_Metal", bevel=0.015)
262	    # Окно — сквозная вставка, видна с двух сторон, в ржавой рамке.
263	    d.box((0.0, y, 2.0), (1.4, 0.16, 0.5), "Level_SnowDeep", bevel=0.01)
264	    for dz in (-1, 1):
265	        d.box((0.0, y, 2.0 + dz * 0.29), (1.5, 0.16, 0.08), "Level_Rust",
266	              bevel=0.0)
267	    for dx in (-1, 1):
268	        d.box((dx * 0.74, y, 2.0), (0.08, 0.16, 0.58), "Level_Rust",
269	              bevel=0.0)
270	    # Аварийная полоса и ручки с обеих сторон.
271	    d.box((0.0, y, 0.35), (DOOR_W - 0.3, 0.16, 0.18), "Level_Orange",
272	          bevel=0.0)
273	    for sy in (-1, 1):
274	        d.tube([(1.2, y + sy * 0.1, 1.0), (1.2, y + sy * 0.1, 1.6)],
275	               [(0.05, 0.05)] * 2, "Level_Metal", n=6)
276	    door = d.build("TrainDoor")
277	    door.location = (0.0, -HALF_L + 0.06, 0.0)
278	
279	    return [body, door]
280	
281	
282	# ------------------------------------------------------------------ груз
283	
284	def build_battery(materials):
285	    b = level_lib.LevelBuilder(materials)
286	
287	    # Корпус и опорная рама: низ на z = 0, пивот по центру.
288	    b.box((0.0, 0.0, 0.05), (0.96, 0.66, 0.1), "Level_WoodDark", bevel=0.02)
289	    b.box((0.0, 0.0, 0.37), (0.9, 0.6, 0.64), "Level_Metal", bevel=0.03)
290	    b.box((0.0, 0.0, 0.71), (0.94, 0.64, 0.1), "Level_Rust", bevel=0.02)
291	
292	    # Оранжевые полосы по четырём сторонам.
293	    for sy in (-1, 1):
294	        b.box((0.0, sy * 0.31, 0.37), (0.9, 0.06, 0.12), "Level_Orange",
295	              bevel=0.0)
296	    for sx in (-1, 1):
297	        b.box((sx * 0.46, 0.0, 0.37), (0.06, 0.6, 0.12), "Level_Orange",
298	              bevel=0.0)
299	
300	    # Ручки: две скобы на крышке.
301	    for sx in (-1, 1):
302	        x = sx * 0.28
303	        b.tube([(x, -0.2, 0.76), (x, -0.2, 0.9), (x, 0.2, 0.9),
304	                (x, 0.2, 0.76)], [(0.05, 0.05)] * 4, "Level_Metal", n=6)
305	
306	    # Индикатор заряда: панель и три деления.
307	    b.box((0.22, -0.31, 0.45), (0.34, 0.06, 0.2), "Level_WoodDark",
308	          bevel=0.01)
309	    for i in range(3):
310	        b.box((0.1 + i * 0.11, -0.345, 0.45), (0.07, 0.03, 0.1),
311	              "Level_Window", bevel=0.0)
312	
313	    # Предупреждающая табличка и уголки.
314	    b.box((-0.22, -0.32, 0.55), (0.26, 0.06, 0.16), "Level_Orange",
315	          bevel=0.0)
316	    for sx in (-1, 1):
317	        for sy in (-1, 1):
318	            b.box((sx * 0.4, sy * 0.27, 0.16), (0.14, 0.14, 0.22),
319	                  "Level_Rust", bevel=0.01)
320	
321	    return b.build("Prop_Battery")
322	
323	
324	def build_cart(materials):
325	    b = level_lib.LevelBuilder(materials)
326	
327	    # Платформа на подушках: низ 0, подушки чуть приподняты.
328	    b.box((0.0, 0.0, 0.35), (2.4, 1.6, 0.3), "Level_Metal", bevel=0.03)
329	    b.box((0.0, 0.0, 0.52), (2.2, 1.4, 0.06), "Level_Rust", bevel=0.01)
330	
331	    # Борта.
332	    for sy in (-1, 1):
333	        b.box((0.0, sy * 0.75, 0.62), (2.4, 0.1, 0.24), "Level_Metal",
334	              bevel=0.01)
335	    for sx in (-1, 1):
336	        b.box((sx * 1.15, 0.0, 0.62), (0.1, 1.6, 0.24), "Level_Metal",
337	              bevel=0.01)
338	
339	    # Четыре гнезда 2×2: приподнятые бортики, оранжевая кромка, тёплая полоса.
340	    for sx in (-1, 1):
341	        for sy in (-1, 1):
342	            cx, cy = sx * 0.55, sy * 0.4
343	            # Дно гнезда темнее платформы.
344	            b.box((cx, cy, 0.53), (1.02, 0.64, 0.04), "Level_WoodDark",
345	                  bevel=0.0)
346	            # Бортики: между гнёздами две стенки образуют разделитель.
347	            for dy in (-1, 1):
348	                b.box((cx, cy + dy * 0.36, 0.63), (1.16, 0.08, 0.16),
349	                      "Level_Metal", bevel=0.01)
350	                b.box((cx, cy + dy * 0.36, 0.72), (1.16, 0.06, 0.06),
351	                      "Level_Orange", bevel=0.0)
352	            for dx in (-1, 1):
353	                b.box((cx + dx * 0.54, cy, 0.63), (0.08, 0.64, 0.16),
354	                      "Level_Metal", bevel=0.01)
355	                b.box((cx + dx * 0.54, cy, 0.72), (0.06, 0.64, 0.06),
356	                      "Level_Orange", bevel=0.0)
357	            # Тёплая полоса по внутренней кромке: гнездо «под напряжением».
358	            for dy in (-1, 1):
359	                b.box((cx, cy + dy * 0.31, 0.66), (0.92, 0.05, 0.06),
360	                      "Level_Window", bevel=0.0)
361	
362	    # Подушки: четыре опоры, без колёс. Оранжевая плита шире подушки —
363	    # читается как тёплый низ, а не как ножка.
364	    for sx in (-1, 1):
365	        for sy in (-1, 1):
366	            b.box((sx * 0.85, sy * 0.55, 0.15), (0.5, 0.4, 0.14),
367	                  "Level_Metal", bevel=0.02)
368	            b.box((sx * 0.85, sy * 0.55, 0.05), (0.58, 0.48, 0.1),
369	                  "Level_Orange", bevel=0.01)
370	
371	    # Бампер со стороны двери: тележку толкают, а не тянут.
