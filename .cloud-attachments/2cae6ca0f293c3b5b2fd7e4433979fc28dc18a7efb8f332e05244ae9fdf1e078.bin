  "file_path": "C:\\Users\\Lizardan\\.qoder\\app\\chat-session-visualizations\\21233fba-276b-4e5f-a887-751cad8674b1\\visualizations\\chassis-selection-sketches.html",
  "content": "<div id=\"chassis-sketches\" class=\"cssk\">\n  <style>\n    #chassis-sketches {\n      --cyan: #4de6ff;\n      --cyan-bright: #c5f9ff;\n      --cyan-soft: rgba(77, 230, 255, .42);\n      --ink: #d8f4fb;\n      --dim: #5f8292;\n      --line: rgba(77, 230, 255, .18);\n      --bg0: #040a10;\n      --bg1: #08151d;\n      box-sizing: border-box;\n      width: 100%;\n      max-width: 1120px;\n      margin: 0 auto;\n      color: var(--ink);\n      font-family: var(--font-sans, \"Segoe UI\", system-ui, sans-serif);\n    }\n\n    #chassis-sketches *,\n    #chassis-sketches *::before,\n    #chassis-sketches *::after { box-sizing: border-box; }\n\n    #chassis-sketches .cs-head {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 8px 20px;\n      margin: 0 0 14px;\n    }\n\n    #chassis-sketches .cs-head h3 {\n      margin: 0;\n      color: var(--cyan-bright);\n      font-size: 14px;\n      font-weight: 500;\n      letter-spacing: .15em;\n      text-transform: uppercase;\n      text-shadow: 0 0 18px rgba(77, 230, 255, .35);\n    }\n\n    #chassis-sketches .cs-head p {\n      margin: 0;\n      color: var(--dim);\n      font-size: 12px;\n      letter-spacing: .05em;\n    }\n\n    #chassis-sketches .cs-grid {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 16px;\n    }\n\n    #chassis-sketches .cs-option {\n      overflow: hidden;\n      border: 1px solid var(--line);\n      border-radius: 14px;\n      background: #050b11;\n    }\n\n    #chassis-sketches .cs-option-head {\n      display: flex;\n      align-items: flex-start;\n      gap: 10px;\n      padding: 11px 13px 10px;\n      border-bottom: 1px solid rgba(77, 230, 255, .10);\n    }\n\n    #chassis-sketches .cs-badge {\n      flex: 0 0 auto;\n      display: grid;\n      place-items: center;\n      width: 26px;\n      height: 26px;\n      border: 1px solid rgba(77, 230, 255, .48);\n      border-radius: 50%;\n      color: var(--cyan);\n      font-family: var(--font-code, \"Cascadia Mono\", monospace);\n      font-size: 12px;\n      font-weight: 500;\n    }\n\n    #chassis-sketches .cs-option-head b {\n      display: block;\n      color: var(--ink);\n      font-size: 13px;\n      font-weight: 500;\n      letter-spacing: .04em;\n    }\n\n    #chassis-sketches .cs-option-head span {\n      display: block;\n      margin-top: 2px;\n      color: var(--dim);\n      font-size: 11px;\n      line-height: 1.35;\n    }\n\n    #chassis-sketches .cs-stage {\n      position: relative;\n      aspect-ratio: 16 / 9;\n      overflow: hidden;\n      background:\n        radial-gradient(ellipse at 50% 108%, rgba(77, 230, 255, .17), transparent 58%),\n        linear-gradient(180deg, #0a1a24, var(--bg0) 76%);\n    }\n\n    #chassis-sketches .cs-stage::before {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      opacity: .28;\n      pointer-events: none;\n      background:\n        repeating-linear-gradient(90deg, transparent 0 79px, rgba(77, 230, 255, .07) 79px 80px),\n        repeating-linear-gradient(0deg, transparent 0 39px, rgba(77, 230, 255, .05) 39px 40px);\n      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, .75), transparent 82%);\n    }\n\n    #chassis-sketches .cs-stage::after {\n      content: \"\";\n      position: absolute;\n      left: 4%;\n      right: 4%;\n      bottom: 18%;\n      height: 1px;\n      background: linear-gradient(90deg, transparent, rgba(77, 230, 255, .35), transparent);\n      opacity: .7;\n    }\n\n    #chassis-sketches .cs-stage-mark,\n    #chassis-sketches .cs-stage-count,\n    #chassis-sketches .cs-locked {\n      position: absolute;\n      z-index: 6;\n      color: var(--dim);\n      font-size: 8px;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    #chassis-sketches .cs-stage-mark { top: 9px; left: 12px; color: var(--cyan-soft); }\n    #chassis-sketches .cs-stage-count { top: 9px; right: 12px; }\n    #chassis-sketches .cs-locked { top: 22px; right: 12px; color: rgba(95, 130, 146, .8); }\n\n    #chassis-sketches .cs-bot {\n      display: block;\n      overflow: visible;\n      color: #5b8cff;\n      filter: drop-shadow(0 0 9px currentColor);\n    }\n\n    #chassis-sketches .cs-bot.dim {\n      opacity: .36;\n      filter: none;\n    }\n\n    #chassis-sketches .cs-ring {\n      position: absolute;\n      border: 1px solid rgba(77, 230, 255, .72);\n      border-radius: 50%;\n      box-shadow: 0 0 18px rgba(77, 230, 255, .38), inset 0 0 18px rgba(77, 230, 255, .12);\n      pointer-events: none;\n    }\n\n    #chassis-sketches .cs-beam {\n      position: absolute;\n      left: 50%;\n      bottom: 8%;\n      width: 54%;\n      height: 78%;\n      transform: translateX(-50%);\n      background: linear-gradient(to top, rgba(77, 230, 255, .16), transparent 74%);\n      filter: blur(8px);\n      pointer-events: none;\n    }\n\n    #chassis-sketches .cs-scan {\n      position: absolute;\n      inset: 0;\n      z-index: 4;\n      pointer-events: none;\n      opacity: .22;\n      background: linear-gradient(180deg, transparent 0, rgba(77, 230, 255, .28) 49%, transparent 52%);\n      animation: cssk-scan 4s linear infinite;\n    }\n\n    @keyframes cssk-scan {\n      0% { transform: translateY(-100%); }\n      100% { transform: translateY(100%); }\n    }\n\n    #chassis-sketches .cs-cta {\n      position: absolute;\n      z-index: 7;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-width: 96px;\n      height: 26px;\n      padding: 0 12px;\n      border: 1px solid rgba(77, 230, 255, .48);\n      color: var(--cyan-bright);\n      font-size: 9px;\n      letter-spacing: .16em;\n      background: rgba(4, 12, 18, .5);\n    }\n\n    #chassis-sketches .cs-cta.center {\n      left: 50%;\n      bottom: 12px;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-cta.right {\n      right: 12px;\n      bottom: 12px;\n    }\n\n    #chassis-sketches .cs-note {\n      padding: 9px 13px 10px;\n      color: var(--dim);\n      font-size: 11px;\n      line-height: 1.35;\n    }\n\n    #chassis-sketches .cs-note strong { color: var(--cyan); font-weight: 500; }\n\n    /* A — three podiums */\n    #chassis-sketches .cs-a .cs-podium {\n      position: absolute;\n      bottom: 9%;\n      width: 27%;\n      height: 78%;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-a .cs-podium:nth-of-type(2) { left: 15%; }\n    #chassis-sketches .cs-a .cs-podium:nth-of-type(3) { left: 50%; }\n    #chassis-sketches .cs-a .cs-podium:nth-of-type(4) { left: 85%; }\n\n    #chassis-sketches .cs-a .cs-bot {\n      position: absolute;\n      left: 50%;\n      bottom: 22%;\n      width: 53%;\n      height: auto;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-a .cs-podium.selected .cs-bot {\n      width: 63%;\n      filter: drop-shadow(0 0 13px currentColor);\n    }\n\n    #chassis-sketches .cs-a .cs-ring {\n      left: 50%;\n      bottom: 18%;\n      width: 74%;\n      height: 15%;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-a .cs-podium:not(.selected) .cs-ring { opacity: .18; border-color: var(--dim); }\n\n    #chassis-sketches .cs-a .cs-plate {\n      position: absolute;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      text-align: center;\n    }\n\n    #chassis-sketches .cs-a .cs-plate .cs-id {\n      display: block;\n      color: var(--dim);\n      font-family: var(--font-code, \"Cascadia Mono\", monospace);\n      font-size: 8px;\n      letter-spacing: .12em;\n    }\n\n    #chassis-sketches .cs-a .cs-plate b {\n      display: block;\n      margin-top: 2px;\n      color: var(--ink);\n      font-size: 9px;\n      font-weight: 500;\n      letter-spacing: .04em;\n      white-space: nowrap;\n    }\n\n    #chassis-sketches .cs-a .cs-plate small {\n      display: block;\n      margin-top: 2px;\n      color: var(--dim);\n      font-size: 8px;\n      letter-spacing: .04em;\n    }\n\n    #chassis-sketches .cs-a .cs-podium.selected .cs-plate b { color: var(--cyan-bright); }\n\n    /* B — hero showcase */\n    #chassis-sketches .cs-b .cs-bot.side {\n      position: absolute;\n      bottom: 19%;\n      width: 24%;\n      opacity: .34;\n    }\n\n    #chassis-sketches .cs-b .cs-bot.left { left: 8%; }\n    #chassis-sketches .cs-b .cs-bot.right { right: 8%; }\n\n    #chassis-sketches .cs-b .cs-bot.hero {\n      position: absolute;\n      left: 50%;\n      bottom: 20%;\n      width: 42%;\n      height: auto;\n      transform: translateX(-50%);\n      filter: drop-shadow(0 0 16px currentColor);\n    }\n\n    #chassis-sketches .cs-b .cs-ring {\n      left: 50%;\n      bottom: 16%;\n      width: 38%;\n      height: 13%;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-b .cs-hero-name {\n      position: absolute;\n      left: 50%;\n      top: 12%;\n      transform: translateX(-50%);\n      z-index: 6;\n      text-align: center;\n      white-space: nowrap;\n    }\n\n    #chassis-sketches .cs-b .cs-hero-name b {\n      display: block;\n      color: var(--cyan-bright);\n      font-size: 13px;\n      font-weight: 500;\n      letter-spacing: .12em;\n      text-shadow: 0 0 16px rgba(77, 230, 255, .4);\n    }\n\n    #chassis-sketches .cs-b .cs-hero-name span {\n      display: block;\n      margin-top: 2px;\n      color: var(--dim);\n      font-size: 8px;\n      letter-spacing: .18em;\n    }\n\n    #chassis-sketches .cs-b .cs-arrow {\n      position: absolute;\n      top: 47%;\n      z-index: 6;\n      color: var(--cyan);\n      font-family: var(--font-code, monospace);\n      font-size: 25px;\n      opacity: .65;\n    }\n\n    #chassis-sketches .cs-b .cs-arrow.left { left: 6%; }\n    #chassis-sketches .cs-b .cs-arrow.right { right: 6%; }\n\n    #chassis-sketches .cs-b .cs-stats {\n      position: absolute;\n      top: 38%;\n      z-index: 6;\n      width: 22%;\n      font-family: var(--font-code, monospace);\n      font-size: 7px;\n      letter-spacing: .06em;\n      color: var(--dim);\n    }\n\n    #chassis-sketches .cs-b .cs-stats.left { left: 12%; text-align: right; }\n    #chassis-sketches .cs-b .cs-stats.right { right: 12%; }\n\n    #chassis-sketches .cs-b .cs-stats div { margin: 0 0 6px; }\n\n    #chassis-sketches .cs-b .cs-stats i {\n      display: block;\n      height: 2px;\n      margin: 3px 0 0;\n      background: linear-gradient(90deg, var(--cyan), rgba(77, 230, 255, .12));\n      box-shadow: 0 0 6px rgba(77, 230, 255, .28);\n    }\n\n    #chassis-sketches .cs-b .cs-stats.right i {\n      background: linear-gradient(90deg, rgba(77, 230, 255, .12), var(--cyan));\n    }\n\n    /* C — fitting room */\n    #chassis-sketches .cs-c .cs-list {\n      position: absolute;\n      left: 4%;\n      top: 16%;\n      bottom: 17%;\n      width: 31%;\n      z-index: 6;\n    }\n\n    #chassis-sketches .cs-c .cs-list-title {\n      margin-bottom: 8px;\n      color: var(--dim);\n      font-size: 8px;\n      letter-spacing: .16em;\n    }\n\n    #chassis-sketches .cs-c .cs-row {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      min-height: 30px;\n      padding: 4px 6px;\n      border-left: 2px solid transparent;\n      color: var(--dim);\n    }\n\n    #chassis-sketches .cs-c .cs-row.selected {\n      border-left-color: var(--cyan);\n      color: var(--ink);\n      background: linear-gradient(90deg, rgba(77, 230, 255, .13), transparent);\n    }\n\n    #chassis-sketches .cs-c .cs-row svg {\n      width: 18px;\n      height: 26px;\n      flex: 0 0 auto;\n      color: #5b8cff;\n      filter: drop-shadow(0 0 5px currentColor);\n    }\n\n    #chassis-sketches .cs-c .cs-row:nth-of-type(3) svg { color: #ff6b5e; }\n    #chassis-sketches .cs-c .cs-row:nth-of-type(4) svg { color: #5fd39a; }\n\n    #chassis-sketches .cs-c .cs-row b {\n      display: block;\n      font-size: 8px;\n      font-weight: 500;\n      letter-spacing: .04em;\n      white-space: nowrap;\n    }\n\n    #chassis-sketches .cs-c .cs-row small {\n      display: block;\n      margin-top: 1px;\n      font-size: 7px;\n      letter-spacing: .05em;\n    }\n\n    #chassis-sketches .cs-c .cs-hero {\n      position: absolute;\n      left: 49%;\n      bottom: 17%;\n      width: 43%;\n      height: 66%;\n      z-index: 3;\n    }\n\n    #chassis-sketches .cs-c .cs-hero .cs-bot {\n      position: absolute;\n      left: 50%;\n      bottom: 7%;\n      width: 64%;\n      height: auto;\n      transform: translateX(-50%);\n      filter: drop-shadow(0 0 14px currentColor);\n    }\n\n    #chassis-sketches .cs-c .cs-hero .cs-ring {\n      left: 50%;\n      bottom: 3%;\n      width: 77%;\n      height: 15%;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-c .cs-hero-name {\n      position: absolute;\n      left: 50%;\n      top: 2%;\n      transform: translateX(-50%);\n      z-index: 6;\n      text-align: center;\n      white-space: nowrap;\n    }\n\n    #chassis-sketches .cs-c .cs-hero-name b {\n      display: block;\n      color: var(--cyan-bright);\n      font-size: 12px;\n      letter-spacing: .08em;\n      font-weight: 500;\n    }\n\n    #chassis-sketches .cs-c .cs-hero-name span {\n      display: block;\n      margin-top: 2px;\n      color: var(--dim);\n      font-size: 8px;\n      letter-spacing: .08em;\n    }\n\n    #chassis-sketches .cs-c .cs-bars {\n      position: absolute;\n      right: 5%;\n      bottom: 17%;\n      width: 37%;\n      z-index: 6;\n      font-family: var(--font-code, monospace);\n      font-size: 7px;\n      color: var(--dim);\n    }\n\n    #chassis-sketches .cs-c .cs-bars div { margin: 0 0 4px; }\n    #chassis-sketches .cs-c .cs-bars i {\n      display: block;\n      height: 2px;\n      margin-top: 2px;\n      background: linear-gradient(90deg, var(--cyan), rgba(77, 230, 255, .12));\n    }\n\n    /* D — projections */\n    #chassis-sketches .cs-d .cs-projection {\n      position: absolute;\n      bottom: 12%;\n      width: 26%;\n      height: 73%;\n      transform: translateX(-50%);\n      text-align: center;\n    }\n\n    #chassis-sketches .cs-d .cs-projection.left { left: 16%; }\n    #chassis-sketches .cs-d .cs-projection.right { left: 84%; }\n    #chassis-sketches .cs-d .cs-projection.center { left: 50%; width: 34%; }\n\n    #chassis-sketches .cs-d .cs-bot {\n      position: absolute;\n      left: 50%;\n      bottom: 16%;\n      width: 57%;\n      height: auto;\n      transform: translateX(-50%);\n      opacity: .42;\n      filter: none;\n    }\n\n    #chassis-sketches .cs-d .cs-projection.center .cs-bot {\n      width: 70%;\n      opacity: 1;\n      filter: drop-shadow(0 0 14px currentColor);\n    }\n\n    #chassis-sketches .cs-d .cs-ring {\n      left: 50%;\n      bottom: 12%;\n      width: 68%;\n      height: 14%;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-d .cs-projection:not(.center) .cs-ring { opacity: .17; border-color: var(--dim); }\n\n    #chassis-sketches .cs-d .cs-proj-name {\n      position: absolute;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      color: var(--dim);\n      font-family: var(--font-code, monospace);\n      font-size: 8px;\n      letter-spacing: .09em;\n      line-height: 1.5;\n    }\n\n    #chassis-sketches .cs-d .cs-projection.center .cs-proj-name { color: var(--cyan-bright); }\n\n    #chassis-sketches .cs-footer {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      gap: 6px 18px;\n      margin-top: 13px;\n      padding-top: 11px;\n      border-top: 1px solid rgba(77, 230, 255, .10);\n      color: var(--dim);\n      font-size: 11px;\n      letter-spacing: .04em;\n    }\n\n    #chassis-sketches .cs-footer strong { color: var(--cyan); font-weight: 500; }\n\n    @media (max-width: 760px) {\n      #chassis-sketches .cs-grid { grid-template-columns: 1fr; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      #chassis-sketches .cs-scan { animation: none; display: none; }\n    }\n  </style>\n\n  <svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n    <defs>\n      <symbol id=\"cs-bot\" viewBox=\"0 0 120 180\">\n        <ellipse cx=\"60\" cy=\"174\" rx=\"30\" ry=\"5\" fill=\"currentColor\" opacity=\".16\"/>\n        <rect x=\"44\" y=\"48\" width=\"32\" height=\"56\" rx=\"8\" fill=\"currentColor\" opacity=\".92\"/>\n        <rect x=\"51\" y=\"59\" width=\"18\" height=\"8\" rx=\"2\" fill=\"#071018\" opacity=\".8\"/>\n        <circle cx=\"60\" cy=\"29\" r=\"17\" fill=\"currentColor\"/>\n        <rect x=\"48\" y=\"25\" width=\"24\" height=\"7\" rx=\"3\" fill=\"#071018\" opacity=\".9\"/>\n        <rect x=\"57\" y=\"7\" width=\"6\" height=\"8\" rx=\"2\" fill=\"currentColor\" opacity=\".8\"/>\n        <rect x=\"26\" y=\"51\" width=\"12\" height=\"43\" rx=\"6\" fill=\"currentColor\" opacity=\".78\"/>\n        <rect x=\"82\" y=\"51\" width=\"12\" height=\"43\" rx=\"6\" fill=\"currentColor\" opacity=\".78\"/>\n        <rect x=\"44\" y=\"104\" width=\"12\" height=\"48\" rx=\"5\" fill=\"currentColor\" opacity=\".82\"/>\n        <rect x=\"64\" y=\"104\" width=\"12\" height=\"48\" rx=\"5\" fill=\"currentColor\" opacity=\".82\"/>\n        <rect x=\"39\" y=\"151\" width=\"20\" height=\"8\" rx=\"3\" fill=\"currentColor\" opacity=\".9\"/>\n        <rect x=\"61\" y=\"151\" width=\"20\" height=\"8\" rx=\"3\" fill=\"currentColor\" opacity=\".9\"/>\n        <rect x=\"33\" y=\"56\" width=\"8\" height=\"13\" rx=\"3\" fill=\"currentColor\" opacity=\".95\"/>\n        <rect x=\"79\" y=\"56\" width=\"8\" height=\"13\" rx=\"3\" fill=\"currentColor\" opacity=\".95\"/>\n      </symbol>\n    </defs>\n  </svg>\n\n  <div class=\"cs-head\">\n    <h3>Выбор корпуса — 4 направления</h3>\n    <p>сейчас: три тяжёлые карточки · робот мелкий · много пустого места</p>\n  </div>\n\n  <div class=\"cs-grid\">\n    <section class=\"cs-option cs-a\" aria-label=\"Вариант A: три голографических подиума\">\n      <div class=\"cs-option-head\">\n        <span class=\"cs-badge\">A</span>\n        <div><b>Три подиума</b><span>роботы на отдельных подиумах, вместо карточек — тонкие подписи</span></div>\n      </div>\n      <div class=\"cs-stage\">\n        <span class=\"cs-stage-mark\">COLONY 07</span>\n        <span class=\"cs-stage-count\">01 / 03</span>\n        <span class=\"cs-locked\">MODULAR / LOCKED</span>\n        <span class=\"cs-scan\"></span>\n\n        <div class=\"cs-podium\" style=\"color:#5b8cff\">\n          <span class=\"cs-beam\"></span>\n          <svg class=\"cs-bot\" viewBox=\"0 0 120 180\"><use href=\"#cs-bot\"/></svg>\n          <span class=\"cs-ring\"></span>\n          <div class=\"cs-plate\"><span class=\"cs-id\">01</span><b>POLAR MECHANIC</b><small>УНИВЕРСАЛ</small></div>\n        </div>\n\n        <div class=\"cs-podium selected\" style=\"color:#ff6b5e\">\n          <span class=\"cs-beam\"></span>\n          <svg class=\"cs-bot\" viewBox=\"0 0 120 180\"><use href=\"#cs-bot\"/></svg>\n          <span class=\"cs-ring\"></span>\n          <div class=\"cs-plate\"><span class=\"cs-id\">02</span><b>COURIER</b><small>ЛЁГКИЙ КУРЬЕР</small></div>\n        </div>\n\n        <div class=\"cs-podium\" style=\"color:#5fd39a\">\n          <span class=\"cs-beam\"></span>\n          <svg class=\"cs-bot\" viewBox=\"0 0 120 180\"><use href=\"#cs-bot\"/></svg>\n          <span class=\"cs-ring\"></span>\n          <div class=\"cs-plate\"><span class=\"cs-id\">03</span><b>PIPEWRIGHT</b><small>ТЯЖЁЛЫЙ РЕМОНТНИК</small></div>\n        </div>\n\n        <span class=\"cs-cta right\">ПОДТВЕРДИТЬ</span>\n      </div>\n      <div class=\"cs-note\"><strong>Плюс:</strong> все три корпуса видны сразу, роботы крупнее. <strong>Минус:</strong> статистика уходит в мелкие подписи.</div>\n    </section>\n\n    <section class=\"cs-option cs-b\" aria-label=\"Вариант B: центральная витрина\">\n      <div class=\"cs-option-head\">\n        <span class=\"cs-badge\">B</span>\n        <div><b>Центральная витрина</b><