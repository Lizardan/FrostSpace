8	namespace FrostSpace.Tests
9	{
10	    /// <summary>
11	    /// Проверяет стартовый контент в <c>Content/Data/Dialogues</c>: графы без ошибок,
12	    /// ветвление и концовки на месте, реплики на русском. Список берётся из папки,
13	    /// поэтому новый диалог попадает под проверку без правки теста.
