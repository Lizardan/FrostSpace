, progress = log.Progress, speakerDialogue = speaker.Dialogue != null ? speaker.Dialogue.name : \"none\", canTalk = speaker.CanTalk });\nreturn result;\n'''\nwith Bridge(port=6401) as b:\n    print(json.dumps(b.call('execute_code', {'action': 'execute', 'code': code}), ensure_ascii=False, indent=2)[:8000])\nPY",
