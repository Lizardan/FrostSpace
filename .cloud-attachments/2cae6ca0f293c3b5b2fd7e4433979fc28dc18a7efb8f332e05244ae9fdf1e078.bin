374	        private void BuildInterface()
375	        {
376	            _root = new GameObject("PauseCanvas", typeof(RectTransform));
377	            _root.transform.SetParent(transform, false);
378	
379	            var canvas = _root.AddComponent<Canvas>();
380	            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
381	            canvas.sortingOrder = 50;
382	
383	            var scaler = _root.AddComponent<CanvasScaler>();
384	            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
385	            scaler.referenceResolution = new Vector2(1920f, 1080f);
386	            scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
387	            scaler.matchWidthOrHeight = 0.5f;
388	
389	            _root.AddComponent<GraphicRaycaster>();
390	
391	            var shade = NewImage(_root.transform, "Shade", _shadeColor);
392	            Stretch(shade.rectTransform);
393	
394	            BuildMenuPanel(_root.transform);
395	        }
