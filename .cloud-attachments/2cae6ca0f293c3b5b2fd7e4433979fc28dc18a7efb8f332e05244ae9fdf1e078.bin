480	
481	        private static TextMeshProUGUI NewText(
482	            Transform parent, string name, string content, float size, Color color,
483	            TextAlignmentOptions alignment, Vector2 anchor, Vector2 position, Vector2 boxSize, float spacing)
484	        {
485	            var go = new GameObject(name, typeof(RectTransform));
486	            go.transform.SetParent(parent, false);
487	            var rect = (RectTransform)go.transform;
488	            rect.anchorMin = anchor;
489	            rect.anchorMax = anchor;
490	            rect.pivot = new Vector2(
491	                anchor.x <= 0f ? 0f : anchor.x >= 1f ? 1f : 0.5f,
492	                anchor.y <= 0f ? 0f : anchor.y >= 1f ? 1f : 0.5f);
493	            rect.sizeDelta = boxSize;
494	            rect.anchoredPosition = position;
495	
496	            var text = go.AddComponent<TextMeshProUGUI>();
497	            if (TMP_Settings.defaultFontAsset != null)
498	                text.font = TMP_Settings.defaultFontAsset;
499	            text.text = content;
500	            text.fontSize = size;
501	            text.color = color;
502	            text.alignment = alignment;
503	            text.characterSpacing = spacing;
504	            text.textWrappingMode = TextWrappingModes.NoWrap;
505	            text.raycastTarget = false;
506	            return text;
507	        }
508	    }
