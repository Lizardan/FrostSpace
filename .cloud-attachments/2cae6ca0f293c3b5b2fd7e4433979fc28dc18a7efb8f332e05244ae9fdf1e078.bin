180	        private void OnSettingsPressed()
181	        {
182	            var open = !_settingsPanel.activeSelf;
183	            _settingsPanel.SetActive(open);
184	            _menuPanel.SetActive(!open);
185	
186	            if (open)
187	                RefreshSwitches();
188	        }
189	
190	        private void OnMainMenuPressed()
191	        {
192	            // Сначала снимаем паузу: SceneController грузит сцену в реальном времени,
193	            // но следующая сцена не должна получить timeScale = 0.
194	            Resume();
195	
196	            var controller = SceneController.Instance;
197	            if (controller == null)
198	            {
199	                Debug.LogError("PauseMenuScreen: нет SceneController — переход в меню невозможен", this);
200	                return;
201	            }
202	
203	            controller.LoadScene(_mainMenuScene);
204	        }
