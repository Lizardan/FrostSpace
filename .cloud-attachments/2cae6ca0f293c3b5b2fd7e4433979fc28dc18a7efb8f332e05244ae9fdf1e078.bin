684	        {
685	            var button = NewButton(parent, "Back", "НАЗАД", Vector2.zero, OnBackPressed, 160f, 20f);
686	            var rect = (RectTransform)button.transform;
687	            rect.anchorMin = new Vector2(0f, 0f);
