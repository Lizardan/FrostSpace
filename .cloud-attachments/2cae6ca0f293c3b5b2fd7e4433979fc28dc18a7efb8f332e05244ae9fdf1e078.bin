Let's inspect lowpoly.MeshBuilder tube API to build wheels.

#### Tool: Bash

**Input:**

```json
{
  "command": "grep -n \"def tube\\|def box\\|def beveled_box\\|def add_geometry\" Tools/Blender/lowpoly.py | head; sed -n '/def tube/,/def /p' Tools/Blender/lowpoly.py | head -80",
  "description": "Inspect tube API"
}
```

**Response:**

90:def beveled_box(center, size, bevel):
250:    def add_geometry(self, verts, faces, mat: int, tags=None) -> None:
259:    def tube(
337:    def box(self, center, size, mat: int, bevel: float = 0.02):
    def tube(
        self,
        points,
        radii,
        mat: int,
        n: int = 8,
        caps=(True, True),
        profile=None,
        ref=(0.0, -1.0, 0.0),
        offsets=None,
        fan_caps: bool = False,
    ):
        """Протянуть кольцо по точкам пути.

        ``radii[i]`` — (rx, ry) в плоскости кольца; ``offsets[i]`` — сдвиг
        центра кольца в его же локальных осях (нужно, чтобы поджать низ
        торса вперёд, а не двигать всю трубу).

        ``fan_caps`` — закрывать торец веером треугольников вместо одного
        n-угольника. Нужно там, где действует правило «без n-гонов»: n-гон
        на торце всё равно триангулируется при экспорте, но делает это
        экспортёр, и результат не виден в отчёте по мешу.
        """
        prof = profile if profile is not None else poly_profile(n)
        pts = [Vector(p) for p in points]
        rings = []
        for i, p in enumerate(pts):
            if i == 0:
                d = pts[1] - pts[0]
            elif i == len(pts) - 1:
                d = pts[-1] - pts[-2]
            else:
                d = pts[i + 1] - pts[i - 1]
            right, up = frame(d, ref)
            rx, ry = radii[i]
            shift = Vector((0.0, 0.0, 0.0))
            if offsets is not None:
                ox, oy = offsets[i]
                shift = right * ox + up * oy
            center = p + shift
            rings.append(
                [center + right * (px * rx) + up * (py * ry) for px, py in prof]
            )

        base = len(self.verts)
        for r in rings:
            self.verts.extend(r)
        count = len(prof)
        for a in range(len(rings) - 1):
            for i in range(count):
                j = (i + 1) % count
                self.add_face(
                    (
                        base + a * count + i,
                        base + a * count + j,
                        base + (a + 1) * count + j,
                        base + (a + 1) * count + i,
                    ),
                    mat,
                    "surface",
                )
        if caps[0]:
            if fan_caps:
                for i in range(1, count - 1):
                    self.add_face((base, base + i, base + i + 1), mat, "cap")
            else:
                self.add_face([base + i for i in range(count)], mat, "cap")
        if caps[1]:
            s = base + (len(rings) - 1) * count
            if fan_caps:
                for i in range(1, count - 1):
                    self.add_face((s, s + i, s + i + 1), mat, "cap")
            else:
                self.add_face([s + i for i in range(count)], mat, "cap")
        return rings

