324	def build_cart(materials):
325	    b = level_lib.LevelBuilder(materials)
326	
327	    # Платформа на подушках: низ 0, подушки чуть приподняты.
328	    b.box((0.0, 0.0, 0.35), (2.4, 1.6, 0.3), "Level_Metal", bevel=0.03)
329	    b.box((0.0, 0.0, 0.52), (2.2, 1.4, 0.06), "Level_Rust", bevel=0.01)
330	
331	    # Борта.
332	    for sy in (-1, 1):
333	        b.box((0.0, sy * 0.75, 0.62), (2.4, 0.1, 0.24), "Level_Metal",
334	              bevel=0.01)
335	    for sx in (-1, 1):
336	        b.box((sx * 1.15, 0.0, 0.62), (0.1, 1.6, 0.24), "Level_Metal",
337	              bevel=0.01)
338	
339	    # Четыре гнезда 2×2: приподнятые бортики, оранжевая кромка, тёплая полоса.
340	    for sx in (-1, 1):
341	        for sy in (-1, 1):
342	            cx, cy = sx * 0.55, sy * 0.4
343	            # Дно гнезда темнее платформы.
344	            b.box((cx, cy, 0.53), (1.02, 0.64, 0.04), "Level_WoodDark",
345	                  bevel=0.0)
346	            # Бортики: между гнёздами две стенки образуют разделитель.
347	            for dy in (-1, 1):
348	                b.box((cx, cy + dy * 0.36, 0.63), (1.16, 0.08, 0.16),
349	                      "Level_Metal", bevel=0.01)
350	                b.box((cx, cy + dy * 0.36, 0.72), (1.16, 0.06, 0.06),
351	                      "Level_Orange", bevel=0.0)
352	            for dx in (-1, 1):
353	                b.box((cx + dx * 0.54, cy, 0.63), (0.08, 0.64, 0.16),
354	                      "Level_Metal", bevel=0.01)
355	                b.box((cx + dx * 0.54, cy, 0.72), (0.06, 0.64, 0.06),
356	                      "Level_Orange", bevel=0.0)
357	            # Тёплая полоса по внутренней кромке: гнездо «под напряжением».
358	            for dy in (-1, 1):
359	                b.box((cx, cy + dy * 0.31, 0.66), (0.92, 0.05, 0.06),
360	                      "Level_Window", bevel=0.0)
361	
362	    # Подушки: четыре опоры, без колёс. Оранжевая плита шире подушки —
363	    # читается как тёплый низ, а не как ножка.
364	    for sx in (-1, 1):
365	        for sy in (-1, 1):
366	            b.box((sx * 0.85, sy * 0.55, 0.15), (0.5, 0.4, 0.14),
367	                  "Level_Metal", bevel=0.02)
368	            b.box((sx * 0.85, sy * 0.55, 0.05), (0.58, 0.48, 0.1),
369	                  "Level_Orange", bevel=0.01)
370	
371	    # Бампер со стороны двери: тележку толкают, а не тянут.
372	    b.box((0.0, -0.84, 0.4), (2.2, 0.12, 0.18), "Level_Rust", bevel=0.01)
373	    b.box((0.0, -0.9, 0.4), (2.0, 0.06, 0.08), "Level_Orange", bevel=0.0)
374	
375	    # Ручка и пульт со стороны +Y.
376	    for sx in (-1, 1):
377	        b.tube([(sx * 0.7, 0.78, 0.5), (sx * 0.7, 0.9, 0.95),
378	                (sx * 0.7, 0.9, 1.1)], [(0.06, 0.06)] * 3, "Level_Metal", n=6)
379	    b.tube([(-0.7, 0.9, 1.1), (0.7, 0.9, 1.1)], [(0.06, 0.06)] * 2,
380	           "Level_Metal", n=6)
381	
382	    b.box((0.0, 0.8, 0.6), (0.3, 0.14, 0.2), "Level_Metal", bevel=0.01)
383	    b.box_rot((0.0, 0.8, 0.78), (0.5, 0.16, 0.26), (-20.0, 0.0, 0.0),
384	              "Level_Rust", bevel=0.02)
385	    b.box_rot((0.0, 0.73, 0.83), (0.32, 0.05, 0.14), (-20.0, 0.0, 0.0),
386	              "Level_Window", bevel=0.0)
387	
388	    return b.build("Prop_GravCart")
389	
390	
391	# ------------------------------------------------------------------ сборка
392	
393	def main() -> int:
394	    level_lib.configure_stdout()
395	    print("Blender", bpy.app.version_string)
396	
397	    jobs = (
398	        ("TrainInterior", build_interior),
399	        ("Prop_Battery", build_battery),
400	        ("Prop_GravCart", build_cart),
401	    )
402	    total = 0
403	    for name, builder in jobs:
404	        level_lib.clear_scene()
405	        materials = level_lib.make_level_materials()
406	        objs = builder(materials)
407	        if not isinstance(objs, list):
408	            objs = [objs]
409	        total += level_lib.report(objs)
410	        level_lib.export_static(objs, os.path.join(OUT, name + ".fbx"))
411	        for obj in objs:
412	            bpy.data.objects.remove(obj, do_unlink=True)
413	
414	    print("BUILT train assets tris=%d" % total)
415	    return 0
416	
417	
418	if __name__ == "__main__":
419	    try:
420	        sys.exit(main())
421	    except Exception:  # noqa: BLE001
422	        traceback.print_exc()
423	        sys.exit(1)
