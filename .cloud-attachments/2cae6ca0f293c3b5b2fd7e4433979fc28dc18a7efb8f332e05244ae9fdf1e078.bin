{
  "content": "var folder = \"Assets/_Project/Content/Data/Dialogues\";\n\nvar guard = UnityEngine.ScriptableObject.CreateInstance<FrostSpace.Features.Dialogue.DialogueAsset>();\nvar g1 = guard.AddNode(\"Стой. Груз с поезда — под наблюдением. Руки держи свободными.\");\nvar g2 = guard.AddNode(\"Порядок простой: по платформе ходи, к воротам без пропуска не подходи.\");\nvar g3 = guard.AddNode(\"Тогда иди к навесу. R7 у стены, он выдаёт допуск. И не задерживайся.\");\nvar g4 = guard.AddNode(\"Депо закрыто на ночь. Ветер, тишина и лишние стволы — вот что здесь происходит. Иди к R7.\");\ng1.SetNextId(g2.Id);\ng2.AddChoice(\"Я курьер. Мне нужно к R7.\", g3.Id);\ng2.AddChoice(\"Что здесь происходит?\", g4.Id);\nUnityEditor.AssetDatabase.CreateAsset(guard, folder + \"/FrontierGuard_Warning.asset\");\n\nvar bulwark = UnityEngine.ScriptableObject.CreateInstance<FrostSpace.Features.Dialogue.DialogueAsset>();\nvar b1 = bulwark.AddNode(\"Дальше — ворота и дорога. Закрыто до распоряжения.\");\nvar b2 = bulwark.AddNode(\"За метелью не видно, кто идёт. Я проверяю каждого, кто возвращается.\");\nvar b3 = bulwark.AddNode(\"Пропуск — у R7. Без него я не открою створ.\");\nvar b4 = bulwark.AddNode(\"Тогда сначала к R7. Пока он не подтвердит — стой здесь.\");\nvar b5 = bulwark.AddNode(\"R7 у навеса. Он ведёт снабжение и знает, кого пускать. Больше вопросов нет.\");\nb1.SetNextId(b2.Id);\nb2.SetNextId(b3.Id);\nb3.AddChoice(\"Мне нужен пропуск.\", b4.Id);\nb3.AddChoice(\"Кто выдаёт пропуск?\", b5.Id);\nUnityEditor.AssetDatabase.CreateAsset(bulwark, folder + \"/FrontierBulwark_Warning.asset\");\n\nvar dispatcher = UnityEngine.ScriptableObject.CreateInstance<FrostSpace.Features.Dialogue.DialogueAsset>();\nvar d1 = dispatcher.AddNode(\"Ты с поезда? Целый — уже хорошо. Я R7, держу снабжение депо.\");\nvar d2 = dispatcher.AddNode(\"Держи карту. Дорога одна — на север, к станции Север-7. Без неё в метель не выйдешь.\");\nvar d3 = dispatcher.AddNode(\"И сканер. Охрана пропускает только тех, кого видит на приборе.\");\nvar d4 = dispatcher.AddNode(\"Тележку оставь на платформе. Дальше её повезут другие.\");\nvar d5 = dispatcher.AddNode(\"Отдохни, осмотрись. Когда будешь готов — ворота откроют. Дорога ждёт.\");\nvar d6 = dispatcher.AddNode(\"Формально — я. Фактически — тот, кто ещё не замолчал. Сейчас это R13. Иди, осмотрись.\");\nd1.SetNextId(d2.Id);\nd2.SetNextId(d3.Id);\nd2.SetAction(FrostSpace.Features.Dialogue.DialogueAction.GrantMap, \"\");\nd3.SetNextId(d4.Id);\nd3.SetAction(FrostSpace.Features.Dialogue.DialogueAction.GrantScanner, \"\");\nd4.AddChoice(\"Что дальше?\", d5.Id);\nd4.AddChoice(\"Кто здесь главный?\", d6.Id);\nUnityEditor.AssetDatabase.CreateAsset(dispatcher, folder + \"/FrontierDispatcher_Meet.asset\");\n\nUnityEditor.AssetDatabase.SaveAssets();\nUnityEditor.AssetDatabase.Refresh();\n\nvar report = new System.Text.StringBuilder();\nstring[] paths = { folder + \"/FrontierGuard_Warning.asset\", folder + \"/FrontierBulwark_Warning.asset\", folder + \"/FrontierDispatcher_Meet.asset\" };\nforeach (var p in paths)\n{\n    var asset = UnityEditor.AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(p);\n    var errors = new System.Collections.Generic.List<string>();\n    var warnings = new System.Collections.Generic.List<string>();\n    if (asset == null) { report.AppendLine(p + \" MISSING\"); continue; }\n    asset.CollectProblems(errors, warnings);\n    report.AppendLine(p + \" nodes=\" + asset.Nodes.Count + \" errors=\" + errors.Count + \" warnings=\" + warnings.Count);\n    foreach (var e in errors) report.AppendLine(\"  ERR \" + e);\n    foreach (var w in warnings) report.AppendLine(\"  WARN \" + w);\n}\nreturn report.ToString();\n",
  "file_path": "F:\\Unity Projects\\FrostSpace\\Temp\\make_dialogues.cs"
}
