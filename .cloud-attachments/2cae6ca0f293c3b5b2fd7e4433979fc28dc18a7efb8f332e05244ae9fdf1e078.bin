**Response:**

"""Ядро сборки статических low-poly ассетов уровня FrostSpace.

Палитра — те же цвета, что у существующих Unity-материалов
`Assets/_Project/Content/Materials/Level/Level_*.mat` (сняты из ассетов и
переведены из линейного пространства в sRGB-hex). Имена меш-материалов
совпадают с именами ассетов один-в-один: импортный постпроцессор уровня
подставляет существующий материал вместо созданного при импорте FBX.

Оси — как в `lowpoly.py`: вверх +Z, вбок +X. При выгрузке `export_static`
зеркалит геометрию по X: сам `bake_space_transform` в Unity даёт
преобразование (x, y, z) = (−X, Z, −Y), то есть разворот на 180° со сменой
знака по горизонтали (проверено по импортированному мешу: камни фундамента
и занос рельефа оказывались в противоположных четвертях). После зеркала
работает ожидаемая смена осей: Blender +X → Unity +X, Blender +Y → Unity −Z,
Blender +Z → Unity +Y.

Поэтому дом `SnowCabin` рисуется входом в Blender +Y — в Unity это −Z (юг,
к точке спавна), префаб ставится без поворота, — а раскладка
`level_layout` задаётся прямо в координатах Unity.
"""

from __future__ import annotations

import math
import os
import sys

import bmesh
import bpy
from mathutils import Euler, Vector

import lowpoly

# ---------------------------------------------------------------- палитра

#: Имя = имя ассета Unity `Level_<Name>.mat`.
#: (sRGB hex, roughness, metallic, emission_strength)
MATERIALS = {
    "Level_Wood": ("#7A5334", 0.72, 0.00, 0.0),
    "Level_WoodDark": ("#432E20", 0.68, 0.00, 0.0),
    "Level_Roof": ("#5A4034", 0.70, 0.00, 0.0),
    "Level_Snow": ("#E4EDF6", 0.82, 0.00, 0.0),
    "Level_SnowDeep": ("#C9D8E6", 0.78, 0.00, 0.0),
    # Лёд: светлее глубокого снега и с сильным бликом, чтобы дорога читалась
    # поверх снега не цветом, а отражением.
    "Level_Ice": ("#A9DCEA", 0.16, 0.00, 0.0),
    "Level_Pine": ("#244534", 0.65, 0.00, 0.0),
    "Level_PineSnow": ("#DCE7F1", 0.78, 0.00, 0.0),
    "Level_Stone": ("#4C5158", 0.40, 0.00, 0.0),
    "Level_Metal": ("#98A3AF", 0.55, 0.85, 0.0),
    "Level_Rust": ("#8C4A32", 0.35, 0.20, 0.0),
    "Level_Orange": ("#E08A2E", 0.60, 0.00, 0.0),
    "Level_Window": ("#FFC978", 0.65, 0.00, 2.2),
}


def _principled(mat):
    for node in mat.node_tree.nodes:
        if node.type == "BSDF_PRINCIPLED":
            return node
    return None


def make_level_materials() -> dict:
    """Создать все материалы палитры уровня: имя → материал."""
    made = {}
    for name, (hex_color, roughness, metallic, emission) in MATERIALS.items():
        mat = lowpoly.make_material(name, hex_color, roughness=roughness,
                                    metallic=metallic)
        if emission > 0.0:
            bsdf = _principled(mat)
            if bsdf is not None:
                color = bsdf.inputs.get("Emission Color")
                strength = bsdf.inputs.get("Emission Strength")
                if color is not None:
                    color.default_value = lowpoly.hex_to_linear(hex_color)
                if strength is not None:
                    strength.default_value = emission
        made[name] = mat
    return made


# ---------------------------------------------------------------- служебное


def configure_stdout() -> None:
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, OSError):
            pass


def clear_scene() -> None:
    for obj in list(bpy.data.objects):
        bpy.data.objects.remove(obj, do_unlink=True)
    for block in (bpy.data.meshes, bpy.data.materials, bpy.data.cameras,
                  bpy.data.lights, bpy.data.armatures, bpy.data.actions):
        for item in list(block):
            block.remove(item)


def rotate_verts(verts, center, rot_deg):
    """Повернуть точки вокруг центра (градусы, XYZ, как во вьюпорте)."""
    if rot_deg is None:
        return verts
    matrix = Euler(tuple(math.radians(a) for a in rot_deg), "XYZ").to_matrix()
    c = Vector(center)
    return [c + matrix @ (Vector(v) - c) for v in verts]


def smoothstep(edge0: float, edge1: float, value: float) -> float:
    t = min(max((value - edge0) / (edge1 - edge0), 0.0), 1.0)
    return t * t * (3.0 - 2.0 * t)


def value_noise(x: float, y: float, seed: float = 0.0) -> float:
    """Детерминированный шум [0, 1) по узлу сетки — без внешних зависимостей."""
    v = math.sin(x * 127.1 + y * 311.7 + seed * 74.7) * 43758.5453
    return v - math.floor(v)


def noise2d(x: float, y: float, seed: float = 0.0) -> float:
    """Плавный интерполированный шум [-1, 1] из решётки 2×2."""
    xi, yi = math.floor(x), math.floor(y)
    xf, yf = x - xi, y - yi
    u = xf * xf * (3.0 - 2.0 * xf)
    v = yf * yf * (3.0 - 2.0 * yf)
    a = value_noise(xi, yi, seed)
    b = value_noise(xi + 1, yi, seed)
    c = value_noise(xi, yi + 1, seed)
    d = value_noise(xi + 1, yi + 1, seed)
    return 2.0 * ((a * (1 - u) + b * u) * (1 - v) + (c * (1 - u) + d * u) * v) - 1.0


# ------------------------------------------------------------- сборщик


class LevelBuilder:
    """MeshBuilder с палитрой: материалы задаются именем, индексы локальные.
---
        "previews": [_step("render_mech_previews.py", "file",
                           ["--out", PREVIEWS + "/Mechs"]),
                     _step("render_gait_strip.py", "file",
                           ["--clip", "Walk", "--frames", "8",
                            "--out", PREVIEWS + "/Gait"])],
        "checks": [_step("check_mech_clips.py", "file")],
    },
    "level": {
        "script": "build_level.py",
        "outputs": [
            MODELS + "/Level/SnowTerrain.fbx",
            MODELS + "/Level/SnowCabin.fbx",
            MODELS + "/Level/Tree_Pine_*.fbx",
            MODELS + "/Level/Prop_*.fbx",
        ],
        "previews": [_step("render_level_previews.py", "none",
                           ["--out", PREVIEWS + "/Level"])],
        "checks": [],
    },
    "train": {
        "script": "build_train.py",
        "outputs": [
            MODELS + "/Train/TrainInterior.fbx",
            MODELS + "/Train/Prop_Battery.fbx",
            MODELS + "/Train/Prop_GravCart.fbx",
        ],
        # Вагон снимается изнутри: снаружи видна только коробка. Пропы —
        # обычные четыре вида, как у транспорта.
        "previews": [_step("render_train_previews.py", "file",
                           ["--out", PREVIEWS + "/Train"])],
        "checks": [_step("check_train.py", "file")],
    },
    "hoverbike": {
        "script": "build_hoverbike.py",
        "outputs": [MODELS + "/Level/Hoverbike.fbx"],
        "previews": [_step("render_ride_previews.py", "file",
                           ["--out", PREVIEWS + "/Ride"])],
        "checks": [],
    },
    "motorcycle": {
        "script": "build_motorcycle.py",
        "outputs": [MODELS + "/Level/Motorcycle.fbx"],
        "previews": [_step("render_ride_previews.py", "file",
                           ["--out", PREVIEWS + "/Ride"])],
        "checks": [],
    },
---
"""Рендерит превью вагона и груза: изнутри, от двери и снаружи.

Запуск (штатно — из `build_all.py`, per = file):

    blender --background --factory-startup --python Tools/Blender/render_train_previews.py -- \
        "Assets/_Project/Content/Models/Level/TrainInterior.fbx" --out AssetSource/Previews/Train

Для вагона камера ставится внутрь: снаружи видна только коробка, а проверять
нужно окна, потолок, дверь и пропорции. Для пропов — четыре общих вида, как у
транспорта. Workbench выбран по той же причине: быстрый headless-рендер
faceted-силуэта и материал-цветов без GPU-контекста.
"""

from __future__ import annotations

import os
import sys
import traceback

import bpy
from mathutils import Vector


def configure_stdout() -> None:
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, OSError):
            pass


def reset() -> None:
    for obj in list(bpy.data.objects):
        bpy.data.objects.remove(obj, do_unlink=True)
    for block in (bpy.data.meshes, bpy.data.materials, bpy.data.cameras,
                  bpy.data.lights):
        for item in list(block):
            block.remove(item)


def add_ground() -> None:
    mesh = bpy.data.meshes.new("PreviewGround")
    mesh.from_pydata([(-20, -20, 0), (20, -20, 0), (20, 20, 0), (-20, 20, 0)],
                     [], [(0, 1, 2, 3)])
    mesh.update()
    obj = bpy.data.objects.new("PreviewGround", mesh)
    bpy.context.scene.collection.objects.link(obj)
    mat = bpy.data.materials.new("PreviewSnow")
    if mat.node_tree is None:
        mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs["Base Color"].default_value = (0.72, 0.80, 0.88, 1)
        bsdf.inputs["Roughness"].default_value = 0.9
    mat.diffuse_color = (0.72, 0.80, 0.88, 1)
    mesh.materials.append(mat)


def model_bounds() -> tuple[Vector, Vector]:
    lo = Vector((1e9, 1e9, 1e9))
    hi = Vector((-1e9, -1e9, -1e9))
    for obj in bpy.context.scene.objects:
        if obj.type != "MESH" or obj.name == "PreviewGround":
            continue
        for corner in obj.bound_box:
            world = obj.matrix_world @ Vector(corner)
            lo = Vector((min(lo.x, world.x), min(lo.y, world.y),
                         min(lo.z, world.z)))
            hi = Vector((max(hi.x, world.x), max(hi.y, world.y),
                         max(hi.z, world.z)))
    return lo, hi


def add_camera(name: str, location: Vector, target: Vector, lens: float = 60.0):
    cam_data = bpy.data.cameras.new(name)
    cam_data.lens = lens
    cam = bpy.data.objects.new(name, cam_data)
    bpy.context.scene.collection.objects.link(cam)
    cam.location = location
    cam.rotation_euler = (target - location).to_track_quat("-Z", "Y").to_euler()
    return cam


def setup_render() -> None:
    scene = bpy.context.scene
    scene.render.resolution_x = 1100
    scene.render.resolution_y = 700
    scene.render.resolution_percentage = 100
    scene.render.image_settings.file_format = "PNG"
    scene.render.film_transparent = False
    if scene.world is None:
        scene.world = bpy.data.worlds.new("PreviewWorld")
    scene.world.color = (0.60, 0.70, 0.80)

    scene.render.engine = "BLENDER_WORKBENCH"
    shading = scene.display.shading
    shading.light = "STUDIO"
    shading.studio_light = "paint.sl"
    shading.color_type = "MATERIAL"
    shading.show_shadows = True
    shading.show_cavity = True
    shading.cavity_type = "BOTH"
    shading.curvature_ridge_factor = 1.4
    shading.curvature_valley_factor = 1.1
    shading.show_specular_highlight = True
    scene.display.render_aa = "16"


def render_to(path: str) -> None:
    bpy.context.scene.render.filepath = path
    bpy.ops.render.render(write_still=True)
    print("RENDER", path)


