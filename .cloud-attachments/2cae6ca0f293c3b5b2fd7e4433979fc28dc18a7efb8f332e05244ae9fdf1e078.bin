53	        private Image[][] _cardBorders;
54	        private Button _confirm;
55	        private int _selected = -1;
56	
57	        private void Awake()
58	        {
59	            EnsureEventSystem();
60	            ReadCatalog();
61	            BuildInterface();
62	            SelectInitial();
63	            ShowCursor();
64	        }
65	
66	        private void Update()
67	        {
68	            var controller = SceneController.Instance;
69	            var busy = controller != null && controller.IsBusy;
70	            _confirm.interactable = !busy && _selected >= 0;
71	
72	            // Меню не должно перелистываться под руками на переходе.
73	            if (!busy && Keyboard.current != null)
74	            {
75	                for (var i = 0; i < _cards.Length && i < 9; i++)
76	                {
77	                    if (!Keyboard.current[(Key)((int)Key.Digit1 + i)].wasPressedThisFrame)
78	                        continue;
79	
80	                    Select(i);
81	                    break;
82	                }
83	            }
84	        }
85	
86	        private void OnDisable()
87	        {
88	            PlayerPrefs.Save();
89	        }
90	
91	        private void ReadCatalog()
92	        {
93	            _profiles = _catalog != null
94	                ? _catalog.Profiles
95	                : System.Array.Empty<RobotProfile>();
96	
97	            if (_profiles.Length == 0)
98	                Debug.LogError("CharacterSetupScreen: каталог пуст — выбирать нечего", this);
99	        }
100	
101	        private void SelectInitial()
102	        {
103	            var current = CharacterSelection.Resolve(_catalog);
104	            var index = 0;
105	            for (var i = 0; i < _profiles.Length; i++)
106	            {
107	                if (_profiles[i] == current)
108	                {
109	                    index = i;
110	                    break;
111	                }
112	            }
113	
114	            if (_profiles.Length > 0)
115	                Select(index);
116	        }
117	
118	        private void Select(int index)
119	        {
120	            if (_profiles == null || index < 0 || index >= _profiles.Length)
121	                return;
122	
123	            _selected = index;
124	
125	            for (var i = 0; i < _cards.Length; i++)
126	            {
127	                var selected = i == index;
128	
129	                if (_cardMarkers[i] != null)
130	                    _cardMarkers[i].gameObject.SetActive(selected);
131	
132	                if (_cardLines[i] != null)
133	                {
134	                    var color = selected ? _accent : _dim;
135	                    color.a = selected ? 1f : 0.35f;
136	                    _cardLines[i].color = color;
137	                }
138	
139	                if (_cardBorders[i] != null)
140	                {
141	                    var border = selected
142	                        ? new Color(_accent.r, _accent.g, _accent.b, 0.85f)
143	                        : new Color(_accent.r, _accent.g, _accent.b, 0.16f);
144	                    foreach (var edge in _cardBorders[i])
145	                        edge.color = border;
146	                }
147	            }
148	
149	            Debug.Log($"[CharacterSetupScreen] выбран {_profiles[index].Id}", this);
150	        }
151	
152	        private void OnConfirmPressed()
153	        {
154	            if (_selected < 0)
155	                return;
156	
157	            var profile = _profiles[_selected];
158	            CharacterSelection.Select(profile);
159	
160	            var controller = SceneController.Instance;
161	            if (controller == null)
162	            {
163	                Debug.LogError(
164	                    "CharacterSetupScreen: нет SceneController — переход невозможен", this);
165	                return;
166	            }
167	
168	            controller.LoadScene(_nextScene);
169	        }
170	
171	        private void ShowCursor()
172	        {
173	            Cursor.lockState = CursorLockMode.None;
174	            Cursor.visible = true;
175	        }
176	
177	        private void EnsureEventSystem()
178	        {
179	            if (EventSystem.current != null)
180	                return;
181	
182	            var go = new GameObject("EventSystem", typeof(EventSystem));
183	            var module = go.AddComponent<InputSystemUIInputModule>();
184	            module.AssignDefaultActions();
185	        }
186	
187	        private void BuildInterface()
188	        {
189	            var canvasObject = new GameObject("CharacterCanvas", typeof(RectTransform));
190	            canvasObject.transform.SetParent(transform, false);
191	            var canvas = canvasObject.AddComponent<Canvas>();
192	            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
193	            canvas.sortingOrder = 5;
194	
195	            var scaler = canvasObject.AddComponent<CanvasScaler>();
196	            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
197	            scaler.referenceResolution = new Vector2(1920f, 1080f);
198	            scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
199	            scaler.matchWidthOrHeight = 0.5f;
200	
201	            canvasObject.AddComponent<GraphicRaycaster>();
202	            var root = canvasObject.transform;
203	
204	            var backdropObject = new GameObject("Backdrop", typeof(RectTransform));
205	            backdropObject.transform.SetParent(root, false);
206	            var backdropRect = (RectTransform)backdropObject.transform;
207	            backdropRect.anchorMin = Vector2.zero;
208	            backdropRect.anchorMax = Vector2.one;
209	            backdropRect.offsetMin = Vector2.zero;
210	            backdropRect.offsetMax = Vector2.zero;
211	            backdropObject.AddComponent<CharacterBackdrop>().Build();
212	
213	            NewText(root, "Brand", "COLONY 07", 22f, _accent, TextAlignmentOptions.TopLeft,
214	                new Vector2(0f, 1f), new Vector2(96f, -64f), new Vector2(600f, 34f), 18f);
215	
216	            NewText(root, "Title", "SELECT CHASSIS", 64f, _text, TextAlignmentOptions.TopLeft,
217	                new Vector2(0f, 1f), new Vector2(96f, -108f), new Vector2(1000f, 90f), 10f);
218	
219	            NewText(root, "Subtitle", "YOUR FRAME CARRIES THE RUN", 20f, _dim,
220	                TextAlignmentOptions.TopLeft, new Vector2(0f, 1f), new Vector2(96f, -196f),
221	                new Vector2(900f, 30f), 12f);
222	
223	            var accentRule = NewImage(root, "AccentRule", _accent);
224	            var ruleRect = accentRule.rectTransform;
225	            ruleRect.anchorMin = new Vector2(0f, 1f);
226	            ruleRect.anchorMax = new Vector2(0f, 1f);
227	            ruleRect.pivot = new Vector2(0f, 1f);
228	            ruleRect.sizeDelta = new Vector2(64f, 3f);
229	            ruleRect.anchoredPosition = new Vector2(96f, -238f);
230	
231	            NewText(root, "CreateNote", "MODULAR ASSEMBLY  /  LOCKED", 16f, _dim,
232	                TextAlignmentOptions.TopRight, new Vector2(1f, 1f),
233	                new Vector2(-96f, -64f), new Vector2(700f, 26f), 12f);
234	
235	            NewText(root, "Hint", "CLICK A CARD OR PRESS 1 2 3", 18f, _dim,
236	                TextAlignmentOptions.BottomLeft, new Vector2(0f, 0f),
237	                new Vector2(96f, 64f), new Vector2(700f, 28f), 12f);
238	
239	            BuildCards(root);
240	
241	            _confirm = NewButton(root, "Confirm", "CONFIRM", OnConfirmPressed);
242	            var confirmRect = (RectTransform)_confirm.transform;
243	            confirmRect.anchorMin = new Vector2(1f, 0f);
244	            confirmRect.anchorMax = new Vector2(1f, 0f);
245	            confirmRect.pivot = new Vector2(1f, 0f);
246	            confirmRect.sizeDelta = new Vector2(320f, 64f);
247	            confirmRect.anchoredPosition = new Vector2(-96f, 64f);
248	
249	            foreach (var edge in NewBorder(_confirm.transform, 1.5f))
250	                edge.color = new Color(_accent.r, _accent.g, _accent.b, 0.55f);
251	
252	            var create = NewButton(root, "CreateOwn", "CREATE YOUR OWN", null);
253	            var createRect = (RectTransform)create.transform;
254	            createRect.anchorMin = new Vector2(1f, 0f);
255	            createRect.anchorMax = new Vector2(1f, 0f);
256	            createRect.pivot = new Vector2(1f, 0f);
257	            createRect.sizeDelta = new Vector2(320f, 64f);
258	            createRect.anchoredPosition = new Vector2(-96f, 148f);
259	            create.interactable = false;
260	        }
261	
262	        private void BuildCards(Transform root)
263	        {
264	            var count = _profiles != null ? _profiles.Length : 0;
265	            var rowWidth = count * CardWidth + Mathf.Max(0, count - 1) * CardGap;
266	
267	            _cards = new Button[count];
268	            _cardLines = new Image[count];
269	            _cardMarkers = new Image[count];
270	            _cardBorders = new Image[count][];
271	
272	            for (var i = 0; i < count; i++)
273	            {
274	                var profile = _profiles[i];
275	                var offsetX = -rowWidth * 0.5f + CardWidth * 0.5f + i * (CardWidth + CardGap);
276	
277	                var card = new GameObject(profile.Id, typeof(RectTransform));
278	                card.transform.SetParent(root, false);
279	                var rect = (RectTransform)card.transform;
280	                rect.anchorMin = new Vector2(0.5f, 1f);
281	                rect.anchorMax = new Vector2(0.5f, 1f);
282	                rect.pivot = new Vector2(0.5f, 1f);
283	                rect.sizeDelta = new Vector2(CardWidth, CardHeight);
284	                rect.anchoredPosition = new Vector2(offsetX, -CardTop);
285	
286	                var background = card.AddComponent<Image>();
287	                background.color = _cardIdle;
288	
289	                var button = card.AddComponent<Button>();
290	                button.targetGraphic = background;
291	                button.transition = Selectable.Transition.ColorTint;
292	                var colors = button.colors;
293	                colors.normalColor = _cardIdle;
294	                colors.highlightedColor = _cardHover;
295	                colors.pressedColor = _accent;
296	                colors.selectedColor = _cardIdle;
297	                colors.fadeDuration = 0.1f;
298	                button.colors = colors;
299	                var index = i;
300	                button.onClick.AddListener(() => Select(index));
301	
302	                // Превью занимает верх карточки: своя камера и своя текстура.
303	                var previewObject = new GameObject("Preview", typeof(RectTransform));
304	                previewObject.transform.SetParent(card.transform, false);
305	                var previewRect = (RectTransform)previewObject.transform;
306	                previewRect.anchorMin = new Vector2(0f, 1f);
307	                previewRect.anchorMax = new Vector2(1f, 1f);
308	                previewRect.pivot = new Vector2(0.5f, 1f);
309	                previewRect.sizeDelta = new Vector2(0f, PreviewHeight);
310	                previewRect.anchoredPosition = Vector2.zero;
311	
312	                var previewImage = previewObject.AddComponent<RawImage>();
313	                previewImage.raycastTarget = false;
314	                previewImage.color = Color.white;
315	
316	                var preview = previewObject.AddComponent<CharacterCardPreview>();
317	                preview.Show(profile, previewImage, i);
318	
319	                // Линия поверх превью: под ним её закрывала бы картинка модели.
320	                var line = NewImage(card.transform, "TopLine", _dim);
321	                var lineRect = line.rectTransform;
322	                lineRect.anchorMin = new Vector2(0f, 1f);
323	                lineRect.anchorMax = new Vector2(1f, 1f);
324	                lineRect.pivot = new Vector2(0.5f, 1f);
325	                lineRect.sizeDelta = new Vector2(0f, 3f);
326	                lineRect.anchoredPosition = Vector2.zero;
327	
328	                // Тёмная плашка под описанием: текст читается поверх любой модели.
329	                var info = NewImage(card.transform, "Info",
330	                    new Color(0.018f, 0.030f, 0.045f, 0.92f));
331	                var infoRect = info.rectTransform;
332	                infoRect.anchorMin = new Vector2(0f, 0f);
333	                infoRect.anchorMax = new Vector2(1f, 0f);
334	                infoRect.pivot = new Vector2(0.5f, 0f);
335	                infoRect.sizeDelta = new Vector2(0f, CardHeight - PreviewHeight);
336	                infoRect.anchoredPosition = Vector2.zero;
337	
338	                var marker = NewImage(card.transform, "SelectedMarker", _accent);
339	                var markerRect = marker.rectTransform;
340	                markerRect.anchorMin = new Vector2(0f, 0f);
341	                markerRect.anchorMax = new Vector2(0f, 1f);
342	                markerRect.pivot = new Vector2(0f, 0.5f);
343	                markerRect.sizeDelta = new Vector2(6f, 0f);
344	                markerRect.anchoredPosition = Vector2.zero;
345	                marker.gameObject.SetActive(false);
346	
347	                NewText(card.transform, "Index", (i + 1).ToString("00"), 20f, _accent,
348	                    TextAlignmentOptions.TopLeft, new Vector2(0f, 1f),
349	                    new Vector2(20f, -16f), new Vector2(60f, 26f), 12f);
350	
351	                NewText(card.transform, "Name", profile.DisplayName, 28f, _text,
352	                    TextAlignmentOptions.TopLeft, new Vector2(0f, 1f),
353	                    new Vector2(22f, -PreviewHeight - 18f),
354	                    new Vector2(CardWidth - 44f, 40f), 5f);
355	
356	                NewText(card.transform, "Role", profile.Role, 15f, _accent,
357	                    TextAlignmentOptions.TopLeft, new Vector2(0f, 1f),
358	                    new Vector2(22f, -PreviewHeight - 60f),
359	                    new Vector2(CardWidth - 44f, 22f), 14f);
360	
361	                NewText(card.transform, "Stats", StatsLine(profile), 12f, _dim,
362	                    TextAlignmentOptions.TopLeft, new Vector2(0f, 1f),
363	                    new Vector2(22f, -PreviewHeight - 84f),
364	                    new Vector2(CardWidth - 44f, 44f), 4f);
365	
366	                NewText(card.transform, "Description", profile.Description, 13f, _dim,
367	                    TextAlignmentOptions.TopLeft, new Vector2(0f, 0f),
368	                    new Vector2(22f, 16f), new Vector2(CardWidth - 44f, 62f), 3f);
369	
370	                // Рамка последней: иначе превью и плашка перекрывали бы её.
371	                var border = NewBorder(card.transform, 1.5f);
372	
373	                _cards[i] = button;
374	                _cardLines[i] = line;
375	                _cardMarkers[i] = marker;
376	                _cardBorders[i] = border;
377	            }
378	        }
