  "command": "cat > Temp/dump_train.cs <<'EOF'\nvar sb = new System.Text.StringBuilder();\nvar roots = UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects();\nforeach (var go in roots)\n{\n    if (go.name == \"R13_Prospector\" || go.name == \"Prop_GravCart\" || go.name.StartsWith(\"Prop_Battery\"))\n    {\n        sb.AppendLine(\"=== \" + go.name + \" parent=\" + (go.transform.parent != null ? go.transform.parent.name : \"-\") + \" pos=\" + go.transform.position.ToString(\"F3\") + \" rot=\" + go.transform.eulerAngles.ToString(\"F1\") + \" scale=\" + go.transform.localScale.ToString(\"F3\"));\n        foreach (var c in go.GetComponents<UnityEngine.Component>())\n        {\n            sb.AppendLine(\"  \" + c.GetType().Name);\n            if (c is UnityEngine.MonoBehaviour mb)\n            {\n                var so = new UnityEditor.SerializedObject(mb);\n                var it = so.GetIterator();\n                var first = true;\n                while (it.NextVisible(true))\n                {\n                    if (first) { first = false; continue; }\n                    if (it.propertyType == UnityEditor.SerializedPropertyType.ObjectReference)\n                        sb.AppendLine(\"     \" + it.name + \" -> \" + (it.objectReferenceValue != null ? it.objectReferenceValue.name : \"null\"));\n                }\n            }\n        }\n        foreach (var t in go.GetComponentsInChildren<UnityEngine.Transform>(true))\n        {\n            if (t == go.transform) continue;\n            sb.AppendLine(\"    child \" + t.name + \" pos=\" + t.position.ToString(\"F3\") + \" scale=\" + t.lossyScale.ToString(\"F3\"));\n        }\n    }\n}\nreturn sb.ToString();\nEOF\nUNITY_MCP_PORT=6401 python Tools/Unity/unity_bridge.py call execute_code \"$(python -c 'import json; print(json.dumps({\"action\":\"execute\",\"code\":open(\"Temp/dump_train.cs\",encoding=\"utf-8\").read()}))')\" 2>&1 | tail -120",
