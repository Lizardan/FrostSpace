522	            iconRect.anchorMax = new Vector2(0f, 0.5f);
523	            iconRect.pivot = new Vector2(0f, 0.5f);
524	            iconRect.sizeDelta = new Vector2(44f, 44f);
525	            iconRect.anchoredPosition = new Vector2(12f, 0f);
526	
527	            var icon = iconObject.AddComponent<Image>();
528	            icon.sprite = GearSprite;
529	            icon.color = _accent;
530	            icon.preserveAspect = true;
531	            icon.raycastTarget = false;
532	
533	            NewText(go.transform, "Label", "НАСТРОЙКИ", 16f, _text, TextAlignmentOptions.MidlineLeft,
534	                new Vector2(0f, 0.5f), new Vector2(62f, 0f), new Vector2(106f, 26f), 2f);
