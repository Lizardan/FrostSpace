**Input:**

```json
{
  "command": "python - <<'PY'\nimport json, sys\nsys.path.insert(0, 'Tools/Unity')\nfrom unity_bridge import Bridge\ncode = r'''\nvar scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();\nvoid Kill(string name) { var go = GameObject.Find(name); if (go != null) UnityEngine.Object.DestroyImmediate(go); }\nforeach (var n in new[] { \"CabinLamp\", \"TrainInterior\", \"Prop_Battery_1\", \"Prop_Battery_2\", \"Prop_Battery_3\", \"Prop_Battery_4\", \"Prop_GravCart\", \"R13_Prospector\", \"CabinLamp_1\", \"CabinLamp_2\", \"TrainMotionRig\", \"TitleCard\", \"TrainSequence\" }) Kill(n);\n\nvar player = GameObject.Find(\"Player\");\nif (player != null) {\n    foreach (var c in player.GetComponents<Component>()) {\n        var t = c != null ? c.GetType().Name : \"\";\n        if (t == \"QuestDirector\" || t == \"QuestTracker\" || t == \"CarryController\")\n            UnityEngine.Object.DestroyImmediate(c);\n    }\n    player.transform.position = new Vector3(0f, 0.7f, -6f);\n    player.transform.rotation = Quaternion.identity;\n}\n\nUnityEngine.Material Mat(string p) => AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(p);\nUnityEngine.GameObject Prim(UnityEngine.PrimitiveType type, string name, Vector3 pos, Vector3 scale, UnityEngine.Material mat) {\n    var go = UnityEngine.GameObject.CreatePrimitive(type);\n    go.name = name;\n    go.transform.position = pos;\n    go.transform.localScale = scale;\n    var r = go.GetComponent<UnityEngine.Renderer>();\n    if (r != null && mat != null) r.sharedMaterial = mat;\n    return go;\n}\nUnityEngine.GameObject Model(string path, string name, Vector3 pos, Vector3 euler, float scale) {\n    var prefab = AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(path);\n    if (prefab == null) return null;\n    var go = (UnityEngine.GameObject)UnityEditor.PrefabUtility.InstantiatePrefab(prefab);\n    go.name = name;\n    go.transform.position = pos;\n    go.transform.rotation = Quaternion.Euler(euler);\n    go.transform.localScale = Vector3.one * scale;\n    return go;\n}\n\nvar snow = Mat(\"Assets/_Project/Content/Materials/Level/Level_SnowDeep.mat\");\nvar stone = Mat(\"Assets/_Project/Content/Materials/Level/Level_Stone.mat\");\nvar metal = Mat(\"Assets/_Project/Content/Materials/Level/Level_Metal.mat\");\nvar wood = Mat(\"Assets/_Project/Content/Materials/Level/Level_Wood.mat\");\nvar rust = Mat(\"Assets/_Project/Content/Materials/Level/Level_Rust.mat\");\n\nPrim(UnityEngine.PrimitiveType.Plane, \"FrontierSnow\", new Vector3(0f, -0.02f, 0f), new Vector3(20f, 1f, 20f), snow);\nPrim(UnityEngine.PrimitiveType.Cube, \"DepotPlatform\", new Vector3(0f, 0.3f, 0f), new Vector3(30f, 0.6f, 14f), stone);\nPrim(UnityEngine.PrimitiveType.Cube, \"PlatformEdge\", new Vector3(0f, 0.62f, -7.1f), new Vector3(30f, 0.06f, 0.25f), rust);\n// Awning posts and roof\nfor (var x = -1; x <= 1; x += 2) {\n    Prim(UnityEngine.PrimitiveType.Cube, \"AwningPost_L\" + x, new Vector3(x * 10f, 2.8f, 5f), new Vector3(0.25f, 5.2f, 0.25f), metal);\n    Prim(UnityEngine.PrimitiveType.Cube, \"AwningPost_R\" + x, new Vector3(x * 10f, 2.8f, -2f), new Vector3(0.25f, 5.2f, 0.25f), metal);\n}\nPrim(UnityEngine.PrimitiveType.Cube, \"AwningRoof\", new Vector3(0f, 5.45f, 1.5f), new Vector3(22f, 0.22f, 9f), wood);\nPrim(UnityEngine.PrimitiveType.Cube, \"AwningEdge\", new Vector3(0f, 5.3f, 6f), new Vector3(22f, 0.1f, 0.2f), rust);\n\nModel(\"Assets/_Project/Content/Models/Level/MenuTrainTrack.fbx\", \"DepotTrack\", new Vector3(-13f, 0f, 5f), new Vector3(0f, 90f, 0f), 0.25f);\nModel(\"Assets/_Project/Content/Models/Level/MenuFreightTrain.fbx\", \"DepotTrain\", new Vector3(-13f, 0f, 5f), new Vector3(0f, 90f, 0f), 1f);\nModel(\"Assets/_Project/Content/Models/Level/MenuTrainShed.fbx\", \"DepotShed\", new Vector3(0f, 0f, 11f), Vector3.zero, 1f);\nModel(\"Assets/_Project/Content/Models/Level/MenuDepotGate.fbx\", \"DepotGate\", new Vector3(16f, 0f, 13f), new Vector3(0f, -90f, 0f), 0.75f);\nModel(\"Assets/_Project/Content/Models/Level/MenuStationMast.fbx\", \"DepotMast\", new Vector3(19f, 0f, -3f), Vector3.zero, 0.7f);\nModel(\"Assets/_Project/Content/Prefabs/Robots/R16_Warden_Model.prefab\", \"R16_Warden_A\", new Vector3(-5f, 0.7f, 1f), new Vector3(0f, 25f, 0f), 1f);\nModel(\"Assets/_Project/Content/Prefabs/Robots/R16_Warden_Model.prefab\", \"R16_Warden_B\", new Vector3(5f, 0.7f, -2f), new Vector3(0f, -30f, 0f), 1f);\nModel(\"Assets/_Project/Content/Prefabs/Robots/R7_Drifter_Model.prefab\", \"R7_Drifter\", new Vector3(7f, 0.7f, 2f), new Vector3(0f, 200f, 0f), 1f);\n\nvar camGo = GameObject.Find(\"Main Camera\");\nif (camGo != null) {\n    var cam = camGo.GetComponent<UnityEngine.Camera>();\n    if (cam != null) { cam.clearFlags = UnityEngine.CameraClearFlags.SolidColor; cam.backgroundColor = new Color(0.045f, 0.075f, 0.11f, 1f); }\n}\nUnityEngine.RenderSettings.fog = true;\nUnityEngine.RenderSettings.fogMode = UnityEngine.FogMode.ExponentialSquared;\nUnityEngine.RenderSettings.fogDensity = 0.006f;\nUnityEngine.RenderSettings.fogColor = new Color(0.55f, 0.68f, 0.76f, 1f);\nUnityEngine.RenderSettings.ambientMode = UnityEngine.Rendering.AmbientMode.Flat;\nUnityEngine.RenderSettings.ambientLight = new Color(0.26f, 0.34f, 0.42f, 1f);\n\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);\nUnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);\nreturn new { roots = scene.GetRootGameObjects().Length, player = player != null };\n'''\nwith Bridge(port=6401) as b:\n    print(json.dumps(b.call('execute_code', {'action': 'execute', 'code': code}), ensure_ascii=False, indent=2)[:5000])\nPY",
