11	    /// <summary>
12	    /// Экран выбора корпуса между меню и поездом (ADR 0028).
13	    ///
14	    /// Три карточки стоят в ряд, и в каждой своя 3D-модель: отдельная камера
15	    /// рендерит корпус в RenderTexture (<see cref="CharacterCardPreview"/>).
16	    /// Игрок видит всех кандидатов сразу и выбирает карточку, а не листает
17	    /// одного героя кнопками.
18	    ///
19	    /// Модульная сборка («CREATE YOUR OWN») видна, но заблокирована: части
20	    /// роботов — отдельный этап, и кнопка не должна обещать то, чего нет.
21	    ///
22	    /// Геометрия строится кодом, как в меню: Canvas и EventSystem создаются
23	    /// здесь, сцена несёт только фоновую камеру и свет. Строки — латиница,
24	    /// потому что атлас меню без кириллицы.
25	    /// </summary>
26	    [DisallowMultipleComponent]
27	    [DefaultExecutionOrder(150)]
28	    public sealed class CharacterSetupScreen : MonoBehaviour
29	    {
30	        [Header("Данные")]
