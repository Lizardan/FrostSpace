184	        private readonly Dictionary<ScanTarget, Entry> _entries = new(64);
185	        private readonly List<Entry> _visible = new(64);
186	        private readonly List<ScanTarget> _candidates = new(64);
187	        private readonly List<float> _candidateDistance = new(64);
188	        private readonly List<ScanView> _views = new(64);
189	        private readonly Dictionary<ScanTarget, Channel> _flagged = new(64);
190	        private readonly List<ScanTarget> _dead = new(8);
191	
192	        private float _waveProgress = 1f;
193	        private float _scanElapsed;
194	        private ScanTarget _aimTarget;
195	        private ScanTarget _aimCandidate;
196	        private float _aimCandidateSince;
197	        private float _aimLostAt = -1f;
198	        private bool _warnedNoShader;
199	
200	        /// <summary>Режим сонара включён.</summary>
201	        public bool IsScanning { get; private set; }
202	
203	        /// <summary>Цели, которые сейчас видит HUD: прицельная первой, дальше по дистанции.</summary>
204	        public IReadOnlyList<ScanView> Views => _views;
205	
206	        /// <summary>Цель в области прицела — HUD обводит её рамкой.</summary>
207	        public ScanTarget AimTarget => _aimTarget;
208	
209	        /// <summary>Прогресс волны сонара 0..1: HUD подсвечивает индикатор, пока она идёт.</summary>
210	        public float SonarWave => _waveProgress;
211	
212	        /// <summary>Волна ещё идёт — кольцо на земле видно.</summary>
213	        public bool IsWaveActive => IsScanning && _waveProgress < 1f;
214	
215	        /// <summary>Радиус кругового обзора, м: HUD показывает его в подсказке.</summary>
216	        public float SonarRadius => _sonarRadius;
217	
218	        /// <summary>Сколько подписей можно показать одновременно.</summary>
219	        public int MaxLabels => Mathf.Max(1, _maxLabels);
220	
221	        /// <summary>Включает и выключает режим сонара (то же, что нажатие Q).</summary>
222	        public void SetScanning(bool value)
223	        {
224	            if (IsScanning == value)
225	                return;
226	
227	            IsScanning = value;
228	            // Выключение — сразу после волны: кольцо не должно догорать.
229	            _waveProgress = value ? 0f : 1f;
230	            _scanElapsed = 0f;
231	            Debug.Log(value ? "[ObjectScanner] сонар включён" : "[ObjectScanner] сонар выключен", this);
232	        }
233	
234	        /// <summary>
235	        /// Пускает новую волну. Q — не переключатель, а разовый выстрел: нажатие всегда
236	        /// запускает волну заново, даже если прошлая ещё идёт.
237	        /// </summary>
238	        public void StartScan()
239	        {
240	            IsScanning = true;
241	            _waveProgress = 0f;
242	            _scanElapsed = 0f;
243	        }
244	
245	        private void Awake()
246	        {
247	            if (_view == null)
248	                _view = Camera.main;
249	            if (_rig == null)
250	                _rig = FindAnyObjectByType<PlayerCameraRig>();
251	            if (_player == null)
252	                _player = _rig != null && _rig.Target != null ? _rig.Target : transform;
253	            if (_shader == null)
254	                _shader = Shader.Find("FrostSpace/VFX/ScanHighlight");
255	
256	            if (_shader == null)
257	            {
258	                Debug.LogError("[ObjectScanner] не найден шейдер FrostSpace/VFX/ScanHighlight", this);
259	                enabled = false;
260	            }
261	        }
262	
263	        private void OnDisable()
264	        {
265	            // Пауза и выгрузка сцены: контуры и кольцо не должны остаться на экране.
266	            IsScanning = false;
267	            _aimTarget = null;
268	            _aimCandidate = null;
269	            _aimLostAt = -1f;
270	            _views.Clear();
271	            _flagged.Clear();
272	
273	            foreach (var entry in _entries.Values)
274	            {
275	                entry.Strength = 0f;
276	                entry.Channels = Channel.None;
277	                SetOverlaysVisible(entry, false);
278	            }
279	
280	            if (_pulse != null)
281	                _pulse.SetState(false, Vector3.zero, 0f, 0f, 0f);
282	        }
283	
284	        private void OnDestroy()
285	        {
286	            foreach (var entry in _entries.Values)
287	            {
288	                foreach (var overlay in entry.Overlays)
289	                {
290	                    if (overlay != null)
291	                        Destroy(overlay.gameObject);
292	                }
293	
294	                if (entry.Material != null)
295	                    Destroy(entry.Material);
296	            }
297	
298	            _entries.Clear();
299	        }
300	
301	        private void LateUpdate()
302	        {
303	            var paused = _rig != null && _rig.IsPaused;
304	            if (paused)
305	                return;
306	
307	            UpdateToggle();
308	            AdvanceWave();
309	
310	            var player = _player != null ? _player.position : transform.position;
311	            var aim = GameSettings.AimDetection ? ResolveAim() : ClearAim();
312	            var nearest = GameSettings.NearestDetection ? ResolveNearest(player) : null;
313	
314	            CollectSonar(player);
315	            Flag(aim, Channel.Aim);
316	            Flag(nearest, Channel.Nearest);
317	
318	            UpdateEntries();
319	            BuildViews(aim);
320	            UpdatePulse(player);
321	        }
322	
323	        /// <summary>
324	        /// Волна сонара идёт один раз от игрока до границы радиуса. После прохода подписи
325	        /// держатся <see cref="_scanHoldSeconds"/> и гаснут сами: Q — разовый выстрел,
326	        /// а не режим. Повторное нажатие просто пускает новую волну.
327	        /// </summary>
328	        private void AdvanceWave()
329	        {
330	            if (!IsScanning)
331	                return;
332	
333	            _scanElapsed += Time.deltaTime;
334	
335	            if (_waveProgress < 1f)
336	            {
337	                _waveProgress = ScanMath.Advance(_waveProgress, _pulseSeconds, Time.deltaTime);
338	                return;
339	            }
340	
341	            if (_scanElapsed >= _pulseSeconds + _scanHoldSeconds)
342	                SetScanning(false);
343	        }
344	
345	        /// <summary>Сброс прицельной цели, когда канал выключен тумблером.</summary>
346	        private ScanTarget ClearAim()
347	        {
348	            _aimTarget = null;
349	            _aimCandidate = null;
350	            _aimLostAt = -1f;
351	            return null;
352	        }
353	
354	        /// <summary>Q включает и выключает сонар; вне третьего лица режим гаснет сам.</summary>
355	        private void UpdateToggle()
356	        {
357	            var third = _rig == null || _rig.Mode == CameraMode.ThirdPerson;
358	            if (!third)
359	            {
360	                SetScanning(false);
361	                return;
362	            }
363	
364	            var keyboard = Keyboard.current;
365	            if (keyboard != null && keyboard.qKey.wasPressedThisFrame)
366	                StartScan();
367	        }
368	
369	        private void Flag(ScanTarget target, Channel channel)
370	        {
371	            if (target == null)
372	                return;
373	
374	            _flagged.TryGetValue(target, out var current);
375	            _flagged[target] = current | channel;
376	        }
377	
378	        /// <summary>
379	        /// Цель под квадратом прицела. Кандидаты оцениваются по близости точки попадания
380	        /// к перекрестию, а не по глубине: раньше побеждал ближайший по дистанции объект,
381	        /// и на заборе или в лесу выбор перескакивал между секциями, стоило чуть повернуть
382	        /// камеру. Глубина осталась только тай-брейком.
383	        ///
384	        /// Плюс гистерезис: прежняя цель держится, пока новая не окажется заметно ближе
385	        /// к центру, и ещё <see cref="_aimHoldSeconds"/> после полной потери лучей. Без
386	        /// этого рамка мигала на стыке двух объектов и на краю геометрии.
387	        /// </summary>
388	        private ScanTarget ResolveAim()
389	        {
390	            if (_view == null)
391	                return null;
392	
393	            var samples = Mathf.Clamp(_scanSamples, 1, 9);
394	            var half = Mathf.Max(0.01f, _scanAreaHalf);
395	
396	            ScanTarget best = null;
397	            var bestScore = float.MaxValue;
398	            var stickyScore = float.MaxValue;
399	
400	            for (var x = 0; x < samples; x++)
401	            {
402	                for (var y = 0; y < samples; y++)
403	                {
404	                    var point = ScanMath.ViewportSample(x, y, samples, half);
405	                    var ray = _view.ViewportPointToRay(new Vector3(point.x, point.y, 0f));
406	                    if (!Physics.Raycast(ray, out var hit, _maxDistance, _targets, QueryTriggerInteraction.Ignore))
407	                        continue;
408	
409	                    var target = ScanTarget.Find(hit.collider.transform);
410	                    if (target == null)
411	                        continue;
412	
413	                    // 0 — перекрестие, 1 — граница квадрата. Дистанция даёт микро-перевес
414	                    // при равном смещении, но не может перебить попадание в центр.
415	                    var offset = Mathf.Max(
416	                        Mathf.Abs(point.x - 0.5f), Mathf.Abs(point.y - 0.5f)) / half;
417	                    var score = offset + hit.distance * 0.002f;
418	
419	                    if (target == _aimTarget && score < stickyScore)
420	                        stickyScore = score;
421	
422	                    if (score < bestScore)
423	                    {
424	                        bestScore = score;
425	                        best = target;
426	                    }
427	                }
428	            }
429	
430	            if (best == null)
431	            {
432	                // Лучи не нашли цель: держим прежнюю короткое время, иначе рамка гаснет
433	                // на каждом пропущенном кадре у края стены или между створками забора.
434	                if (_aimTarget == null)
435	                    return null;
436	
437	                if (_aimLostAt < 0f)
438	                    _aimLostAt = Time.time;
439	
440	                if (Time.time - _aimLostAt > _aimHoldSeconds)
441	                    ClearAim();
442	
443	                return _aimTarget;
444	            }
445	
446	            _aimLostAt = -1f;
447	
448	            if (_aimTarget == null)
449	            {
450	                _aimTarget = best;
451	                _aimCandidate = null;
452	                return _aimTarget;
453	            }
454	
455	            if (best == _aimTarget)
456	            {
457	                _aimCandidate = null;
458	                return _aimTarget;
459	            }
460	
461	            // Новая цель должна продержаться в кадре _aimSwitchSeconds и быть заметно
462	            // ближе к перекрестию. Иначе тонкий объект — столб забора, ствол — перехватывает
463	            // выбор на один-два кадра, пока камера проезжает мимо, и подпись мигает.
464	            if (best != _aimCandidate)
465	            {
466	                _aimCandidate = best;
467	                _aimCandidateSince = Time.time;
468	            }
469	
470	            var confirmed = Time.time - _aimCandidateSince >= _aimSwitchSeconds;
471	            var clearlyBetter = stickyScore >= float.MaxValue ||
472	                                bestScore + _aimSwitchMargin <= stickyScore;
473	
474	            if (confirmed && clearlyBetter)
475	            {
476	                _aimTarget = best;
477	                _aimCandidate = null;
478	            }
479	
480	            return _aimTarget;
481	        }
482	
483	        /// <summary>Ближайшая цель в радиусе автодетекции.</summary>
484	        private ScanTarget ResolveNearest(Vector3 player)
485	        {
486	            ScanTarget best = null;
487	            var bestDistance = Mathf.Max(0f, _nearestRadius);
488	
489	            var all = ScanTarget.All;
490	            for (var i = 0; i < all.Count; i++)
491	            {
492	                var target = all[i];
493	                if (target == null)
494	                    continue;
495	
496	                var distance = Vector3.Distance(player, target.transform.position);
497	                if (distance > bestDistance)
498	                    continue;
499	
500	                best = target;
501	                bestDistance = distance;
502	            }
503	
504	            return best;
505	        }
506	
507	        /// <summary>
508	        /// Цели, которые накрыла волна сонара. Волна одна на включение: пока она идёт,
509	        /// в список попадают только объекты за её фронтом, поэтому подписи появляются
510	        /// по мере расхождения кольца. После прохода фронта через радиус остаются все
511	        /// цели в радиусе.
512	        ///
513	        /// Список обрезается по <see cref="_maxSonarTargets"/>: контур на каждом дереве
514	        /// в лесу — это десятки материалов и дублей геометрии.
515	        /// </summary>
516	        private void CollectSonar(Vector3 player)
517	        {
518	            _candidates.Clear();
519	            _candidateDistance.Clear();
520	
521	            if (!IsScanning)
522	                return;
523	
524	            var radius = Mathf.Max(0f, _sonarRadius);
525	            var front = _waveProgress >= 1f ? radius : Mathf.Clamp01(_waveProgress) * radius;
526	            var all = ScanTarget.All;
527	
528	            for (var i = 0; i < all.Count; i++)
529	            {
530	                var target = all[i];
531	                if (target == null)
532	                    continue;
533	
534	                var distance = Vector3.Distance(player, target.transform.position);
535	                if (distance > front)
536	                    continue;
537	
538	                _candidates.Add(target);
539	                _candidateDistance.Add(distance);
540	            }
541	
542	            // Сортировка вставками: список короткий, зато без аллокаций и делегатов.
543	            for (var i = 1; i < _candidates.Count; i++)
544	            {
545	                var target = _candidates[i];
546	                var distance = _candidateDistance[i];
547	                var j = i - 1;
548	
549	                while (j >= 0 && _candidateDistance[j] > distance)
550	                {
551	                    _candidates[j + 1] = _candidates[j];
552	                    _candidateDistance[j + 1] = _candidateDistance[j];
553	                    j--;
554	                }
555	
556	                _candidates[j + 1] = target;
557	                _candidateDistance[j + 1] = distance;
558	            }
559	
560	            var limit = Mathf.Clamp(_maxSonarTargets, 1, _candidates.Count);
561	            for (var i = 0; i < limit; i++)
562	                Flag(_candidates[i], Channel.Sonar);
563	        }
564	
565	        private void UpdateEntries()
566	        {
567	            var dt = Time.deltaTime;
568	            _visible.Clear();
569	
570	            // Сначала снимаем флаги, потом ставим заново по текущему кадру: так цель,
571	            // вышедшая из канала, плавно гаснет, а не исчезает в тот же кадр.
572	            foreach (var entry in _entries.Values)
573	                entry.Channels = Channel.None;
574	
575	            foreach (var pair in _flagged)
576	            {
577	                var target = pair.Key;
578	                if (target == null)
579	                    continue;
580	
581	                if (!_entries.TryGetValue(target, out var entry))
582	                {
583	                    entry = new Entry { Target = target };
584	                    _entries[target] = entry;
585	                }
586	
587	                entry.Channels = pair.Value;
588	            }
589	
590	            _flagged.Clear();
591	
592	            var player = _player != null ? _player.position : transform.position;
593	
594	            // Бюджет на кадр: дубли геометрии и материалы строятся по частям. Иначе волна,
595	            // дошедшая до радиуса, создаёт сразу два десятка дублей и материалов в одном
596	            // кадре — это рывок на треть секунды, который виден как «телепорт» животных.
597	            var budget = Mathf.Max(1, _buildsPerFrame);
598	
599	            foreach (var pair in _entries)
600	            {
601	                var entry = pair.Value;
602	                var target = entry.Target;
603	
604	                if (target == null)
605	                {
606	                    SetOverlaysVisible(entry, false);
607	                    continue;
608	                }
609	
610	                var wanted = entry.Channels != Channel.None;
611	                if (wanted && !entry.Built)
612	                    budget = BuildStep(entry, budget);
613	
614	                entry.Bounds = target.WorldBounds;
615	                entry.Distance = Vector3.Distance(player, entry.Bounds.center);
616	                entry.Strength = ScanMath.Approach(entry.Strength, wanted ? 1f : 0f, _fadeSeconds, dt);
617	
618	                if (wanted)
619	                    entry.Progress = ScanMath.Advance(entry.Progress, _scanSeconds, dt);
620	                else if (entry.Strength <= 0.001f)
621	                    entry.Progress = 0f;
622	
623	                var visible = entry.Strength > 0.001f;
624	                SetOverlaysVisible(entry, visible);
625	
626	                if (visible && entry.Material != null)
627	                {
628	                    entry.Material.SetFloat(StrengthId, entry.Strength);
629	                    entry.Material.SetVector(
630	                        ScanBandId, new Vector4(entry.Bounds.min.y, entry.Bounds.max.y, entry.Progress, 0f));
631	                }
632	
633	                if (visible)
634	                    _visible.Add(entry);
635	            }
636	
637	            // Цели, снятые со сцены, держат материалы: без чистки словарь растёт от сцены к сцене.
638	            RemoveDeadEntries();
639	        }
640	
641	        private void RemoveDeadEntries()
642	        {
643	            if (_entries.Count == 0)
644	                return;
645	
646	            _dead.Clear();
647	            foreach (var pair in _entries)
648	            {
649	                if (pair.Key != null)
650	                    continue;
651	
652	                if (pair.Value.Material != null)
653	                    Destroy(pair.Value.Material);
654	
655	                _dead.Add(pair.Key);
656	            }
657	
658	            for (var i = 0; i < _dead.Count; i++)
659	                _entries.Remove(_dead[i]);
660	
661	            _dead.Clear();
662	        }
663	
664	        /// <summary>
665	        /// Список для HUD: прицельная цель всегда первая (она не должна вытесняться
666	        /// из пула подписей), остальные — по возрастанию дистанции.
667	        /// </summary>
668	        private void BuildViews(ScanTarget aim)
669	        {
670	            _views.Clear();
671	            _visible.Sort(EntryOrder.Instance);
672	
673	            for (var i = 0; i < _visible.Count; i++)
674	            {
675	                var entry = _visible[i];
676	                var target = entry.Target;
677	
678	                _views.Add(new ScanView(
679	                    target,
680	                    target.DisplayName,
681	                    target.Category,
682	                    entry.Bounds.center,
683	                    entry.Bounds,
684	                    entry.Distance,
685	                    entry.Strength,
686	                    entry.Progress,
687	                    (entry.Channels & Channel.Aim) != 0,
688	                    (entry.Channels & Channel.Nearest) != 0,
689	                    (entry.Channels & Channel.Sonar) != 0));
690	            }
691	        }
692	
693	        /// <summary>
694	        /// Кольцо на земле живёт только пока идёт волна: одно нажатие Q — один проход.
695	        /// После прохода кольцо гаснет, а контуры и подписи остаются.
696	        /// </summary>
697	        private void UpdatePulse(Vector3 player)
698	        {
699	            if (_pulse == null)
700	            {
701	                var go = new GameObject("Scan Pulse") { hideFlags = HideFlags.DontSave };
702	                _pulse = go.AddComponent<ScanPulse>();
703	            }
704	
705	            if (!IsWaveActive)
706	            {
707	                _pulse.SetState(false, player, _sonarRadius, _waveProgress, 0f);
708	                return;
709	            }
710	
711	            _pulse.SetState(true, player, _sonarRadius, _waveProgress, 1f);
712	        }
713	
714	        /// <summary>
715	        /// Строит дубли геометрии цели порциями: материал — один раз, дальше по
716	        /// <paramref name="budget"/> рендереров за кадр. Возвращает остаток бюджета.
717	        /// Цель считается собранной, когда пройдены все её рендереры (или лимит
718	        /// <see cref="_maxRenderers"/>).
719	        /// </summary>
720	        private int BuildStep(Entry entry, int budget)
721	        {
722	            if (_shader == null)
723	            {
724	                entry.Built = true;
725	                return budget;
726	            }
727	
728	            if (entry.Material == null)
729	            {
730	                entry.Material = new Material(_shader)
731	                {
732	                    name = "ScanHighlight " + entry.Target.name,
733	                    hideFlags = HideFlags.DontSave
734	                };
735	                entry.Material.SetColor(ScanColorId, _scanColor);
736	                entry.Material.SetFloat(OutlineWidthId, _outlineWidth);
737	                entry.Material.SetFloat(StrengthId, 0f);
738	            }
739	
740	            entry.Sources ??= entry.Target.GetComponentsInChildren<Renderer>(true);
741	
742	            while (entry.SourceIndex < entry.Sources.Length && budget > 0)
743	            {
744	                var source = entry.Sources[entry.SourceIndex++];
745	
746	                if (source == null || !source.enabled || !source.gameObject.activeInHierarchy)
747	                    continue;
748	                if ((source.gameObject.hideFlags & HideFlags.DontSave) != 0)
749	                    continue;
750	
751	                var overlay = CreateOverlay(source, entry.Material);
752	                if (overlay != null)
753	                    entry.Overlays.Add(overlay);
754	
755	                budget--;
756	
757	                // Лимит рендереров на цель: защита от сканирования целого террейна.
758	                if (entry.Overlays.Count >= _maxRenderers)
759	                    break;
760	            }
761	
762	            entry.Built = entry.SourceIndex >= entry.Sources.Length || entry.Overlays.Count >= _maxRenderers;
763	            return budget;
764	        }
765	
766	        /// <summary>
767	        /// Дубль геометрии с материалом скана. Дубль повторяет трансформ источника кадр
768	        /// в кадр: у меша геометрия лежит в локальных осях рендерера, у скиннинга берутся
769	        /// те же кости, поэтому деформация совпадает и обводка не отстаёт.
770	        /// </summary>
771	        private static Renderer CreateOverlay(Renderer source, Material material)
772	        {
773	            var go = new GameObject("Scan Overlay") { hideFlags = HideFlags.DontSave };
774	            go.transform.SetParent(source.transform, false);
775	
776	            switch (source)
777	            {
778	                case SkinnedMeshRenderer skin when skin.sharedMesh != null:
779	                {
780	                    var clone = go.AddComponent<SkinnedMeshRenderer>();
781	                    clone.sharedMesh = skin.sharedMesh;
782	                    clone.bones = skin.bones;
783	                    clone.rootBone = skin.rootBone;
784	                    clone.localBounds = skin.localBounds;
785	                    clone.updateWhenOffscreen = true;
786	                    clone.shadowCastingMode = ShadowCastingMode.Off;
787	                    clone.receiveShadows = false;
788	                    clone.sharedMaterial = material;
789	                    return clone;
790	                }
791	
792	                case MeshRenderer mesh when mesh.TryGetComponent(out MeshFilter filter):
793	                {
794	                    var meshFilter = go.AddComponent<MeshFilter>();
795	                    meshFilter.sharedMesh = filter.sharedMesh;
796	                    var clone = go.AddComponent<MeshRenderer>();
797	                    clone.shadowCastingMode = ShadowCastingMode.Off;
798	                    clone.receiveShadows = false;
799	                    clone.sharedMaterial = material;
800	                    return clone;
801	                }
802	
803	                default:
804	                    Destroy(go);
805	                    return null;
806	            }
807	        }
808	
809	        private static void SetOverlaysVisible(Entry entry, bool visible)
810	        {
811	            for (var i = 0; i < entry.Overlays.Count; i++)
812	            {
813	                var overlay = entry.Overlays[i];
814	                if (overlay != null && overlay.gameObject.activeSelf != visible)
815	                    overlay.gameObject.SetActive(visible);
816	            }
817	        }
818	    }
819	}
