1	using System.Collections.Generic;
2	using UnityEngine;
3	
4	namespace FrostSpace.Features.Dialogue
5	{
6	    /// <summary>
7	    /// Одна реплика робота с переходами. Узел либо предлагает варианты ответа
8	    /// (<c>Choices</c>), либо идёт дальше по <c>NextId</c>; пустой переход — конец.
9	    ///
10	    /// Id присваивается один раз при создании и не меняется при перестановке узлов:
11	    /// переходы хранятся строкой, а не индексом списка.
12	    /// </summary>
13	    [System.Serializable]
14	    public sealed class DialogueNode
15	    {
16	        [SerializeField] private string _id;
17	        [TextArea(2, 6)]
18	        [SerializeField] private string _line;
19	        [SerializeField] private List<DialogueChoice> _choices = new();
20	        [Tooltip("Переход, когда вариантов нет. Пусто — конец диалога.")]
21	        [SerializeField] private string _nextId;
22	        [Tooltip("Действие при показе узла; None — без действия")]
23	        [SerializeField] private DialogueAction _action;
24	        [Tooltip("Id квеста; пусто — квест, назначенный сцене")]
25	        [SerializeField] private string _questId = string.Empty;
26	
27	        public DialogueNode()
28	        {
29	        }
30	
31	        public DialogueNode(string id, string line)
32	        {
33	            _id = id;
34	            _line = line;
35	        }
36	
37	        /// <summary>Стабильный id узла, read-only в инспекторе.</summary>
38	        public string Id => _id;
39	
40	        /// <summary>Реплика робота.</summary>
41	        public string Line => _line;
42	
43	        /// <summary>Варианты ответа игрока. Пусто — реплика идёт дальше сама.</summary>
44	        public IReadOnlyList<DialogueChoice> Choices => _choices;
45	
46	        /// <summary>Переход без вариантов; для узла с вариантами не используется.</summary>
47	        public string NextId => _nextId;
48	
49	        /// <summary>Действие, которое вызывает показ узла.</summary>
50	        public DialogueAction Action => _action;
51	
52	        /// <summary>Id квеста действия; пусто — квест, назначенный сцене.</summary>
53	        public string QuestId => _questId;
54	
55	        /// <summary>У узла есть действие, а не только реплика.</summary>
56	        public bool HasAction => _action != DialogueAction.None;
57	
58	        /// <summary>Узел завершает диалог: ни вариантов, ни перехода.</summary>
59	        public bool IsTerminal => _choices.Count == 0 && string.IsNullOrWhiteSpace(_nextId);
60	
61	        public void SetLine(string line) => _line = line;
62	
63	        public void SetNextId(string nextId) => _nextId = nextId;
64	
65	        /// <summary>Назначает действие и квест; пустой id — квест сцены.</summary>
66	        public void SetAction(DialogueAction action, string questId = "")
67	        {
68	            _action = action;
69	            _questId = questId;
70	        }
71	
72	        /// <summary>Добавляет вариант без ограничения: лимит проверяет валидация.</summary>
73	        public DialogueChoice AddChoice(string text = "", string nextId = "")
74	        {
75	            var choice = new DialogueChoice(text, nextId);
76	            _choices.Add(choice);
77	            return choice;
78	        }
79	
80	        public void RemoveChoiceAt(int index)
81	        {
82	            if (index >= 0 && index < _choices.Count)
83	                _choices.RemoveAt(index);
84	        }
85	
86	        /// <summary>Копия с новым id: строки и варианты переносятся как есть.</summary>
87	        internal DialogueNode Clone(string id)
88	        {
89	            var copy = new DialogueNode(id, _line);
90	            copy._nextId = _nextId;
91	            copy._action = _action;
92	            copy._questId = _questId;
93	            for (var i = 0; i < _choices.Count; i++)
94	                copy._choices.Add(new DialogueChoice(_choices[i].Text, _choices[i].NextId));
95	            return copy;
96	        }
97	
98	        /// <summary>Заменяет переходы на удалённый узел концом диалога.</summary>
99	        internal void Forget(string removedId)
100	        {
101	            if (_nextId == removedId)
102	                _nextId = string.Empty;
103	
104	            for (var i = 0; i < _choices.Count; i++)
105	            {
106	                if (_choices[i].NextId == removedId)
107	                    _choices[i].SetNextId(string.Empty);
108	            }
109	        }
110	    }
111	}
