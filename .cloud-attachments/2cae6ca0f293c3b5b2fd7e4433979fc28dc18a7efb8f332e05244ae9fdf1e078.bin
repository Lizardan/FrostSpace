{
  "content": "var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();\nvar report = new System.Text.StringBuilder();\n\nvoid SetRef(UnityEngine.Object target, string field, UnityEngine.Object value)\n{\n    var so = new UnityEditor.SerializedObject(target);\n    var prop = so.FindProperty(field);\n    if (prop == null) { report.AppendLine(\"MISSING FIELD \" + field + \" on \" + target.name); return; }\n    prop.objectReferenceValue = value;\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\nvoid SetBool(UnityEngine.Object target, string field, bool value)\n{\n    var so = new UnityEditor.SerializedObject(target);\n    var prop = so.FindProperty(field);\n    if (prop == null) { report.AppendLine(\"MISSING FIELD \" + field + \" on \" + target.name); return; }\n    prop.boolValue = value;\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\nvoid SetVector(UnityEngine.Object target, string field, UnityEngine.Vector3 value)\n{\n    var so = new UnityEditor.SerializedObject(target);\n    var prop = so.FindProperty(field);\n    if (prop == null) { report.AppendLine(\"MISSING FIELD \" + field + \" on \" + target.name); return; }\n    prop.vector3Value = value;\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\nvoid SetArray(UnityEngine.Object target, string field, UnityEngine.Object[] values)\n{\n    var so = new UnityEditor.SerializedObject(target);\n    var prop = so.FindProperty(field);\n    if (prop == null) { report.AppendLine(\"MISSING FIELD \" + field + \" on \" + target.name); return; }\n    prop.arraySize = values.Length;\n    for (var i = 0; i < values.Length; i++)\n        prop.GetArrayElementAtIndex(i).objectReferenceValue = values[i];\n    so.ApplyModifiedPropertiesWithoutUndo();\n}\n\nvar player = UnityEngine.GameObject.FindWithTag(\"Player\");\nvar cameraObj = UnityEngine.GameObject.Find(\"Main Camera\");\nvar dialogue = player.GetComponent<FrostSpace.Features.Dialogue.DialogueController>();\nvar locomotion = player.GetComponent<FrostSpace.Features.Locomotion.RobotLocomotion>();\nvar scanner = cameraObj.GetComponent<FrostSpace.Features.Scan.ObjectScanner>();\n\nplayer.transform.position = new UnityEngine.Vector3(0.5f, 0.7f, -1.5f);\nplayer.transform.eulerAngles = new UnityEngine.Vector3(0f, 270f, 0f);\n\n// Дверь вагона: тёмный проём и циановый контур на борту поезда.\nvar sky = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/_Project/Content/Materials/Level/Level_SkyNight.mat\");\nvar glow = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Material>(\"Assets/_Project/Content/Materials/Menu/Menu_TechGlow.mat\");\nvar doorway = new UnityEngine.GameObject(\"DepotDoorway\");\ndoorway.transform.position = new UnityEngine.Vector3(-6.62f, 0f, -1.0f);\n\nvar opening = UnityEngine.GameObject.CreatePrimitive(UnityEngine.PrimitiveType.Cube);\nopening.name = \"Opening\";\nopening.transform.SetParent(doorway.transform, false);\nopening.transform.localPosition = new UnityEngine.Vector3(0f, 1.8f, 0f);\nopening.transform.localScale = new UnityEngine.Vector3(0.06f, 2.4f, 3.2f);\nUnityEngine.Object.DestroyImmediate(opening.GetComponent<UnityEngine.BoxCollider>());\nopening.GetComponent<UnityEngine.MeshRenderer>().sharedMaterial = sky;\n\nvar edgeL = UnityEngine.GameObject.CreatePrimitive(UnityEngine.PrimitiveType.Cube);\nedgeL.name = \"EdgeL\";\nedgeL.transform.SetParent(doorway.transform, false);\nedgeL.transform.localPosition = new UnityEngine.Vector3(0.04f, 1.8f, -1.6f);\nedgeL.transform.localScale = new UnityEngine.Vector3(0.05f, 2.4f, 0.08f);\nUnityEngine.Object.DestroyImmediate(edgeL.GetComponent<UnityEngine.BoxCollider>());\nedgeL.GetComponent<UnityEngine.MeshRenderer>().sharedMaterial = glow;\n\nvar edgeR = UnityEngine.GameObject.CreatePrimitive(UnityEngine.PrimitiveType.Cube);\nedgeR.name = \"EdgeR\";\nedgeR.transform.SetParent(doorway.transform, false);\nedgeR.transform.localPosition = new UnityEngine.Vector3(0.04f, 1.8f, 1.6f);\nedgeR.transform.localScale = new UnityEngine.Vector3(0.05f, 2.4f, 0.08f);\nUnityEngine.Object.DestroyImmediate(edgeR.GetComponent<UnityEngine.BoxCollider>());\nedgeR.GetComponent<UnityEngine.MeshRenderer>().sharedMaterial = glow;\n\nvar edgeTop = UnityEngine.GameObject.CreatePrimitive(UnityEngine.PrimitiveType.Cube);\nedgeTop.name = \"EdgeTop\";\nedgeTop.transform.SetParent(doorway.transform, false);\nedgeTop.transform.localPosition = new UnityEngine.Vector3(0.04f, 3.02f, 0f);\nedgeTop.transform.localScale = new UnityEngine.Vector3(0.05f, 0.08f, 3.28f);\nUnityEngine.Object.DestroyImmediate(edgeTop.GetComponent<UnityEngine.BoxCollider>());\nedgeTop.GetComponent<UnityEngine.MeshRenderer>().sharedMaterial = glow;\n\n// R13 выходит из вагона.\nvar r13Prefab = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(\"Assets/_Project/Content/Prefabs/Robots/R13_Prospector_Model.prefab\");\nvar r13 = (UnityEngine.GameObject)UnityEditor.PrefabUtility.InstantiatePrefab(r13Prefab, scene);\nr13.name = \"R13_Prospector\";\nr13.transform.position = new UnityEngine.Vector3(-7.2f, 0.6f, -0.15f);\nr13.transform.eulerAngles = new UnityEngine.Vector3(0f, 90f, 0f);\nvar r13Capsule = r13.AddComponent<UnityEngine.CapsuleCollider>();\nr13Capsule.center = new UnityEngine.Vector3(0f, 1.05f, 0f);\nr13Capsule.radius = 0.4f;\nr13Capsule.height = 2.1f;\n\n// Тележка с гнёздами.\nvar cartAsset = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(\"Assets/_Project/Content/Models/Train/Prop_GravCart.fbx\");\nvar cart = (UnityEngine.GameObject)UnityEditor.PrefabUtility.InstantiatePrefab(cartAsset, scene);\ncart.name = \"Prop_GravCart\";\nUnityEditor.PrefabUtility.UnpackPrefabInstance(cart, UnityEditor.PrefabUnpackMode.Completely, UnityEditor.InteractionMode.AutomatedAction);\ncart.transform.position = new UnityEngine.Vector3(-8.4f, 0.6f, -1.65f);\ncart.transform.rotation = UnityEngine.Quaternion.identity;\nvar cartBox = cart.AddComponent<UnityEngine.BoxCollider>();\ncartBox.center = new UnityEngine.Vector3(0f, 0.575f, 0f);\ncartBox.size = new UnityEngine.Vector3(2.4f, 1.15f, 1.89f);\n\nstring[] slotNames = { \"Slot_LB\", \"Slot_LF\", \"Slot_RB\", \"Slot_RF\" };\nUnityEngine.Vector3[] slotPositions =\n{\n    new UnityEngine.Vector3(-0.55f, 0.55f, -0.4f),\n    new UnityEngine.Vector3(-0.55f, 0.55f, 0.4f),\n    new UnityEngine.Vector3(0.55f, 0.55f, -0.4f),\n    new UnityEngine.Vector3(0.55f, 0.55f, 0.4f)\n};\nvar slots = new FrostSpace.Features.Carry.CarrySlot[4];\nfor (var i = 0; i < slotNames.Length; i++)\n{\n    var slotGo = new UnityEngine.GameObject(slotNames[i]);\n    slotGo.transform.SetParent(cart.transform, false);\n    slotGo.transform.localPosition = slotPositions[i];\n    slots[i] = slotGo.AddComponent<FrostSpace.Features.Carry.CarrySlot>();\n}\n\nvar batteryAsset = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(\"Assets/_Project/Content/Models/Train/Prop_Battery.fbx\");\nvar cargo = new FrostSpace.Features.Carry.Carryable[4];\nfor (var i = 0; i < 4; i++)\n{\n    var battery = (UnityEngine.GameObject)UnityEditor.PrefabUtility.InstantiatePrefab(batteryAsset, scene);\n    battery.name = \"Prop_Battery_\" + (i + 1);\n    UnityEditor.PrefabUtility.UnpackPrefabInstance(battery, UnityEditor.PrefabUnpackMode.Completely, UnityEditor.InteractionMode.AutomatedAction);\n    battery.transform.SetParent(slots[i].transform, false);\n    battery.transform.localPosition = UnityEngine.Vector3.zero;\n    battery.transform.localRotation = UnityEngine.Quaternion.identity;\n    var batteryBox = battery.AddComponent<UnityEngine.BoxCollider>();\n    batteryBox.center = new UnityEngine.Vector3(0f, 0.475f, 0f);\n    batteryBox.size = new UnityEngine.Vector3(0.98f, 0.95f, 0.70f);\n    var carryable = battery.AddComponent<FrostSpace.Features.Carry.Carryable>();\n    cargo[i] = carryable;\n}\n\nvar guardDialogue = UnityEditor.AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(\"Assets/_Project/Content/Data/Dialogues/FrontierGuard_Warning.asset\");\nvar bulwarkDialogue = UnityEditor.AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(\"Assets/_Project/Content/Data/Dialogues/FrontierBulwark_Warning.asset\");\nvar dispatcherDialogue = UnityEditor.AssetDatabase.LoadAssetAtPath<FrostSpace.Features.Dialogue.DialogueAsset>(\"Assets/_Project/Content/Data/Dialogues/FrontierDispatcher_Meet.asset\");\n\nvoid AddGuardComponents(UnityEngine.GameObject go, string displayName, string category, FrostSpace.Features.Dialogue.DialogueAsset asset)\n{\n    var capsule = go.AddComponent<UnityEngine.CapsuleCollider>();\n    capsule.center = new UnityEngine.Vector3(0f, 1.0f, 0f);\n    capsule.radius = 0.45f;\n    capsule.height = 2.0f;\n\n    var scan = go.AddComponent<FrostSpace.Features.Scan.ScanTarget>();\n    var scanSo = new UnityEditor.SerializedObject(scan);\n    scanSo.FindProperty(\"_displayName\").stringValue = displayName;\n    scanSo.FindProperty(\"_category\").stringValue = category;\n    scanSo.ApplyModifiedPropertiesWithoutUndo();\n\n    var speaker = go.AddComponent<FrostSpace.Features.Dialogue.DialogueSpeaker>();\n    SetRef(speaker, \"_dialogue\", asset);\n}\n\nvar wardenA = UnityEngine.GameObject.Find(\"R16_Warden_A\");\nwardenA.transform.position = new UnityEngine.Vector3(-4.8f, 0.7f, -4.6f);\nwardenA.transform.eulerAngles = new UnityEngine.Vector3(0f, 15f, 0f);\nAddGuardComponents(wardenA, \"R16 WARDEN\", \"GUARD\", guardDialogue);\n\nvar wardenB = UnityEngine.GameObject.Find(\"R16_Warden_B\");\nAddGuardComponents(wardenB, \"R16 WARDEN\", \"GUARD\", guardDialogue);\n\nvar drifter = UnityEngine.GameObject.Find(\"R7_Drifter\");\nAddGuardComponents(drifter, \"R7 DRIFTER\", \"DISPATCHER\", dispatcherDialogue);\n\nvar bulwarkPrefab = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(\"Assets/_Project/Content/Prefabs/Robots/R8_Bulwark_Model.prefab\");\nvar bulwark = (UnityEngine.GameObject)UnityEditor.PrefabUtility.InstantiatePrefab(bulwarkPrefab, scene);\nbulwark.name = \"R8_Bulwark\";\nbulwark.transform.position = new UnityEngine.Vector3(8.6f, 0.6f, 5.2f);\nbulwark.transform.eulerAngles = new UnityEngine.Vector3(0f, 240f, 0f);\nAddGuardComponents(bulwark, \"R8 BULWARK\", \"GUARD\", bulwarkDialogue);\n\n// Снаряжение и сканер.\nvar equipment = player.AddComponent<FrostSpace.Features.Story.PlayerEquipment>();\nSetRef(equipment, \"_dialogue\", dialogue);\nSetRef(equipment, \"_scanner\", scanner);\nSetBool(scanner, \"_available\", false);\n\nvar pause = player.GetComponent<FrostSpace.Features.Menu.PauseMenuScreen>();\nSetRef(pause, \"_equipment\", equipment);\n\n// Последовательность выхода.\nvar arrivalGo = new UnityEngine.GameObject(\"DepotArrival\");\nvar arrival = arrivalGo.AddComponent<FrostSpace.Features.Story.DepotArrivalDirector>();\nSetRef(arrival, \"_locomotion\", locomotion);\nSetRef(arrival, \"_r13\", r13.transform);\nSetRef(arrival, \"_r13Animator\", r13.GetComponent<UnityEngine.Animator>());\nSetRef(arrival, \"_cart\", cart.transform);\nSetArray(arrival, \"_slots\", slots);\nSetArray(arrival, \"_cargo\", cargo);\nSetVector(arrival, \"_r13Exit\", new UnityEngine.Vector3(-4.6f, 0.6f, -0.15f));\nSetVector(arrival, \"_cartExit\", new UnityEngine.Vector3(-2.8f, 0.6f, -1.65f));\n\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);\nUnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene, \"Assets/Scenes/Frontier.unity\");\nUnityEditor.AssetDatabase.SaveAssets();\n\nreport.AppendLine(\"saved Frontier: slots=\" + slots.Length + \" cargo=\" + cargo.Length);\nreturn report.ToString();\n",
  "file_path": "F:\\Unity Projects\\FrostSpace\\Temp\\build_frontier.cs"
}
