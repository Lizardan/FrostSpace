491	        private void BuildGearButton(Transform parent)
492	        {
493	            var go = new GameObject("SettingsGear", typeof(RectTransform));
494	            go.transform.SetParent(parent, false);
495	            var rect = (RectTransform)go.transform;
496	            rect.anchorMin = new Vector2(1f, 1f);
497	            rect.anchorMax = new Vector2(1f, 1f);
498	            rect.pivot = new Vector2(1f, 1f);
499	            rect.sizeDelta = new Vector2(180f, 54f);
500	            rect.anchoredPosition = new Vector2(-48f, -42f);
501	
502	            var background = go.AddComponent<Image>();
503	            background.color = _buttonIdle;
504	            background.raycastTarget = true;
505	
506	            var button = go.AddComponent<Button>();
507	            button.targetGraphic = background;
508	            button.transition = Selectable.Transition.ColorTint;
509	            var colors = button.colors;
510	            colors.normalColor = _buttonIdle;
