115	        private void OnDisable()
116	        {
117	            // Сцена выгружается или компонент выключили — время обязано идти дальше,
118	            // иначе следующая сцена стартует замороженной.
119	            if (IsPaused)
120	                Resume();
121	        }
122	
123	        private void Update()
124	        {
125	            var keyboard = Keyboard.current;
126	            if (keyboard == null || !keyboard.escapeKey.wasPressedThisFrame)
127	                return;
128	
129	            // Esc в настройках закрывает настройки, а не игру: иначе из панели
130	            // невозможно выйти, не возобновив игру.
131	            if (_settingsPanel != null && _settingsPanel.activeSelf)
132	            {
133	                _settingsPanel.SetActive(false);
134	                return;
135	            }
136	
137	            if (IsPaused)
138	                Resume();
139	            else
140	                Open();
141	        }
