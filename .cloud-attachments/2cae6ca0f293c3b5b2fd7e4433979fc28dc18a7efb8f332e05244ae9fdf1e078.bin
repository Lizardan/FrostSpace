10	{
11	    /// <summary>
12	    /// Открывает и ведёт диалог: E у робота, реплики, варианты, Esc.
13	    ///
14	    /// Цель ищется собственным лучом из камеры в перекрестие, а не через
15	    /// <c>ObjectScanner.AimTarget</c>: тот зависит от тумблера AimDetection, работает
16	    /// только в третьем лице и с гистерезисом. Дальность луча и радиус разговора
17	    /// разные: смотреть можно издалека, но подойти надо ближе.
18	    ///
19	    /// Пока диалог открыт, игра не встаёт на паузу: мир и анимации идут. Стоят игрок
20	    /// (<see cref="RobotLocomotion.SetConversationLock"/>), камера
21	    /// (<see cref="PlayerCameraRig.SetPaused"/>) и ввод карты Player; пауза на Esc
22	    /// временно выключена, иначе тот же Esc закрыл бы диалог и открыл меню паузы.
23	    /// </summary>
24	    [DisallowMultipleComponent]
25	    [DefaultExecutionOrder(-10)]
26	    public sealed class DialogueController : MonoBehaviour
27	    {
28	        [Header("Ссылки")]
29	        [Tooltip("Риг камеры: луч прицела, корень игрока и заморозка обзора")]
30	        [SerializeField] private PlayerCameraRig _rig;
31	        [Tooltip("Сканер: на время диалога выключается, чтобы Q не пускал волну")]
32	        [SerializeField] private ObjectScanner _scanner;
33	        [Tooltip("Меню паузы: временно выключается на время диалога")]
34	        [SerializeField] private PauseMenuScreen _pause;
35	        [Tooltip("Экран диалога")]
36	        [SerializeField] private DialogueScreen _screen;
37	        [Tooltip("Локомоция игрока: гасит ходьбу и прыжок")]
38	        [SerializeField] private RobotLocomotion _locomotion;
39	        [Tooltip("Ассет ввода; пусто — берётся InputSystem.actions")]
40	        [SerializeField] private InputActionAsset _actions;
41	
42	        [Header("Взаимодействие")]
43	        [Tooltip("Слои луча из перекрестия; слой Player исключить")]
44	        [SerializeField] private LayerMask _blockers = ~0;
45	        [Tooltip("Максимальная дальность луча, м")]
46	        [SerializeField] private float _rayDistance = 12f;
47	        [Tooltip("Радиус, внутри которого с роботом можно заговорить, м")]
48	        [SerializeField] private float _talkRadius = 4f;
49	
50	        private InputAction _interact;
51	        private InputActionMap _playerMap;
52	        private DialogueSession _session;
53	        private DialogueSpeaker _speaker;
54	        private DialogueSpeaker _target;
55	        private bool _open;
56	        private bool _pauseSuspended;
57	        private bool _pauseWasEnabled;
58	        private bool _scannerWasEnabled;
59	        private bool _restorePause;
60	
61	        /// <summary>Диалог сейчас открыт.</summary>
62	        public bool IsOpen => _open;
63	
64	        /// <summary>
65	        /// Показан узел с действием: действие и id квеста. Пустой id означает
66	        /// квест, назначенный сцене. Событие приходит один раз за показ узла.
67	        /// </summary>
68	        public event Action<DialogueAction, string> ActionInvoked;
69	
70	        private void Awake()
71	        {
72	            if (_rig == null)
73	                _rig = FindAnyObjectByType<PlayerCameraRig>();
74	            if (_scanner == null)
75	                _scanner = FindAnyObjectByType<ObjectScanner>();
76	            if (_pause == null)
77	                _pause = FindAnyObjectByType<PauseMenuScreen>();
78	            if (_screen == null)
79	                _screen = GetComponentInChildren<DialogueScreen>(true);
80	            if (_locomotion == null && _rig != null && _rig.Target != null)
81	                _locomotion = _rig.Target.GetComponent<RobotLocomotion>();
82	            if (_locomotion == null)
83	                _locomotion = FindAnyObjectByType<RobotLocomotion>();
84	
85	            var source = _actions != null ? _actions : InputSystem.actions;
86	            if (source != null)
87	            {
88	                _interact = source.FindAction("Player/Interact");
89	                _playerMap = source.FindActionMap("Player", false);
90	            }
91	
92	            if (_screen == null)
93	            {
94	                Debug.LogError("DialogueController: не найден DialogueScreen", this);
95	                enabled = false;
96	            }
97	        }
98	
99	        private void OnEnable()
100	        {
101	            if (_screen != null)
102	            {
103	                _screen.ChoicePressed += OnChoicePressed;
104	                _screen.AdvancePressed += OnAdvancePressed;
105	            }
106	
107	            _interact?.Enable();
108	        }
109	
110	        private void OnDisable()
111	        {
112	            if (_screen != null)
113	            {
114	                _screen.ChoicePressed -= OnChoicePressed;
115	                _screen.AdvancePressed -= OnAdvancePressed;
116	            }
117	
118	            if (_open)
119	                FinishConversation(false);
120	            else
121	                RestorePauseImmediately();
122	
123	            _interact?.Disable();
124	        }
125	
126	        private void Update()
127	        {
128	            if (_screen == null)
129	                return;
130	
131	            if (_open)
132	            {
133	                HandleConversationInput();
134	                return;
135	            }
136	
137	            _target = FindTarget();
138	            _screen.SetPrompt(_target != null);
139	
140	            if (_target != null && _interact != null && _interact.WasPressedThisFrame())
141	                Open(_target);
142	        }
143	
144	        private void LateUpdate()
145	        {
146	            // Пауза возвращается после кадра закрытия: её Update уже прошёл, поэтому
147	            // Esc, которым закрыли диалог, не откроет меню паузы тем же нажатием.
148	            if (!_restorePause)
149	                return;
150	
151	            _restorePause = false;
152	            if (_pause != null)
153	                _pause.enabled = true;
154	        }
155	
156	        /// <summary>Робот в перекрестии, достаточно близко и готов к разговору.</summary>
157	        private DialogueSpeaker FindTarget()
158	        {
159	            if (_rig == null || _rig.IsPaused || _rig.RideTarget != null)
160	                return null;
161	            if (_pause != null && _pause.IsPaused)
162	                return null;
163	
164	            var camera = _rig.ViewCamera;
165	            if (camera == null)
166	                return null;
167	
168	            var ray = camera.ViewportPointToRay(new Vector3(0.5f, 0.5f, 0f));
169	            if (!Physics.Raycast(
170	                    ray, out var hit, _rayDistance, _blockers, QueryTriggerInteraction.Ignore))
171	            {
172	                return null;
173	            }
174	
175	            var speaker = hit.collider.GetComponentInParent<DialogueSpeaker>();
176	            if (speaker == null || !speaker.CanTalk)
177	                return null;
178	
179	            var player = _rig.Target;
180	            if (player != null)
181	            {
182	                var offset = speaker.transform.position - player.position;
183	                offset.y = 0f;
184	                if (offset.magnitude > _talkRadius)
185	                    return null;
186	            }
187	
188	            return speaker;
189	        }
190	
191	        private void Open(DialogueSpeaker speaker)
192	        {
193	            if (_open || speaker == null || !speaker.CanTalk)
194	                return;
195	            if (_rig == null || _rig.Target == null)
196	                return;
197	
198	            var session = speaker.Dialogue != null ? speaker.Dialogue.CreateSession() : null;
199	            if (session == null || session.Current == null)
200	                return;
201	
202	            _session = session;
203	            _speaker = speaker;
204	            _open = true;
205	            _target = null;
206	
207	            _speaker.BeginConversation(_rig.Target);
208	
209	            _pauseWasEnabled = _pause != null && _pause.enabled;
210	            if (_pause != null)
211	            {
212	                _pause.enabled = false;
213	                _pauseSuspended = true;
214	            }
215	
216	            _scannerWasEnabled = _scanner != null && _scanner.enabled;
217	            if (_scanner != null)
218	                _scanner.enabled = false;
219	
220	            _locomotion?.SetConversationLock(true);
221	            _rig.SetPaused(true);
222	            _playerMap?.Disable();
223	
224	            _screen.SetPrompt(false);
225	            ShowCurrent();
226	        }
227	
228	        private void ShowCurrent()
229	        {
230	            var node = _session?.Current;
231	            if (node == null)
232	            {
233	                Close();
234	                return;
235	            }
236	
237	            _screen.Show(node, _speaker.DisplayName, _speaker.Category);
238	
239	            if (node.HasAction)
240	                ActionInvoked?.Invoke(node.Action, node.QuestId);
241	        }
242	
243	        private void Close()
244	        {
245	            FinishConversation(true);
246	        }
247	
248	        /// <summary>
249	        /// Снимает все три блокировки: ввод, камера/курсор и пауза. Вызывается и из
250	        /// <see cref="OnDisable"/>, чтобы выгрузка сцены не оставила игру замороженной.
251	        /// </summary>
252	        private void FinishConversation(bool restorePause)
253	        {
254	            if (!_open)
255	            {
256	                RestorePauseImmediately();
257	                return;
258	            }
259	
260	            _open = false;
261	            _session = null;
262	
263	            _screen?.Hide();
264	            _speaker?.EndConversation();
265	            _speaker = null;
266	
267	            _locomotion?.SetConversationLock(false);
268	            _rig?.SetPaused(false);
269	            _playerMap?.Enable();
270	
271	            if (_scanner != null)
272	                _scanner.enabled = _scannerWasEnabled;
273	
274	            if (_pause != null && _pauseSuspended)
275	            {
276	                _pauseSuspended = false;
277	                if (restorePause)
278	                    _restorePause = true;
279	                else
280	                    _pause.enabled = _pauseWasEnabled;
281	            }
282	        }
283	
284	        private void RestorePauseImmediately()
285	        {
286	            _restorePause = false;
287	            if (_pause != null && _pauseSuspended)
288	            {
289	                _pauseSuspended = false;
290	                _pause.enabled = _pauseWasEnabled;
291	            }
292	        }
293	
294	        private void HandleConversationInput()
295	        {
296	            var keyboard = Keyboard.current;
297	            if (keyboard == null)
298	                return;
299	
300	            if (keyboard.escapeKey.wasPressedThisFrame)
301	            {
302	                Close();
303	                return;
304	            }
305	
306	            if (keyboard.eKey.wasPressedThisFrame)
307	            {
308	                OnAdvancePressed();
309	                return;
310	            }
311	
312	            for (var i = 0; i < DialogueAsset.MaxChoices; i++)
313	            {
314	                if (keyboard[(Key)((int)Key.Digit1 + i)].wasPressedThisFrame)
315	                {
316	                    OnChoicePressed(i);
317	                    return;
318	                }
319	            }
320	        }
321	
322	        private void OnAdvancePressed()
323	        {
324	            if (!_open || _screen == null || _session == null)
325	                return;
326	
327	            if (_screen.IsTyping)
328	            {
329	                _screen.CompleteTyping();
330	                // Терминальный узел: после раскрытия текста закрываем сразу,
331	                // иначе управление остаётся заблокированным до второго E.
332	                if (_session.Current != null && _session.Current.IsTerminal)
333	                    Close();
334	                return;
335	            }
336	
337	            // С вариантами подтверждает Enter/клик: E не должна случайно выбрать ответ.
338	            if (_session.HasChoices)
339	                return;
340	
341	            if (_session.Advance())
342	                ShowCurrent();
343	            else
344	                Close();
345	        }
346	
347	        private void OnChoicePressed(int index)
348	        {
349	            if (!_open || _session == null || !_session.HasChoices)
350	                return;
351	
352	            if (_session.Choose(index))
353	                ShowCurrent();
354	            else
355	                Close();
356	        }
357	    }
358	}
