10	    /// валидация. Узлы добавляются, дублируются и удаляются здесь же; удаление
11	    /// переводит ссылки на узел в «Конец», поэтому граф не ломается молча.
12	    ///
13	    /// Структурные правки идут через методы <see cref="DialogueAsset"/> — так они
14	    /// попадают и в тесты. Тексты и переходы правятся SerializedProperty, чтобы
15	    /// работали Undo и multi-object.
16	    /// </summary>
17	    [CustomEditor(typeof(DialogueAsset))]
18	    public sealed class DialogueAssetEditor : UnityEditor.Editor
19	    {
20	        private readonly List<string> _errors = new();
21	        private readonly List<string> _warnings = new();
22	        private SerializedProperty _startId;
23	        private SerializedProperty _nodes;
24	        private Vector2 _scroll;
25	        private bool _showWarnings = true;
26	
27	        private void OnEnable()
28	        {
29	            _startId = serializedObject.FindProperty("_startId");
30	            _nodes = serializedObject.FindProperty("_nodes");
31	        }
32	
33	        public override void OnInspectorGUI()
34	        {
35	            serializedObject.Update();
36	
37	            var asset = (DialogueAsset)target;
38	            DrawHeader(asset);
39	            DrawStart(asset);
40	            DrawActions(asset);
41	            DrawValidation(asset);
42	
43	            _scroll = EditorGUILayout.BeginScrollView(_scroll);
44	            for (var i = 0; i < _nodes.arraySize; i++)
45	                DrawNode(asset, i);
46	            EditorGUILayout.EndScrollView();
47	
48	            serializedObject.ApplyModifiedProperties();
49	        }
50	
51	        private void DrawHeader(DialogueAsset asset)
52	        {
53	            EditorGUILayout.Space(4f);
54	            EditorGUILayout.LabelField("FROSTSPACE / DIALOGUE", EditorStyles.boldLabel);
55	            EditorGUILayout.LabelField(
56	                $"Узлов: {asset.Nodes.Count}    " +
57	                $"Старт: {(string.IsNullOrEmpty(asset.StartId) ? "—" : asset.StartId)}",
58	                EditorStyles.miniLabel);
59	            EditorGUILayout.Space(6f);
60	        }
61	
62	        private void DrawStart(DialogueAsset asset)
63	        {
64	            var ids = new List<string> { string.Empty };
65	            var labels = new List<string> { "— не выбран —" };
66	            for (var i = 0; i < asset.Nodes.Count; i++)
67	            {
68	                var node = asset.Nodes[i];
69	                if (node == null)
70	                    continue;
71	
72	                ids.Add(node.Id);
73	                labels.Add($"{node.Id}  ·  {Preview(node.Line)}");
74	            }
75	
76	            var current = ids.IndexOf(_startId.stringValue);
77	            if (current < 0)
78	                current = 0;
79	
80	            var next = EditorGUILayout.Popup("Стартовый узел", current, labels.ToArray());
81	            if (next != current)
82	                _startId.stringValue = ids[next];
83	        }
84	
85	        private void DrawActions(DialogueAsset asset)
86	        {
87	            EditorGUILayout.BeginHorizontal();
88	
89	            if (GUILayout.Button("Добавить узел"))
90	                AddNode(asset, "Добавить узел");
91	
92	            using (new EditorGUI.DisabledScope(_nodes.arraySize == 0))
93	            {
94	                if (GUILayout.Button("Проверить"))
95	                {
96	                    serializedObject.ApplyModifiedProperties();
97	                    Validate(asset);
98	                }
99	            }
100	
101	            EditorGUILayout.EndHorizontal();
102	            EditorGUILayout.Space(4f);
103	        }
104	
105	        private void DrawValidation(DialogueAsset asset)
106	        {
107	            _errors.Clear();
108	            _warnings.Clear();
109	            asset.CollectProblems(_errors, _warnings);
110	
111	            if (_errors.Count > 0)
112	            {
113	                var text = _errors.Count <= 8
114	                    ? string.Join("\n", _errors)
115	                    : string.Join("\n", _errors.GetRange(0, 8)) +
116	                      $"\n… и ещё {_errors.Count - 8}";
117	                EditorGUILayout.HelpBox("Ошибки:\n" + text, MessageType.Error);
118	            }
119	
120	            if (_warnings.Count > 0)
121	            {
122	                _showWarnings = EditorGUILayout.Foldout(_showWarnings, "Предупреждения", true);
123	                if (_showWarnings)
124	                {
125	                    var text = _warnings.Count <= 8
126	                        ? string.Join("\n", _warnings)
127	                        : string.Join("\n", _warnings.GetRange(0, 8)) +
128	                          $"\n… и ещё {_warnings.Count - 8}";
129	                    EditorGUILayout.HelpBox(text, MessageType.Warning);
130	                }
131	            }
132	
133	            if (_errors.Count == 0 && _warnings.Count == 0)
134	                EditorGUILayout.HelpBox("Граф корректен.", MessageType.Info);
135	
136	            EditorGUILayout.Space(4f);
137	        }
138	
139	        private void DrawNode(DialogueAsset asset, int index)
140	        {
141	            var nodeProp = _nodes.GetArrayElementAtIndex(index);
142	            var id = nodeProp.FindPropertyRelative("_id").stringValue;
143	            var lineProp = nodeProp.FindPropertyRelative("_line");
144	            var nextProp = nodeProp.FindPropertyRelative("_nextId");
145	            var choicesProp = nodeProp.FindPropertyRelative("_choices");
146	
147	            EditorGUILayout.BeginVertical("box");
148	
149	            EditorGUILayout.BeginHorizontal();
150	            EditorGUILayout.LabelField(
151	                string.IsNullOrEmpty(id) ? $"#{index + 1}" : id,
152	                EditorStyles.boldLabel);
153	            if (asset.StartId == id)
154	                GUILayout.Label("СТАРТ", EditorStyles.miniBoldLabel, GUILayout.Width(48f));
155	            EditorGUILayout.EndHorizontal();
156	
157	            EditorGUILayout.PropertyField(lineProp, new GUIContent("Реплика"));
158	            if (lineProp.stringValue.Length > DialogueAsset.LongLineWarning)
159	            {
160	                EditorGUILayout.HelpBox(
161	                    $"Реплика длиннее {DialogueAsset.LongLineWarning} символов: " +
162	                    "на панели она может обрезаться.",
163	                    MessageType.Warning);
164	            }
165	
166	            EditorGUILayout.LabelField("Варианты ответа", EditorStyles.miniBoldLabel);
167	            for (var c = 0; c < choicesProp.arraySize; c++)
168	                DrawChoice(asset, choicesProp, c);
169	
170	            EditorGUILayout.BeginHorizontal();
171	            using (new EditorGUI.DisabledScope(
172	                       choicesProp.arraySize >= DialogueAsset.MaxChoices))
173	            {
174	                if (GUILayout.Button(
175	                        $"Добавить вариант ({choicesProp.arraySize}/{DialogueAsset.MaxChoices})"))
176	                {
177	                    serializedObject.ApplyModifiedProperties();
178	                    Undo.RecordObject(asset, "Добавить вариант");
179	                    AddChoice(asset, id);
180	                    serializedObject.Update();
181	                    GUIUtility.ExitGUI();
182	                }
183	            }
184	
185	            if (GUILayout.Button("Ответ с новой репликой"))
186	            {
187	                serializedObject.ApplyModifiedProperties();
188	                Undo.RecordObject(asset, "Новый ответ");
189	                var created = asset.AddNode(string.Empty);
190	                FindAssetNode(asset, id)?.AddChoice("Новый ответ", created.Id);
191	                EditorUtility.SetDirty(asset);
192	                serializedObject.Update();
193	                GUIUtility.ExitGUI();
194	            }
195	
196	            EditorGUILayout.EndHorizontal();
197	
198	            if (choicesProp.arraySize == 0)
199	                DrawTarget(asset, nextProp, "Переход без вариантов");
200	
201	            EditorGUILayout.BeginHorizontal();
202	
203	            using (new EditorGUI.DisabledScope(asset.StartId == id))
204	            {
205	                if (GUILayout.Button("Сделать стартом"))
206	                {
207	                    serializedObject.ApplyModifiedProperties();
208	                    _startId.stringValue = id;
209	                }
210	            }
211	
212	            if (GUILayout.Button("Дублировать"))
213	            {
214	                serializedObject.ApplyModifiedProperties();
215	                Undo.RecordObject(asset, "Дублировать узел");
216	                asset.DuplicateNode(index);
217	                EditorUtility.SetDirty(asset);
218	                serializedObject.Update();
219	                GUIUtility.ExitGUI();
220	            }
221	
222	            if (GUILayout.Button("Удалить"))
223	            {
224	                serializedObject.ApplyModifiedProperties();
225	                Undo.RecordObject(asset, "Удалить узел");
226	                asset.RemoveNode(index);
227	                EditorUtility.SetDirty(asset);
228	                serializedObject.Update();
229	                GUIUtility.ExitGUI();
230	            }
231	
232	            EditorGUILayout.EndHorizontal();
233	            EditorGUILayout.EndVertical();
234	            EditorGUILayout.Space(2f);
235	        }
236	
237	        private void DrawChoice(
238	            DialogueAsset asset, SerializedProperty choicesProp, int index)
239	        {
240	            var choiceProp = choicesProp.GetArrayElementAtIndex(index);
241	            var textProp = choiceProp.FindPropertyRelative("_text");
242	            var nextProp = choiceProp.FindPropertyRelative("_nextId");
243	
244	            EditorGUILayout.BeginVertical("helpbox");
245	            EditorGUILayout.BeginHorizontal();
246	            EditorGUILayout.LabelField($"{index + 1}.", GUILayout.Width(20f));
247	            EditorGUILayout.PropertyField(
248	                textProp, GUIContent.none, GUILayout.ExpandWidth(true));
249	            if (GUILayout.Button("×", GUILayout.Width(24f)))
250	            {
251	                serializedObject.ApplyModifiedProperties();
252	                Undo.RecordObject(asset, "Удалить вариант");
253	                choicesProp.DeleteArrayElementAtIndex(index);
254	                serializedObject.ApplyModifiedProperties();
255	                GUIUtility.ExitGUI();
256	            }
257	            EditorGUILayout.EndHorizontal();
258	
259	            DrawTarget(asset, nextProp, "Ответ ведёт в");
260	            EditorGUILayout.EndVertical();
261	        }
262	
263	        private void DrawTarget(
264	            DialogueAsset asset, SerializedProperty targetProp, string label)
265	        {
266	            var ids = new List<string> { string.Empty };
267	            var labels = new List<string> { "— Конец диалога —" };
268	            for (var i = 0; i < asset.Nodes.Count; i++)
269	            {
270	                var node = asset.Nodes[i];
271	                if (node == null)
272	                    continue;
273	
274	                ids.Add(node.Id);
275	                labels.Add($"{node.Id}  ·  {Preview(node.Line)}");
276	            }
277	
278	            var current = ids.IndexOf(targetProp.stringValue);
279	            if (current < 0)
280	                current = 0;
281	
282	            var next = EditorGUILayout.Popup(label, current, labels.ToArray());
283	            if (next != current)
284	                targetProp.stringValue = ids[next];
285	        }
286	
287	        private void AddNode(DialogueAsset asset, string undo)
288	        {
289	            serializedObject.ApplyModifiedProperties();
290	            Undo.RecordObject(asset, undo);
291	            asset.AddNode(string.Empty);
292	            EditorUtility.SetDirty(asset);
293	            serializedObject.Update();
294	            GUIUtility.ExitGUI();
295	        }
296	
297	        private static void AddChoice(DialogueAsset asset, string nodeId)
298	        {
299	            var node = FindAssetNode(asset, nodeId);
300	            if (node == null)
301	                return;
302	
303	            node.AddChoice("Новый ответ", string.Empty);
304	            EditorUtility.SetDirty(asset);
305	        }
306	
307	        private static DialogueNode FindAssetNode(DialogueAsset asset, string id)
308	        {
309	            for (var i = 0; i < asset.Nodes.Count; i++)
310	            {
311	                if (asset.Nodes[i] != null && asset.Nodes[i].Id == id)
312	                    return asset.Nodes[i];
313	            }
314	
315	            return null;
316	        }
317	
318	        private static void Validate(DialogueAsset asset)
319	        {
320	            var errors = new List<string>();
321	            var warnings = new List<string>();
322	            asset.CollectProblems(errors, warnings);
323	
324	            foreach (var error in errors)
325	                Debug.LogError($"Диалог «{asset.name}»: {error}", asset);
326	            foreach (var warning in warnings)
327	                Debug.LogWarning($"Диалог «{asset.name}»: {warning}", asset);
328	
329	            Debug.Log(
330	                $"Диалог «{asset.name}»: узлов {asset.Nodes.Count}, " +
331	                $"ошибок {errors.Count}, предупреждений {warnings.Count}.",
332	                asset);
333	        }
334	
335	        private static string Preview(string line)
336	        {
337	            if (string.IsNullOrWhiteSpace(line))
338	                return "(пусто)";
339	
340	            var trimmed = line.Trim();
341	            return trimmed.Length <= 42 ? trimmed : trimmed.Substring(0, 42) + "…";
342	        }
343	
344	        /// <summary>
345	        /// Проверка всех диалогов проекта. Меню только читает ассеты: ничего не
346	        /// пересохраняет и не создаёт (ADR 0005 не нарушается).
347	        /// </summary>
348	        [MenuItem("FrostSpace/Диалоги/Проверить все")]
349	        private static void ValidateAll()
350	        {
351	            var guids = AssetDatabase.FindAssets("t:DialogueAsset");
352	            if (guids.Length == 0)
353	            {
354	                Debug.Log("[Диалоги] Ассетов DialogueAsset не найдено.");
355	                return;
356	            }
357	
358	            var totalErrors = 0;
359	            var totalWarnings = 0;
360	
361	            for (var i = 0; i < guids.Length; i++)
362	            {
363	                var path = AssetDatabase.GUIDToAssetPath(guids[i]);
364	                var asset = AssetDatabase.LoadAssetAtPath<DialogueAsset>(path);
365	                if (asset == null)
366	                    continue;
367	
368	                var errors = new List<string>();
369	                var warnings = new List<string>();
370	                asset.CollectProblems(errors, warnings);
371	                totalErrors += errors.Count;
372	                totalWarnings += warnings.Count;
373	
374	                foreach (var error in errors)
375	                    Debug.LogError($"[Диалоги] {path}: {error}", asset);
376	                foreach (var warning in warnings)
377	                    Debug.LogWarning($"[Диалоги] {path}: {warning}", asset);
378	            }
379	
380	            Debug.Log(
381	                $"[Диалоги] Проверено {guids.Length}: ошибок {totalErrors}, " +
382	                $"предупреждений {totalWarnings}.");
383	        }
384	    }
385	}
