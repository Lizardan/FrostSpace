: 12%;\n      width: 26%;\n      height: 73%;\n      transform: translateX(-50%);\n      text-align: center;\n    }\n\n    #chassis-sketches .cs-d .cs-projection.left { left: 16%; }\n    #chassis-sketches .cs-d .cs-projection.right { left: 84%; }\n    #chassis-sketches .cs-d .cs-projection.center { left: 50%; width: 34%; }\n\n    #chassis-sketches .cs-d .cs-bot {\n      position: absolute;\n      left: 50%;\n      bottom: 16%;\n      width: 57%;\n      height: auto;\n      transform: translateX(-50%);\n      opacity: .42;\n      filter: none;\n    }\n\n    #chassis-sketches .cs-d .cs-projection.center .cs-bot {\n      width: 70%;\n      opacity: 1;\n      filter: drop-shadow(0 0 14px currentColor);\n    }\n\n    #chassis-sketches .cs-d .cs-ring {\n      left: 50%;\n      bottom: 12%;\n      width: 68%;\n      height: 14%;\n      transform: translateX(-50%);\n    }\n\n    #chassis-sketches .cs-d .cs-projection:not(.center) .cs-ring { opacity: .17; border-color: var(--dim); }\n\n    #chassis-sketches .cs-d .cs-proj-name {\n      position: absolute;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      color: var(--dim);\n      font-family: var(--font-code, monospace);\n      font-size: 8px;\n      letter-spacing: .09em;\n      line-height: 1.5;\n    }\n\n    #chassis-sketches .cs-d .cs-projection.center .cs-proj-name { color: var(--cyan-bright); }\n\n    #chassis-sketches .cs-footer {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      gap: 6px 18px;\n      margin-top: 13px;\n      padding-top: 11px;\n      border-top: 1px solid rgba(77, 230, 255, .10);\n      color: var(--dim);\n      font-size: 11px;\n      letter-spacing: .04em;\n    }\n\n    #chassis-sketches .cs-footer strong { color: var(--cyan); font-weight: 500; }\n\n    @media (max-width: 760px) {\n      #chassis-sketches .cs-grid { grid-template-columns: 1fr; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      #chassis-sketches .cs-scan { animation: no