259	        private void BuildInterface()
260	        {
261	            _root = new GameObject("PauseCanvas", typeof(RectTransform));
262	            _root.transform.SetParent(transform, false);
263	
264	            var canvas = _root.AddComponent<Canvas>();
265	            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
266	            // Выше HUD (10) и ниже занавеса перехода SceneController (1000).
267	            canvas.sortingOrder = 50;
268	
269	            var scaler = _root.AddComponent<CanvasScaler>();
270	            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
271	            scaler.referenceResolution = new Vector2(1920f, 1080f);
272	            scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
273	            scaler.matchWidthOrHeight = 0.5f;
274	
275	            // Без GraphicRaycaster луч указателя не попадает ни в один элемент:
276	            // кнопки остаются видимыми, но не нажимаются.
277	            _root.AddComponent<GraphicRaycaster>();
278	
279	            var shade = NewImage(_root.transform, "Shade", _shadeColor);
280	            Stretch(shade.rectTransform);
281	
282	            _menuPanel = BuildMenuPanel(_root.transform);
283	            _settingsPanel = BuildSettingsPanel(_root.transform);
284	            _settingsPanel.SetActive(false);
285	        }
