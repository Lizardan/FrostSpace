15	    public sealed class DialogueContentTests
16	    {
17	        private const string Folder = "Assets/_Project/Content/Data/Dialogues";
18	
19	        private static DialogueAsset[] LoadAll()
20	        {
21	            return AssetDatabase.FindAssets("t:DialogueAsset", new[] { Folder })
22	                .Select(AssetDatabase.GUIDToAssetPath)
23	                .OrderBy(path => path)
24	                .Select(AssetDatabase.LoadAssetAtPath<DialogueAsset>)
