**Input:**

```json
{
  "command": "UNITY_MCP_PORT=6401 python Tools/Unity/unity_bridge.py call manage_scene '{\"action\":\"load\",\"path\":\"Assets/Scenes/Frontier.unity\"}' >/dev/null 2>&1; cat > Temp/dump_frontier.cs <<'EOF'\nvar sb = new System.Text.StringBuilder();\nforeach (var go in UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects())\n{\n    if (go.name == \"DepotTrain\" || go.name == \"DepotPlatform\" || go.name == \"DepotGate\" || go.name == \"R16_Warden_A\" || go.name == \"R16_Warden_B\" || go.name == \"R7_Drifter\" || go.name == \"AwningRoof\")\n    {\n        sb.AppendLine(\"=== \" + go.name + \" pos=\" + go.transform.position.ToString(\"F2\") + \" rot=\" + go.transform.eulerAngles.ToString(\"F0\"));\n        var rs = go.GetComponentsInChildren<UnityEngine.Renderer>(true);\n        if (rs.Length > 0)\n        {\n            var b = rs[0].bounds;\n            foreach (var r in rs) b.Encapsulate(r.bounds);\n            sb.AppendLine(\"  bounds center=\" + b.center.ToString(\"F2\") + \" size=\" + b.size.ToString(\"F2\") + \" renderers=\" + rs.Length);\n        }\n        foreach (var t in go.GetComponentsInChildren<UnityEngine.Transform>(true))\n        {\n            sb.AppendLine(\"    \" + t.name + \" pos=\" + t.position.ToString(\"F2\") + \" rot=\" + t.eulerAngles.ToString(\"F0\") + \" scale=\" + t.lossyScale.ToString(\"F1\"));\n        }\n    }\n}\nreturn sb.ToString();\nEOF\nUNITY_MCP_PORT=6401 python Tools/Unity/unity_bridge.py call execute_code \"$(python -c 'import json; print(json.dumps({\"action\":\"execute\",\"code\":open(\"Temp/dump_frontier.cs\",encoding=\"utf-8\").read()}))')\" 2>&1 | tail -100",
  "description": "Dump Frontier train, platform, NPC hierarchy and bounds"
}
```

