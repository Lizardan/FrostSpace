**Response:**

1	using System;
2	using FrostSpace.Features.Carry;
3	using FrostSpace.Features.Dialogue;
4	using FrostSpace.Features.Progression;
5	using UnityEngine;
6	
7	namespace FrostSpace.Features.Quest
8	{
9	    /// <summary>
10	    /// Сценовый владелец прогресса: создаёт <see cref="QuestLog"/> и переводит в
11	    /// него явные события диалога и слотов. Глобальной шины нет; ссылки заданы
12	    /// в инспекторе (ADR 0027).
13	    /// </summary>
14	    [DisallowMultipleComponent]
15	    [DefaultExecutionOrder(-5)]
16	    public sealed class QuestDirector : MonoBehaviour
17	    {
18	        [SerializeField] private QuestAsset _quest;
19	        [SerializeField] private DialogueController _dialogue;
20	        [SerializeField] private CarrySlot[] _slots = Array.Empty<CarrySlot>();
21	
22	        [Tooltip("R13: после погрузки получает второй диалог")]
23	        [SerializeField] private DialogueSpeaker _speaker;
24	        [Tooltip("Диалог похвалы, который включается после четвёртого слота")]
25	        [SerializeField] private DialogueAsset _completedDialogue;
26	
27	        [Header("Награда")]
28	        [Tooltip("Опыт игрока; пусто — награда не начисляется")]
29	        [SerializeField] private PlayerExperience _experience;
30	        [SerializeField] private int _completionExperience = 250;
31	
32	        private QuestLog _log;
33	
34	        /// <summary>Прогресс сцены; <c>null</c>, если ассет не назначен.</summary>
35	        public QuestLog Log => _log;
36	
37	        public QuestAsset Quest => _quest;
38	
39	        /// <summary>Квест перешёл в <c>Completed</c>; событие приходит один раз.</summary>
40	        public event Action<QuestLog> QuestCompleted;
41	
42	        private void Awake()
43	        {
44	            _log = _quest != null ? _quest.CreateLog() : null;
45	
46	            if (_quest == null)
47	                Debug.LogError("QuestDirector: не назначен QuestAsset", this);
48	            if (_dialogue == null)
49	                Debug.LogError("QuestDirector: не назначен DialogueController", this);
50	        }
51	
52	        private void OnEnable()
53	        {
54	            if (_dialogue != null)
55	                _dialogue.ActionInvoked += OnDialogueAction;
56	
57	            if (_slots == null)
58	                return;
59	
60	            for (var i = 0; i < _slots.Length; i++)
61	            {
62	                if (_slots[i] != null)
63	                    _slots[i].Placed += OnPlaced;
64	            }
65	        }
66	
67	        private void OnDisable()
68	        {
69	            if (_dialogue != null)
70	                _dialogue.ActionInvoked -= OnDialogueAction;
71	
72	            if (_slots == null)
73	                return;
74	
75	            for (var i = 0; i < _slots.Length; i++)
76	            {
77	                if (_slots[i] != null)
78	                    _slots[i].Placed -= OnPlaced;
79	            }
80	        }
81	
82	        private void OnDialogueAction(DialogueAction action, string questId)
83	        {
84	            if (_log == null || action == DialogueAction.None)
85	                return;
86	            if (!string.IsNullOrWhiteSpace(questId) &&
87	                !string.Equals(questId, _quest.QuestId, StringComparison.Ordinal))
88	            {
89	                return;
90	            }
91	
92	            switch (action)
93	            {
94	                case DialogueAction.AcceptQuest:
95	                    if (!_log.Activate())
96	                        return;
97	                    CompleteTalkObjective();
98	                    break;
99	
100	                case DialogueAction.CompleteQuest:
101	                    CompleteTalkObjective();
102	                    break;
103	            }
104	        }
105	
106	        /// <summary>
107	        /// Разговор, в котором показан узел действия, и есть цель Talk: закрываем
108	        /// её сразу. Для Accept это цель «поговорить», для Complete — финальная.
109	        /// </summary>
110	        private void CompleteTalkObjective()
111	        {
112	            var objective = _log?.CurrentObjective;
113	            if (objective == null || objective.Kind != QuestObjectiveKind.Talk)
114	                return;
115	
116	            ApplyQuestEvent(new QuestEvent(QuestObjectiveKind.Talk, objective.TargetId));
117	        }
118	
119	        private void OnPlaced(CarrySlot slot, Carryable item)
120	        {
121	            if (_log == null || item == null)
122	                return;
123	
124	            var previousObjective = _log.ObjectiveIndex;
125	            ApplyQuestEvent(new QuestEvent(QuestObjectiveKind.Deliver, item.ItemType));
126	
127	            if (_log.ObjectiveIndex != previousObjective &&
128	                _log.CurrentObjective != null &&
129	                _log.CurrentObjective.Kind == QuestObjectiveKind.Talk &&
130	                _speaker != null &&
131	                _completedDialogue != null)
132	            {
133	                _speaker.SetDialogue(_completedDialogue);
134	            }
135	        }
136	
137	        /// <summary>
138	        /// Применяет событие и один раз начисляет награду в момент перехода
139	        /// квеста в <c>Completed</c>.
140	        /// </summary>
141	        private void ApplyQuestEvent(QuestEvent questEvent)
142	        {
143	            if (_log == null)
144	                return;
145	
146	            var wasCompleted = _log.IsCompleted;
147	            _log.Apply(questEvent);
148	            if (wasCompleted || !_log.IsCompleted)
149	                return;
150	
151	            _experience?.AddExperience(_completionExperience);
152	            QuestCompleted?.Invoke(_log);
153	        }
154	    }
155	}
