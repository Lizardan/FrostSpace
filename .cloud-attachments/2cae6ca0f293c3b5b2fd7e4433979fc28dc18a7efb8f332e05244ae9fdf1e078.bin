31	def bounds(obj) -> tuple[Vector, Vector]:
32	    lo = Vector((1e9, 1e9, 1e9))
33	    hi = Vector((-1e9, -1e9, -1e9))
34	    for corner in obj.bound_box:
35	        p = obj.matrix_world @ Vector(corner)
36	        lo = Vector((min(lo.x, p.x), min(lo.y, p.y), min(lo.z, p.z)))
37	        hi = Vector((max(hi.x, p.x), max(hi.y, p.y), max(hi.z, p.z)))
38	    return lo, hi
39	
40	
41	def check_range(name: str, value: float, lo: float, hi: float,
42	                problems: list[str]) -> None:
43	    if not (lo <= value <= hi):
44	        problems.append("%s=%.3f вне [%.3f, %.3f]" % (name, value, lo, hi))
45	
