  "command": "python - <<'PY'\nimport json, sys\nsys.path.insert(0, 'Tools/Unity')\nfrom unity_bridge import Bridge\ncode = r'''\nvar scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();\nT GetOrAdd<T>(GameObject go) where T : Component { var c = go.GetComponent<T>(); return c != null ? c : go.AddComponent<T>(); }\nvoid Configure(Component c, System.Action<SerializedObject> action) { var so = new SerializedObject(c); action(so); so.ApplyModifiedPropertiesWithoutUndo(); }\nvar player = GameObject.Find(\"Player\");\nif (player == null) return new { error = \"player missing\" };\nvar xp = GetOrAdd<FrostSpace.Features.Progression.PlayerExperience>(player);\nvar bar = GetOrAdd<FrostSpace.Features.Hud.ExperienceBar>(player);\nvar director = player.GetComponent<FrostSpace.Features.Quest.QuestDirector>();\nvar font = AssetDatabase.LoadAssetAtPath<TMPro.TMP_FontAsset>(\"Assets/_Project/Content/Fonts/LiberationSans Cyrillic SDF.asset\");\nConfigure(bar, so => {\n    so.FindProperty(\"_experience\").objectReferenceValue = xp;\n    so.FindProperty(\"_font\").objectReferenceValue = font;\n});\nif (director != null) Configure(director, so => so.FindProperty(\"_experience\").objectReferenceValue = xp);\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(scene);\nUnityEditor.SceneManagement.EditorSceneManager.SaveScene(scene);\nreturn new { playerExperience = xp != null, bar = bar != null, font = font != null, director = director != null, roots = scene.GetRootGameObjects().Length };\n'''\nwith Bridge(port=6401) as b:\n    print(json.dumps(b.call('execute_code', {'action': 'execute', 'code': code}), ensure_ascii=False, indent=2)[:3000])\nPY",
