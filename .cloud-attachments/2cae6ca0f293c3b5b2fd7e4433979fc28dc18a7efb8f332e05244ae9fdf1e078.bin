1	using FrostSpace.Features.Dialogue;
2	using NUnit.Framework;
3	using UnityEngine;
4	
5	namespace FrostSpace.Tests
6	{
7	    /// <summary>
8	    /// Проверяет переходы по графу без UI: старт, линейный ход, ветвление, циклы и
9	    /// поведение на битых ссылках. Сессия — обычный класс, сцена не нужна.
10	    /// </summary>
11	    public sealed class DialogueSessionTests
12	    {
13	        private DialogueAsset _asset;
14	
15	        [TearDown]
16	        public void TearDown()
17	        {
18	            if (_asset != null)
19	                Object.DestroyImmediate(_asset);
20	            _asset = null;
21	        }
22	
23	        private DialogueAsset NewAsset()
24	        {
25	            _asset = ScriptableObject.CreateInstance<DialogueAsset>();
26	            return _asset;
27	        }
28	
29	        [Test]
30	        public void NullAsset_IsFinished()
31	        {
32	            var session = new DialogueSession(null);
33	
34	            Assert.IsTrue(session.IsFinished);
35	            Assert.IsNull(session.Current);
36	            Assert.IsFalse(session.HasChoices);
37	            Assert.IsFalse(session.Advance());
38	            Assert.IsFalse(session.Choose(0));
39	        }
40	
41	        [Test]
42	        public void EmptyAsset_IsFinished()
43	        {
44	            var session = NewAsset().CreateSession();
45	
46	            Assert.IsTrue(session.IsFinished);
47	            Assert.IsNull(session.Current);
48	        }
49	
50	        [Test]
51	        public void LinearGraph_AdvancesToEnd()
52	        {
53	            var asset = NewAsset();
54	            var first = asset.AddNode("Первая реплика");
55	            var second = asset.AddNode("Вторая реплика");
56	            first.SetNextId(second.Id);
57	
58	            var session = asset.CreateSession();
59	
60	            Assert.AreSame(first, session.Current);
61	            Assert.IsFalse(session.HasChoices);
62	            Assert.IsTrue(session.Advance());
63	            Assert.AreSame(second, session.Current);
64	            Assert.IsFalse(session.Advance());
65	            Assert.IsTrue(session.IsFinished);
66	        }
67	
68	        [Test]
69	        public void StartNode_IsTheFirstAddedNode()
70	        {
71	            var asset = NewAsset();
72	            var first = asset.AddNode("Старт");
73	            asset.AddNode("Хвост");
74	
75	            Assert.AreEqual(first.Id, asset.StartId);
76	            Assert.AreSame(first, asset.StartNode);
77	        }
78	
79	        [Test]
80	        public void Choose_MovesToTheSelectedBranch()
81	        {
82	            var asset = NewAsset();
83	            var question = asset.AddNode("Кто ты?");
84	            var left = asset.AddNode("Левый ответ");
85	            var right = asset.AddNode("Правый ответ");
86	            question.AddChoice("Левый", left.Id);
87	            question.AddChoice("Правый", right.Id);
88	
89	            var session = asset.CreateSession();
90	
91	            Assert.IsTrue(session.HasChoices);
92	            Assert.IsTrue(session.Choose(1));
93	            Assert.AreSame(right, session.Current);
94	            Assert.IsFalse(session.Choose(0), "У терминального узла нет вариантов");
95	        }
96	
97	        [Test]
98	        public void Choose_OutOfRange_DoesNothing()
99	        {
100	            var asset = NewAsset();
101	            var question = asset.AddNode("Вопрос");
102	            question.AddChoice("Ответ", string.Empty);
103	
104	            var session = asset.CreateSession();
105	
106	            Assert.IsFalse(session.Choose(-1));
107	            Assert.IsFalse(session.Choose(1));
108	            Assert.AreSame(question, session.Current);
109	        }
110	
111	        [Test]
112	        public void Advance_OnChoiceNode_DoesNothing()
113	        {
114	            var asset = NewAsset();
115	            var question = asset.AddNode("Вопрос");
116	            question.SetNextId(question.Id);
117	            question.AddChoice("Ответ", string.Empty);
118	
119	            var session = asset.CreateSession();
120	
121	            Assert.IsFalse(session.Advance());
122	            Assert.AreSame(question, session.Current);
123	            Assert.IsTrue(session.HasChoices);
124	        }
