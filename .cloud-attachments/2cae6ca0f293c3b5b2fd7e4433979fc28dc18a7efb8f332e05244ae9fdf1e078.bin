using FrostSpace.Features.Quest;
using TMPro;
using UnityEngine;
using UnityEngine.UI;

namespace FrostSpace.Features.Hud
{
 [DisallowMultipleComponent]
 [DefaultExecutionOrder(260)]
 public sealed class QuestTracker : MonoBehaviour
 {
   [SerializeField] private QuestDirector _director;
   [SerializeField] private Color _accent = ...
   [SerializeField] private Color _text = ...
   [SerializeField] private Color _plate = ...
   private GameObject _canvasRoot;
   private TextMeshProUGUI _title;
   private TextMeshProUGUI _objective;
   private string _shownTitle;
   private string _shownObjective;

   private void Awake()
   {
      if (_director == null) _director = FindAnyObjectByType<QuestDirector>();
      Build();
   }
   private void LateUpdate()
   {
      var log = _director != null ? _director.Log : null;
      if (log == null || !log.IsActive)
      {
         SetVisible(false);
         return;
      }
      var objective = log.CurrentObjective;
      if (objective == null) { SetVisible(false); return; }
      SetVisible(true);
      var title = log.Quest != null ? log.Quest.Title : string.Empty;
      var text = objective.Text;
      var required = Mathf.Max(1, objective.Required);
      if (required > 1) text += $" {log.Progress}/{required}";
      if (title != _shownTitle) { _title.text = title; _shownTitle = title; }
      if (text != _shownObjective) { _objective.text = text; _shownObjective = text; }
   }
   ...
 }
}
```
