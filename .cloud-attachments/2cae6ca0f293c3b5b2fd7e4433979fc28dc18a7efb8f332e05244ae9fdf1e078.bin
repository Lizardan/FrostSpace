1	using System.Collections.Generic;
2	using FrostSpace.Features.Npc;
3	using FrostSpace.Features.Scan;
4	using UnityEngine;
5	
6	namespace FrostSpace.Features.Dialogue
7	{
8	    /// <summary>
9	    /// Маркер разговариваемого NPC на сценовом актёре (не на визуальном префабе —
10	    /// ADR 0004). Держит ассет диалога и останавливает патруль на время разговора.
11	    ///
12	    /// Имя и категория берутся у <see cref="ScanTarget"/>: подпись диалога и подпись
13	    /// сканера говорят об одном роботе одно и то же. Если маркера нет, имя чистится
14	    /// так же, как это делает сканер.
15	    /// </summary>
16	    [DisallowMultipleComponent]
17	    public sealed class DialogueSpeaker : MonoBehaviour
18	    {
19	        [Header("Ссылки")]
20	        [Tooltip("Патрульный NPC; пусто — ищется на этом объекте")]
21	        [SerializeField] private NpcController _npc;
22	        [Tooltip("Диалог робота")]
23	        [SerializeField] private DialogueAsset _dialogue;
24	
25	        [Header("Разговор")]
26	        [Tooltip("Скорость доворота корпуса к игроку, градусов/с")]
27	        [SerializeField] private float _turnSpeed = 360f;
28	
29	        private bool _usable;
30	        private Transform _conversationFocus;
31	
32	        /// <summary>Диалог робота.</summary>
33	        public DialogueAsset Dialogue => _dialogue;
34	
35	        /// <summary>Разговор уже идёт: второй раз не открываем.</summary>
36	        public bool IsTalking { get; private set; }
37	
38	        /// <summary>Имя в шапке панели.</summary>
39	        public string DisplayName { get; private set; } = "UNKNOWN";
40	
41	        /// <summary>Категория в шапке панели.</summary>
42	        public string Category { get; private set; } = "NPC";
43	
44	        /// <summary>
45	        /// С роботом можно поговорить: диалог назначен, граф без ошибок, разговор
46	        /// ещё не начат. Предупреждения (циклы, длинные реплики) не блокируют.
47	        /// </summary>
48	        public bool CanTalk => _usable && !IsTalking;
49	
50	        private void Awake()
51	        {
52	            if (_npc == null)
53	                _npc = GetComponent<NpcController>();
54	
55	            var target = ScanTarget.Find(transform);
56	            if (target == null)
57	                target = GetComponentInChildren<ScanTarget>(true);
58	
59	            if (target != null)
60	            {
61	                DisplayName = target.DisplayName;
62	                Category = target.Category;
63	            }
64	            else
65	            {
66	                DisplayName = ScanTarget.Sanitize(name);
67	                Category = "NPC";
68	            }
69	
70	            RefreshUsability();
71	        }
72	
73	        /// <summary>
74	        /// Меняет диалог на лету: после погрузки R13 получает реплику похвалы.
75	        /// Доступность пересчитывается теми же правилами, что и в Awake.
76	        /// </summary>
77	        public void SetDialogue(DialogueAsset dialogue)
78	        {
79	            if (_dialogue == dialogue)
80	                return;
81	
82	            _dialogue = dialogue;
83	            RefreshUsability();
84	        }
85	
86	        private void RefreshUsability()
87	        {
88	            _usable = false;
89	            if (_dialogue == null)
90	                return;
91	
92	            var errors = new List<string>();
93	            _dialogue.CollectProblems(errors, null);
94	            _usable = errors.Count == 0;
95	            if (!_usable)
96	            {
97	                Debug.LogError(
98	                    $"DialogueSpeaker: диалог «{_dialogue.name}» содержит ошибки — {errors[0]}",
99	                    this);
100	            }
101	        }
102	
103	        /// <summary>Останавливает NPC и фиксирует собеседника.</summary>
104	        public void BeginConversation(Transform player)
105	        {
106	            if (!CanTalk || player == null)
107	                return;
108	
109	            IsTalking = true;
110	            _conversationFocus = player;
111	
112	            if (_npc != null)
113	                _npc.EnterConversation(player);
114	        }
115	
116	        /// <summary>Возвращает NPC на маршрут.</summary>
117	        public void EndConversation()
118	        {
119	            if (!IsTalking)
120	                return;
121	
122	            IsTalking = false;
123	            _conversationFocus = null;
124	            _npc?.EndConversation();
125	        }
126	
127	        /// <summary>
128	        /// Общее правило разговора: говорящий поворачивается к игроку. NPC с
129	        /// <see cref="NpcController"/> делает это сам; актёрам без контроллера
130	        /// (например, R13) доворот даёт сам маркер диалога.
131	        /// </summary>
132	        private void LateUpdate()
133	        {
134	            if ((_npc != null && _npc.isActiveAndEnabled) ||
135	                !IsTalking ||
136	                _conversationFocus == null)
137	            {
138	                return;
139	            }
140	
141	            var offset = _conversationFocus.position - transform.position;
142	            offset.y = 0f;
143	            if (offset.sqrMagnitude < 0.0001f)
144	                return;
145	
146	            var target = Quaternion.LookRotation(offset.normalized, Vector3.up);
147	            transform.rotation = Quaternion.RotateTowards(
148	                transform.rotation, target, _turnSpeed * Time.deltaTime);
149	        }
150	    }
151	}
