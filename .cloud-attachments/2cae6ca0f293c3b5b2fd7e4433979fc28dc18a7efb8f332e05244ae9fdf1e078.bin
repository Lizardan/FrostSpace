131	            var second = asset.AddNode("Второй");
132	            first.AddChoice("Дальше", second.Id);
133	            second.AddChoice("Назад", first.Id);
134	
135	            var session = asset.CreateSession();
136	            Assert.IsTrue(session.Choose(0));
137	            Assert.AreSame(second, session.Current);
138	            Assert.IsTrue(session.Choose(0));
139	            Assert.AreSame(first, session.Current);
140	            Assert.IsFalse(session.IsFinished);
141	        }
142	
