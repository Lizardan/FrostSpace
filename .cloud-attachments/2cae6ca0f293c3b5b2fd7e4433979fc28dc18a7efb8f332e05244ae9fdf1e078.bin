1	using System.Collections;
2	using FrostSpace.Core;
3	using FrostSpace.Features.Dialogue;
4	using FrostSpace.Features.Locomotion;
5	using FrostSpace.Features.Quest;
6	using FrostSpace.Features.View;
7	using UnityEngine;
8	
9	namespace FrostSpace.Features.Story
10	{
11	    /// <summary>
12	    /// Финал вагона: после сдачи квеста камера уезжает к окну, параллакс
13	    /// замедляется, на белом появляется титул, затем грузится депо.
14	    /// </summary>
15	    [DisallowMultipleComponent]
16	    [DefaultExecutionOrder(-20)]
17	    public sealed class TrainSequenceDirector : MonoBehaviour
18	    {
19	        [Header("Ссылки")]
20	        [SerializeField] private QuestDirector _quest;
21	        [SerializeField] private DialogueController _dialogue;
22	        [SerializeField] private RobotLocomotion _locomotion;
23	        [SerializeField] private PlayerCameraRig _rig;
24	        [SerializeField] private TrainMotionRig _motion;
25	        [SerializeField] private TitleCardScreen _titleCard;
26	
27	        [Header("Финал")]
28	        [SerializeField] private string _nextScene = "Frontier";
29	        [Tooltip("Сколько камера едет к окну, с")]
30	        [SerializeField] private float _cameraSeconds = 2.4f;
31	        [Tooltip("Позиция камеры у правого окна")]
32	        [SerializeField] private Vector3 _windowPosition = new(3.2f, 2f, -4f);
33	        [Tooltip("Куда смотрит камера за окном")]
34	        [SerializeField] private Vector3 _windowLookAt = new(9f, 1.8f, -4f);
35	
36	        private bool _running;
37	
38	        private void OnEnable()
39	        {
40	            if (_quest != null)
41	                _quest.QuestCompleted += OnQuestCompleted;
42	        }
43	
44	        private void OnDisable()
45	        {
46	            if (_quest != null)
47	                _quest.QuestCompleted -= OnQuestCompleted;
48	        }
49	
50	        private void OnQuestCompleted(QuestLog log)
51	        {
52	            if (_running)
53	                return;
54	
55	            StartCoroutine(PlayFinale());
56	        }
57	
58	        private IEnumerator PlayFinale()
59	        {
60	            _running = true;
61	
62	            // Финальный узел диалога ещё открыт в момент CompleteQuest.
63	            while (_dialogue != null && _dialogue.IsOpen)
64	                yield return null;
65	
66	            _locomotion?.SetConversationLock(true);
67	            _motion?.Stop();
68	            _rig?.SetCinematic(true);
69	
70	            var camera = _rig != null ? _rig.ViewCamera : Camera.main;
71	            if (camera == null)
72	            {
73	                Debug.LogError("TrainSequenceDirector: нет камеры для финала", this);
74	                _running = false;
75	                yield break;
76	            }
77	
78	            var cameraTransform = camera.transform;
79	            var startPosition = cameraTransform.position;
80	            var startRotation = cameraTransform.rotation;
81	            var targetRotation = Quaternion.LookRotation(
82	                (_windowLookAt - _windowPosition).normalized, Vector3.up);
83	            var elapsed = 0f;
84	
85	            while (elapsed < _cameraSeconds)
86	            {
87	                elapsed += Time.deltaTime;
88	                var t = Mathf.SmoothStep(0f, 1f, Mathf.Clamp01(elapsed / _cameraSeconds));
89	                cameraTransform.position = Vector3.Lerp(startPosition, _windowPosition, t);
90	                cameraTransform.rotation = Quaternion.Slerp(startRotation, targetRotation, t);
91	                yield return null;
92	            }
93	
94	            if (_titleCard != null)
95	                _titleCard.Play();
96	            else
97	                Debug.LogWarning("TrainSequenceDirector: не назначен TitleCardScreen", this);
98	
99	            var controller = SceneController.Instance;
100	            if (controller == null)
101	            {
102	                Debug.LogError("TrainSequenceDirector: нет SceneController", this);
103	                _running = false;
104	                yield break;
105	            }
106	
107	            controller.LoadScene(_nextScene);
108	            _running = false;
109	        }
110	    }
111	}
